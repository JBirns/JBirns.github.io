\title{Macros}
\tag{macro}

\p{
Shared LaTeX-style macros. Any tree that contains the line \code{\startverb\import{macros}\stopverb}
can use them, inside or outside of math.
}

% --- Use inside math, e.g. #{\R^n} or #{f \colon \C \to \C} ---
\def\N{\mathbb{N}}
\def\Z{\mathbb{Z}}
\def\Q{\mathbb{Q}}
\def\R{\mathbb{R}}
\def\C{\mathbb{C}}
\def\id{\mathrm{id}}
\def\set[x]{\lbrace \x \rbrace}

% End-of-proof box, right-aligned. Also usable on its own: \qed
\def\qed{\<html:div>[style]{text-align: right;}{#{\blacksquare}}}

% A proof, shown as a foldable block labelled "Proof", ending with a box:  \proof{ \p{...} }
\def\proof[body]{
  \scope{
    \put\transclude/toc{false}
    \put\transclude/expanded{false}
    \subtree{
      \taxon{Proof}
      \body
      \qed
    }
  }
}
