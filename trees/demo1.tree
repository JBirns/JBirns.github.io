\title{}
\date{2026-11-22}
\author{JB00}
\import{macros}

\def\abs[body]{\lvert \body \rvert}
\def\norm[x]{||\x ||}

\p{
This page is a cheat sheet.
}

\subtree{
\title{Text}
\p{Paragraphs go in \code{\startverb\p{...}\stopverb}. Inside them you can write \em{emphasis},
\strong{bold}, \code{inline code}, and links: [to another page](JB00),
[to the web](https://www.forester-notes.org), or just [[demo1]] (shows the page title).}

\ul{
  \li{Bulleted lists use \code{\startverb\ul{ \li{...} }\stopverb}.}
  \li{Numbered lists use \code{\startverb\ol{ \li{...} }\stopverb}.}
}

\blockquote{Quotations use \code{\startverb\blockquote{...}\stopverb}.}
}

\subtree{
\title{Mathematics}
\p{
Inline maths goes in \code{\startverb#{...}\stopverb}: the function #{f(x) = e^{-x^2}} satisfies
#{\int_{\R} f(x)\,dx = \sqrt{\pi}}. Display maths goes in \code{\startverb##{...}\stopverb}:
}
##{
  \sum_{n=1}^{\infty} \frac{1}{n^2} = \frac{\pi^2}{6}
}
\p{Any LaTeX environment that works in display maths works here too:}
##{
\begin{aligned}
  (a+b)^2 &= a^2 + 2ab + b^2 \\
  \abs{\langle u, v \rangle} &\le \norm{u}\,\norm{v}
\end{aligned}
}
}

\subtree{
\title{Code blocks}
\pre{\startverb
def fib(n):
    return n if n < 2 else fib(n - 1) + fib(n - 2)
\stopverb}
}

\subtree{
\title{Diagrams drawn with LaTeX (optional)}
\p{
Commutative diagrams and TikZ pictures are compiled with a real LaTeX installation
into SVG images. To use them, install LaTeX on your computer (the website builder
installs it automatically when it sees one), then delete the percent signs at the
start of the lines below in the source file.
}
