\p{Note, if #{\mathrm{VC}(\mathcal{C}) = d} and #{m \leq d} then #{\Pi_{\mathcal{C}}(m) = 2^m}.}

\transclude{CLT1I}

\p{\strong{Last time.} Key question: can we get a lower bound on the minimum number of samples needed before PAC can kick in? I.e. what is the information theoretic complexity?}

\p{Intuitively if #{m \leq \mathrm{VC}(\mathcal{C})} then it is possible for a collection of #{m} points to give you any labels paired with them, so our samples do not have enough information-theoretic power to distinguish concepts.}

\transclude{CLT1J}

\transclude{CLT1K}

\p{This lemma now tells us that}

##{\mathbb{P}(E(h) < \varepsilon) \geq \mathbb{P}(\text{our samples form an } \varepsilon\text{-net}).}

\p{Thus, to prove we have sufficient examples for PAC to kick in, it suffices to show that a collection of samples forming an #{\varepsilon}-net is \em{likely}.}

\transclude{CLT1L}

\transclude{CLT1M}

\p{We now wish to show VC dimension is \em{necessary} for PAC.}

\transclude{CLT1N}
