\import{macros}

\tex{\usepackage{tikz}}{\begin{tikzpicture}[every node/.style={circle, draw, inner sep=1.5pt, minimum size=16pt}, ->, >=stealth]
\node (a1) at (0,0) {$x_1$};
\node (a2) at (1.6,0) {$x_2$};
\node (a3) at (0.8,1.1) {$\wedge$};
\draw (a1) -- (a3); \draw (a2) -- (a3);
\begin{scope}[xshift=3.6cm]
\node (b1) at (0,0) {$x_1$};
\node (b2) at (1.6,0) {$\neg$};
\node (b0) at (1.6,-1.1) {$x_2$};
\node (b3) at (0.8,1.1) {$\wedge$};
\draw (b0) -- (b2); \draw (b1) -- (b3); \draw (b2) -- (b3);
\end{scope}
\begin{scope}[xshift=7.2cm]
\node (c1) at (0,0) {$x_1$};
\node (c2) at (1.3,0.6) {$\neg$};
\node (c3) at (1.3,-0.6) {$\wedge$};
\draw (c1) -- (c2); \draw (c1) -- (c3); \draw (c2) -- (c3);
\end{scope}
\end{tikzpicture}}
