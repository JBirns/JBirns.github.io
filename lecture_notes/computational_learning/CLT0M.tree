\title{The rectangle game is PAC}
\taxon{Theorem}
\date{2026-01-15}
\author{JB00}
\import{macros}

\p{Assume your machine samples points from some distribution #{\mathcal{D}}. Then for all #{0 < \delta < \frac{1}{2}}, #{\varepsilon > 0}, if one samples #{\geq m = \frac{4}{\varepsilon}\log\frac{4}{\delta}} points then with probability #{\geq 1 - \delta} the sample rectangle produced will satisfy}

##{\mathbb{P}_{\mathcal{D}}\big(\mathcal{R} \cup \mathcal{R}' - (\mathcal{R} \cap \mathcal{R}')\big) < \varepsilon,}

\p{where #{\mathcal{R}} is the original rectangle and #{\mathcal{R}'} is the algorithm’s.}

\proof{
\p{Let’s begin by taking some number #{m} of samples and drawing our tightest fit #{\mathcal{R}'}. Also define #{T} to be the strip between the top of #{\mathcal{R}} and the top of #{\mathcal{R}'}, and #{T'} to be the strip of probabilistic weight #{\varepsilon /4} beginning at the top of #{\mathcal{R}} and heading downwards.}

\tex{\usepackage{tikz}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (-2.5,-1.6) -- (-2.5,2.2);
\draw[red, thick] (-2.2,-1.4) rectangle (2.4,1.8);
\node[red] at (2.7,-1.2) {$\mathcal{R}$};
\draw[blue, thick] (-1.5,-1) rectangle (1.6,0.9);
\node[blue] at (1.9,-1.1) {$\mathcal{R}'$};
\fill[red, opacity=0.15] (-2.2,1.45) rectangle (2.4,1.8);
\draw[red, dashed] (-2.2,1.45) -- (2.4,1.45);
\node[red] at (-2.75,1.62) {$T'$};
\draw[gray, dashed] (-2.2,0.9) -- (2.4,0.9);
\node[gray] at (2.75,1.35) {$T$};
\fill[blue] (-1.5,0.2) circle (1.3pt); \fill[blue] (-0.7,0.9) circle (1.3pt); \fill[blue] (0.4,-1) circle (1.3pt); \fill[blue] (1.6,0.1) circle (1.3pt); \fill[blue] (0.9,0.4) circle (1.3pt); \fill[blue] (-0.4,-0.3) circle (1.3pt);
\end{tikzpicture}}

\p{Note:}

\ul{
\li{\strong{1.} If #{T \subseteq T'}, then the weight of #{T} is #{\leq \varepsilon /4}.}
\li{\strong{2.} The only way that it is possible for #{T' \subseteq T} is if none of our samples landed inside #{T'}.}
}

\p{Thus,}

##{\begin{aligned}
\mathbb{P}(T \text{ has weight} \geq \varepsilon /4) &= \mathbb{P}(T' \subseteq T) \\
&= \mathbb{P}(\text{all samples missed } T') \\
&= \mathbb{P}(\text{a sample misses } T')^m \\
&= (1 - \varepsilon /4)^m.
\end{aligned}}

\p{Therefore}

##{\begin{aligned}
\mathbb{P}(E(\mathcal{R}') > \varepsilon) &\leq \mathbb{P}(\text{at least one strip has weight} \geq \varepsilon /4) \\
&\leq 4\,\mathbb{P}(T \text{ has weight} \geq \varepsilon /4) \\
&= 4(1 - \varepsilon /4)^m.
\end{aligned}}

\p{Select enough samples such that #{4(1 - \varepsilon /4)^m < \delta}. Then}

##{\mathbb{P}(E(\mathcal{R}') < \varepsilon) \geq 1 - \mathbb{P}(E(\mathcal{R}') > \varepsilon) > 1 - \delta.}
}
