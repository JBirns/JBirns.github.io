\title{Permuting rows to make columns distinct}
\taxon{Exercise}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{(a_{ij})_{i,j=1}^n} be an #{n \times n} matrix such that no row contains two equal numbers (i.e. #{a_{ij} \neq a_{ij'}} if #{j \neq j'}). Is it possible to permute the elements in each row such that in the new matrix no column contains two equal numbers?}
