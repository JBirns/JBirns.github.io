\title{Splitting measures on an interval}
\taxon{Exercise}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{\mu_1, \ldots, \mu_n} be non-atomic signed Borel measures on #{[0, 1]} with #{\mu_k([0, 1]) = 1} for every #{k}. Then there are #{a_0 = 0 \leq a_1 \leq \cdots \leq a_n \leq a_{n+1} = 1} such that, for some #{I \subset [n+1] = \lbrace 1, 2, \ldots, n+1\rbrace } and #{A = \bigcup_{i \in I} [a_{i-1}, a_i]}, we have #{\mu_k(A) = 1/2} for every #{k}.}

\proof{
\p{\em{Strong Hint.} For #{x = (x_j)_1^{n+1} \in S^n}, i.e. #{\sum_1^{n+1} x_j^2 = 1}, set #{y = y(x) = (y_i)_0^{n+1} \in \mathbb{R}^{n+2}}, where #{y_i = \sum_1^i x_j^2} for #{1 \leq i \leq n + 1}. In particular, #{y_0 = 0} and #{y_{n+1} = 1}. Define a function #{f \colon S^n \to \mathbb{R}^n} by setting #{f(x) = (\xi_k)_1^n}, where}

##{\xi_k = \sum_{i=1}^{n+1} (\operatorname{sign} x_i)\,\mu_k([y_{i-1}, y_i]).}
}
