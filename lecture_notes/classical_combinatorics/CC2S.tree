\title{Small witnesses for intersecting families of #{r}-sets}
\taxon{Exercise}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{r > 3}. Is there an integer #{m} such that if #{\mathcal{A} \subset \mathbb{N}^{(\leq r)}} is a finite intersecting family then there is a set #{M \in \mathbb{N}^{(m)}} such that #{A_i \cap A_j \cap M \neq \emptyset} for all #{A_i, A_j \in \mathcal{A}}?}
