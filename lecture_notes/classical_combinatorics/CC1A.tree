\title{Weak Kneser theorem}
\taxon{Theorem}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{A} and #{B} be additive subsets of an Abelian group #{G}. Then #{G} has a proper subgroup #{H}, #{1 \leq |H| < |G|}, such that}

##{|A + B| \geq |A| + |B| - |H|. 
 \qquad (2)}

\proof{
\p{Clearly, we may assume that #{0 \in A \cap B}. We shall apply induction on #{|B|}, starting with the trivial case #{|B| = 1}. Turning to the induction step, let #{|B| \geq 2}, and suppose that (2) holds for smaller sets #{B}. Our hope is to imitate the proof of \ref{CC18} above, replacing #{A} and #{B} by #{A \cup B} and #{A \cap B}, but this time we have to take a translation of #{B}. We distinguish two cases.}

\p{\em{First Case:} #{A + B - B = A}. Then #{A + B = A}, and (2) is essentially trivial. Indeed, let #{H} be the subgroup generated by #{B}, i.e. let #{H = \lbrace \sum_{i \in I} b_i - \sum_{j \in J} b_j : b_i, b_j \in B\rbrace }. Then #{H \supset B} and #{A + H = A}, so #{2 \leq |B| \leq |H| \leq |A|}. Thus #{H} is a proper subgroup of #{G} and #{|A + B| = |A| \geq |A| + |B| - |H|}.}

\p{\em{Second Case:} #{A + B - B \neq A}, i.e. there are elements #{a \in A} and #{b, c \in B} such that #{a + b - c \notin A}. Set #{d = a - c}, #{A' = A \cup (B + d)} and #{B' = A \cap (B + d)}. Then, #{c + d = a \in B'}, so #{B' \neq \emptyset}, and #{B + d \not\subset A}, since #{b + (a - c) \notin A}, so #{|B'| < |B|}.}

\p{Hence, by the induction hypothesis, #{G} has a proper subgroup #{H} such that #{|A' + B'| \geq |A'| + |B'| - |H|}. Finally, #{A' + B' \subset A + (B + d)}, so}

##{|A + B| = |A + (B + d)| \geq |A'| + |B'| - |H| = |A| + |B| - |H|.}
}
