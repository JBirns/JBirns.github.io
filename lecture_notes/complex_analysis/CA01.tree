\title{Complex Differentiation}
\date{2023-01-15}
\author{JB00}
\import{macros}

\p{\em{Goal:} study the theory of complex-valued differentiable functions in (one) complex variable.}

\ul{
\li{\strong{(i)} #{p(z) = a_dz^d + \cdots + a_1z + a_0}, polynomials with coefficients in #{\mathbb{R}}, #{\mathbb{Q}}, #{\mathbb{Z}}, #{\mathbb{C}}.}
\li{\strong{(ii)} Recall from IA Numbers & Sets computing the convergence of #{\sum_{n=1}^\infty \frac{1}{n^2}}, #{\sum_{n=1}^\infty \frac{1}{n^s}}, #{s > 1}. Consider these as complex functions in complex variables.}
\li{\strong{(iii)} These functions are related to harmonic functions #{u(x, y) \colon \mathbb{R}^2 \to \mathbb{R}}, #{u_{xx} + u_{yy} = 0}.}
}

\p{\strong{Notation}}

\p{#{z \in \mathbb{C}}, #{z = x + iy} (real and imaginary parts); #{\bar{z}} is the complex conjugate, #{\bar{z} = x - iy}; #{|z|}; #{\arg(z)} or #{\operatorname{Arg}(z)}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9, every node/.append style={fill=white, inner sep=1.5pt}]
\draw[->] (-1,0) -- (3,0);
\draw[->] (0,-0.6) -- (0,2.2);
\draw[->, thick] (0,0) -- (1.4,1.6) node[above right] {$z$};
\draw (0.7,0) arc (0:49:0.7);
\node at (0.85,0.35) {$\theta$};
\node at (-0.7,1.5) {$\mathbb{C}$};
\end{tikzpicture}}

\p{#{\theta = \arg(z)}; if #{\theta \in \lbrack 0, 2\pi\rparen } then we write #{\operatorname{Arg}(z)}.}

\p{\strong{Basic notions}}

