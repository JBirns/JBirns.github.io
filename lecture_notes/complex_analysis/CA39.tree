\p{\em{Non-examinable from here on.}}

\p{\strong{Application 1: Newton’s method and complex dynamics}}

\p{Recall Newton’s method, an iterative root-finding algorithm: it takes a polynomial #{p(z)} and an initial guess #{z_0} for a root of #{p(z)}, and computes a sequence #{z_1, \ldots, z_n := f^n(z_0), \ldots} where}

##{f(z) = z - \frac{p(z)}{p'(z)};}

\p{\em{sometimes}, this sequence limits to a root of #{p}.}

\p{\em{Example:} #{p(z) = z^3 - 1}, #{f(z) = \frac{2z^3 + 1}{3z^2}}.}

\p{In #{\mathbb{R}}: iterating #{f} from an initial guess #{z_0} we move along the graph of #{f(x) = y} via the line #{y = x} (#{z_0 \mapsto z_1 \mapsto z_2 \mapsto \cdots}), converging to the root #{z = 1}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9, every node/.append style={fill=white, inner sep=1.5pt}]
\draw[->] (-1.8,0) -- (3.8,0);
\draw[->] (0,-1.6) -- (0,3.2);
\draw[blue] (-1.4,-1.4) -- (3.0,3.0);
\node[text=blue, right] at (3.0,3.0) {$y = x$};
\draw[thick, domain=0.62:3.4, samples=60] plot (\x, {(2*(\x)^3 + 1)/(3*(\x)^2)});
\draw[thick, domain=-1.6:-0.62, samples=40] plot (\x, {(2*(\x)^3 + 1)/(3*(\x)^2)});
\node[right] at (3.4,{(2*3.4^3+1)/(3*3.4^2)}) {$y = f(x)$};
\draw[red] (2.6,0) -- (2.6,1.783) -- (1.783,1.783) -- (1.783,1.294) -- (1.294,1.294) -- (1.294,1.062);
\draw[red, densely dotted] (1.783,1.294) -- (1.783,0) (1.294,1.062) -- (1.294,0);
\node[text=red, below] at (2.6,0) {\small $z_0$};
\node[text=red, below] at (1.783,0) {\small $z_1$};
\node[text=red, below] at (1.294,0) {\small $z_2$};
\fill[red] (1,0) circle (1.5pt);
\node[text=red, below] at (0.8,0) {\small $1$};
\end{tikzpicture}}

\p{#{f^n(z)} is a sequence of meromorphic functions, so if #{f^n(z_0) \to} limit, then for some region #{U} of initial guesses, #{f^n|_U} has holomorphic limit.}

\transclude{CA3A}

