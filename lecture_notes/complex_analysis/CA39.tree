\p{\strong{Application 2: Riemann Mapping Theorem}}

\transclude{CA3D}

\p{\em{Sketch of proof.} Fix #{z_0 \in U}, and consider}

##{\mathcal{F} := \lbrace f \colon U \to \mathbb{D} : f \text{ holomorphic, injective, and } f(z_0) = 0\rbrace .}

\ul{
\li{\strong{(i)} #{\mathcal{F}} is non-empty.}
\li{\strong{(ii)} Show there exists #{g \in \mathcal{F}} such that #{|g'(z_0)|} is finite and maximal among elements of #{\mathcal{F}}.}
\li{\strong{(iii)} Prove #{g} is a conformal isomorphism.}
}