\import{macros}

\p{Let #{f \colon \mathbb{D}(a, R) \to \mathbb{C}} be holomorphic, so #{f(z) = \sum_{n \geq 0} c_n(z - a)^n} on #{\mathbb{D}(a, R)}. If #{f \not\equiv 0} then some #{c_n} is non-zero; let}

##{m := \min\lbrace n \in \mathbb{N} \cup \lbrace 0\rbrace  : c_n \neq 0\rbrace .}

