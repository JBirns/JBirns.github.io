\title{The symmetric group acting on rational functions}
\taxon{Example}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{k} be a field and #{L = k(X_1, \ldots, X_n)} be the field of rational functions in #{n} variables, i.e. the field of fractions of #{R = k[X_1, \ldots, X_n]}. Let #{G = S_n} act on #{L} by permuting the #{X_i}.}

\p{\em{Aim:} compute #{L^G}. We note that #{L^G} contains the elementary symmetric polynomials}

##{s_1 = \sum X_i, \quad s_2 = \sum_{i<j} X_i X_j, \quad \ldots, \quad s_n = \prod X_i.}

\p{The symmetric function theorem #{\implies R^G = k[s_1, \ldots, s_n]} and there are no polynomial relations satisfied by the #{s_i}.}
