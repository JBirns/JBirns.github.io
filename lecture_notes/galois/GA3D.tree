\title{Extensions of finite fields are cyclic Galois}
\taxon{Corollary}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{L/K} be any extension of finite fields with #{\#K = q}. Then #{L/K} is Galois, with #{\operatorname{Gal}(L/K)} cyclic, generated by the #{q}-power Frobenius #{x \mapsto x^q}.}

\proof{
\p{Let #{L = \mathbb{F}_{p^n}}. We have #{\mathbb{F}_p \subset K \subset L}. By \ref{GA3C}, #{L/\mathbb{F}_p} is Galois with #{G = \operatorname{Gal}(L/\mathbb{F}_p) = \langle \phi \rangle \cong C_n} where #{\phi \colon x \mapsto x^p}. The Fundamental Theorem of Galois Theory #{\implies L/K} is Galois and #{H = \operatorname{Gal}(L/K) \leq G}. Since #{G = \langle \phi \rangle \cong C_n} we have #{H = \langle \phi^m \rangle} for some #{m \mid n} by Lagrange’s Theorem. Then}

##{[K:\mathbb{F}_p] = \frac{[L:\mathbb{F}_p]}{[L:K]} = \frac{\#G}{\#H} = (G:H) = \frac{n}{n/m} = m.
 \qquad (*)}

\p{Therefore #{q = \#K = p^m} and #{\phi^m \colon x \mapsto x^q}.}
}
