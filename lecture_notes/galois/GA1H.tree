\title{Examples of splitting fields}
\taxon{Example}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{If #{K \subset \mathbb{C}}, then by the Fundamental Theorem of Algebra, the splitting field for #{f} over #{K} is the subfield #{K(\alpha_1, \ldots, \alpha_n) \subset \mathbb{C}} where #{\alpha_1, \ldots, \alpha_n} are the complex roots of #{f}.}

\ul{
\li{\p{\strong{(i)} Suppose}
##{f(X) = X^3 - 2 = (X - \sqrt[3]{2})(X - \omega\sqrt[3]{2})(X - \omega^2\sqrt[3]{2}) \in \mathbb{Q}[X]}
\p{where #{\omega = e^{2\pi i/3}}. Then #{\mathbb{Q}(\omega, \sqrt[3]{2})} is the splitting field for #{f} over #{\mathbb{Q}}.}
##{\begin{array}{ccccc} & & \mathbb{Q}(\omega, \sqrt[3]{2}) & & \\ & {\scriptstyle \leq 3}\diagup & & \diagdown {\scriptstyle \leq 2} & \\ \mathbb{Q}(\omega) & & & & \mathbb{Q}(\sqrt[3]{2}) \\ & {\scriptstyle 2}\diagdown & & \diagup {\scriptstyle 3} & \\ & & \mathbb{Q} & & \end{array}}
\p{(The upper degrees are at most #{3} since #{\sqrt[3]{2}} is a root of #{X^3 - 2}, and at most #{2} since #{\omega} is a root of #{X^2 + X + 1}.)
By the Tower Law, #{[\mathbb{Q}(\omega, \sqrt[3]{2}):\mathbb{Q}] \leq 6} and is divisible by both #{2} and #{3}. Since #{\gcd(2,3) = 1}, we get #{[\mathbb{Q}(\omega, \sqrt[3]{2}):\mathbb{Q}] = 6}.}}
\li{\p{\strong{(ii)} Let #{p} be an odd prime, and}
##{f(X) = \frac{X^p - 1}{X - 1} = X^{p-1} + \cdots + X + 1 = \prod_{r=1}^{p-1} (X - \zeta_p^r) \in \mathbb{Q}[X]}
\p{where #{\zeta_p = e^{2\pi i/p}}. #{f} has splitting field #{\mathbb{Q}(\zeta_p, \zeta_p^2, \ldots, \zeta_p^{p-1}) = \mathbb{Q}(\zeta_p)}. So in this case, the splitting field is obtained by adjoining just one root.}}
\li{\p{\strong{(iii)} Let #{f(X) = X^3 - 2 \in \mathbb{F}_7[X]}. Then #{f} is irreducible, since #{2} is not a cube mod #{7}. Let}
##{L = \frac{\mathbb{F}_7[X]}{(f)},}
\p{so #{L = \mathbb{F}_7(\alpha)} with #{\alpha^3 = 2}. N.B. #{2^3 \equiv 1 \pmod 7}. Then}
##{f(X) = (X - \alpha)(X - 2\alpha)(X - 4\alpha).}
\p{Therefore #{L = \mathbb{F}_7(\alpha)} is a splitting field for #{f} over #{\mathbb{F}_7}.}}
}
