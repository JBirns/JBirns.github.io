\title{Transitivity of trace and norm}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{M/L/K} be finite extensions and #{\alpha \in M}. Then}

##{\operatorname{Tr}_{M/K}(\alpha) = \operatorname{Tr}_{L/K}(\operatorname{Tr}_{M/L}(\alpha)), \qquad N_{M/K}(\alpha) = N_{L/K}(N_{M/L}(\alpha)).}

\proof{
\p{\em{Proof (sketch — non-examinable).} By \ref{GA32}, without loss of generality #{M = L(\alpha)}. Let #{f} be the minimal polynomial of #{\alpha} over #{L}, say}

##{f(X) = X^n + a_{n-1} X^{n-1} + \cdots + a_0, \quad a_i \in L.}

\p{#{L/K} has basis #{v_1, \ldots, v_m}, and #{M/L} has basis #{1, \alpha, \alpha^2, \ldots, \alpha^{n-1}}. If #{A_i} represents #{m_{a_i}} with respect to #{v_1, \ldots, v_m} and #{B} represents #{m_\alpha} with respect to #{(v_i \alpha^{j-1})_{1 \leq i \leq m,\, 1 \leq j \leq n}}, then}

##{B = \begin{pmatrix}
0 & & & & -A_0 \\
I & 0 & & & -A_1 \\
& I & \ddots & & \vdots \\
& & \ddots & 0 & \\
& & & I & -A_{n-1}
\end{pmatrix}, \qquad \begin{array}{l} A_i \text{ is } m \times m, \\ B \text{ is } mn \times mn. \end{array}}

\p{We compute}

##{\begin{aligned}
\operatorname{Tr}_{M/K}(\alpha) &\overset{(1)}{=} \operatorname{tr}(B) = -\operatorname{tr}(A_{n-1}) \overset{(1)}{=} \operatorname{Tr}_{L/K}(-a_{n-1}) \overset{(2)}{=} \operatorname{Tr}_{L/K}(\operatorname{Tr}_{M/L}(\alpha)), \\
N_{M/K}(\alpha) &\overset{(1)}{=} \det B \overset{(3)}{=} (-1)^{mn} \det(A_0) \overset{(1)}{=} N_{L/K}((-1)^n a_0) \overset{(2)}{=} N_{L/K}(N_{M/L}(\alpha)),
\end{aligned}}

\p{where (1) is the definition, (2) is \ref{GA33}, and (3) is an exercise.}
}
