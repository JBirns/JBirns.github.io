\title{New Galois extensions from old}
\taxon{Theorem}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{[M:K] < \infty} and let #{L_1, L_2} be intermediate fields, i.e. #{K \subset L_i \subset M}, #{i = 1, 2}.}

##{\begin{array}{ccccc} & & M & & \\ & & \big| & & \\ & & L_1 L_2 & & \\ & \diagup & & \diagdown & \\ L_1 & & & & L_2 \\ & {\color{red}\diagdown} & & {\color{blue}\diagup} & \\ & & K & & \end{array}}

\ul{
\li{\p{\strong{(i)} If #{L_1/K} is Galois, then #{L_1 L_2/L_2} is Galois and there is an injective group homomorphism}
##{\operatorname{Gal}(L_1 L_2/L_2) \hookrightarrow \operatorname{Gal}(L_1/K).}
\p{This is surjective #{\iff L_1 \cap L_2 = K}.}}
\li{\p{\strong{(ii)} If #{L_1/K} and #{L_2/K} are Galois then #{L_1 L_2/K} is Galois and there is an injective group homomorphism}
##{\operatorname{Gal}(L_1 L_2/K) \hookrightarrow \operatorname{Gal}(L_1/K) \times \operatorname{Gal}(L_2/K).}
\p{This is surjective #{\iff L_1 \cap L_2 = K}.}}
}

\proof{
\p{(i) #{L_1/K} Galois #{\implies L_1} is a splitting field for some separable polynomial #{f \in K[X]}. Then #{L_1 L_2} is a splitting field for #{f} over #{L_2}. Therefore #{L_1 L_2/L_2} is Galois.}

\p{If #{\sigma \in \operatorname{Gal}(L_1 L_2/L_2)} then #{\sigma|_K = \mathrm{id}}, and since #{L_1/K} is normal we have #{\sigma(L_1) \subset L_1} (#{\sigma} permutes roots of #{f}, all in #{L_1}). We consider the group homomorphism}

##{\begin{aligned}
\operatorname{Gal}(L_1 L_2/L_2) &\xrightarrow{\; \mathrm{res}\; } \operatorname{Gal}(L_1/K) \\
\sigma &\longmapsto \sigma|_{L_1}.
\end{aligned}}

\p{It is injective since if #{\sigma|_{L_1} = \mathrm{id}} then #{\sigma} acts trivially on both #{L_1} and #{L_2}, and hence on #{L_1 L_2}.}

\p{(#{\Leftarrow}) Now suppose #{L_1 \cap L_2 = K}. #{L_1/K} is finite and separable #{\implies} by the Theorem of the Primitive Element, #{L_1 = K(\alpha)} for some #{\alpha \in L_1}.}

\p{Let #{f \in K[X]} be the minimal polynomial of #{\alpha} over #{K}. Suppose #{f = gh} for some #{g, h \in L_2[X]}, #{\deg g, \deg h > 0}. #{f} splits into linear factors over #{L_1}, so #{g, h} have coefficients in #{L_1 \cap L_2 = K}. This is a contradiction since #{f} is irreducible over #{K}. Therefore #{f} is irreducible as a polynomial in #{L_2[X]}. Therefore}

##{[L_1:K] = \deg f = [L_1 L_2:L_2].}

\p{The map #{\mathrm{res}} is therefore an isomorphism.}

\p{(#{\Rightarrow}) Conversely,}

##{\operatorname{Im}(\mathrm{res}) \subset \operatorname{Gal}(L_1/L_1 \cap L_2) \subset \operatorname{Gal}(L_1/K).}

\p{So if #{\mathrm{res}} is surjective then #{L_1 \cap L_2 = K}, by the inclusion-reversing part of the Fundamental Theorem of Galois Theory.}

\p{(ii) Assume #{L_i/K} is Galois, #{i = 1, 2}. Then #{L_i} is a splitting field of some separable polynomial #{f_i \in K[X]}. Then #{L_1 L_2} is the splitting field of the separable polynomial #{\operatorname{lcm}(f_1, f_2)}. Therefore #{L_1 L_2/K} is Galois.}

\p{If #{\sigma \in \operatorname{Gal}(L_1 L_2/K)} then #{\sigma|_K = \mathrm{id}}, and since #{L_i/K} is normal, #{\sigma(L_i) \subset L_i}. Consider the group homomorphism}

##{\begin{aligned}
\operatorname{Gal}(L_1 L_2/K) &\to \operatorname{Gal}(L_1/K) \times \operatorname{Gal}(L_2/K) \\
\sigma &\mapsto (\sigma|_{L_1}, \sigma|_{L_2}).
\end{aligned}}

\p{It is injective since if #{\sigma|_{L_1} = \mathrm{id}} and #{\sigma|_{L_2} = \mathrm{id}} then #{\sigma} acts trivially on #{L_1 L_2}.}

##{\begin{aligned}
\text{Surjective} &\iff [L_1 L_2:K] = [L_1:K][L_2:K] \\
&\iff [L_1 L_2:L_2][L_2:K] = [L_1:K][L_2:K] \\
&\iff L_1 \cap L_2 = K \text{ by (i)}.
\end{aligned}}
}
