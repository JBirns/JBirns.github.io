\title{Galois groups over #{\mathbb{F}_p}}
\taxon{Lemma}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{f \in \mathbb{F}_p[X]} be a separable polynomial with irreducible factors of degrees #{n_1, \ldots, n_r} (#{n = \deg f = \sum n_i}). Then #{\operatorname{Gal}(f/\mathbb{F}_p) \leq S_n} is generated by a single element of cycle type #{(n_1, \ldots, n_r)}. In particular, #{\operatorname{Gal}(f/\mathbb{F}_p)} is cyclic of order #{\operatorname{lcm}(n_1, \ldots, n_r)}.}

\proof{
\p{Let #{L} be a splitting field of #{f} over #{\mathbb{F}_p}. Let #{\alpha_1, \ldots, \alpha_n} be the roots of #{f} in #{L}. \ref{GA3C} #{\implies G = \operatorname{Gal}(L/\mathbb{F}_p)} is cyclic and generated by the Frobenius #{\phi \colon x \mapsto x^p}.}

\p{Write #{f = \prod f_i} where #{f_i \in \mathbb{F}_p[X]} is irreducible of degree #{n_i}. Since #{G} permutes the roots of each #{f_i} transitively, the action of #{\phi} on the roots of #{f_i} is given by a single #{n_i}-cycle.}
}
