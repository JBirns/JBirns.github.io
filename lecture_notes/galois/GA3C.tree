\title{Galois group of #{\mathbb{F}_{p^n}/\mathbb{F}_p}}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{#{\mathbb{F}_{p^n}/\mathbb{F}_p} is Galois with #{\operatorname{Gal}(\mathbb{F}_{p^n}/\mathbb{F}_p)} cyclic of order #{n}, generated by the Frobenius #{\phi \colon x \mapsto x^p}.}

\proof{
\p{Let #{L = \mathbb{F}_{p^n}}. Let #{G \leq \operatorname{Aut}(L/\mathbb{F}_p)} be the subgroup generated by the Frobenius. Then}

##{\#L^G = \#L^\phi = \#\lbrace \alpha \in L : \alpha^p - \alpha = 0\rbrace  \leq p}

\p{by \ref{GA04}. But #{\mathbb{F}_p \subset L^G}. Therefore #{L^G = \mathbb{F}_p}. Then}

##{\mathbb{F}_p \subseteq L^{\operatorname{Aut}(L/\mathbb{F}_p)} \subseteq L^G = \mathbb{F}_p.}

\p{Equality in the first inclusion shows #{L/\mathbb{F}_p} is Galois; equality in the second shows #{\operatorname{Aut}(L/\mathbb{F}_p) = G}. Therefore #{\operatorname{Gal}(L/\mathbb{F}_p) = G = \langle \phi \rangle}, and it has order #{[L:\mathbb{F}_p] = n}.}
}
