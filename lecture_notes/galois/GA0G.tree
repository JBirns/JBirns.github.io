\title{Subrings and subfields generated by elements}
\taxon{Definition}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{L/K} be a field extension. Let #{\alpha_1, \ldots, \alpha_n \in L}. Then}

##{K[\alpha_1, \ldots, \alpha_n] = \lbrace  f(\alpha_1, \ldots, \alpha_n) : f \in K[X_1, \ldots, X_n] \rbrace ,}

\p{i.e. the smallest \em{subring} of #{L} to contain #{K} and #{\alpha_1, \ldots, \alpha_n}.}

##{K(\alpha_1, \ldots, \alpha_n) = \left\lbrace  \frac{f(\alpha_1, \ldots, \alpha_n)}{g(\alpha_1, \ldots, \alpha_n)} : f, g \in K[X_1, \ldots, X_n],\; g(\alpha_1, \ldots, \alpha_n) \neq 0 \right\rbrace .}

\p{This is the smallest \em{subfield} of #{L} to contain #{K} and #{\alpha_1, \ldots, \alpha_n}. It is also the field of fractions of #{K[\alpha_1, \ldots, \alpha_n]}.}
