\transclude{GA35}

\transclude{GA36}

\transclude{GA37}

\p{We generalise \ref{GA36} to #{L/K} separable.}

\p{Let #{\overline{K}} be the algebraic closure of #{K}. \ref{GA2C} #{\implies \#\operatorname{Hom}_K(L, \overline{K}) = [L:K]}.}

\transclude{GA38}
