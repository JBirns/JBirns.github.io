\title{Trace and Norm}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{L/K} be a finite extension, say #{[L:K] = n}. For #{\alpha \in L}, the map}

##{\begin{aligned}
m_\alpha \colon L &\to L \\
x &\mapsto \alpha x
\end{aligned}}

\p{is a #{K}-linear endomorphism of #{L}, hence has a trace and a determinant.}

\transclude{GA2Z}

