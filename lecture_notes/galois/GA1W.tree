\transclude{GA28}

\p{\strong{One aim for this lecture:} Show that if #{L/K} is a field extension and #{\alpha_1, \ldots, \alpha_n \in L} are separable, then #{K(\alpha_1, \ldots, \alpha_n)/K} is separable.}

\transclude{GA29}

\transclude{GA2A}

\transclude{GA2B}

\p{Note that \ref{GA2A} is the case #{n = 1}.}

\p{\strong{Obvious variant of \ref{GA2B}.} Let #{\sigma \colon K \hookrightarrow M} be an embedding. Then #{\#\lbrace \sigma\text{-homomorphisms } L \to M\rbrace  \leq [L:K]}, with equality #{\iff} each #{\sigma(f_i)} splits into distinct linear factors over #{M}.}

\p{We’ll use this variant in the induction argument.}

