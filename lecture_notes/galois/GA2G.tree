\title{Automorphism}
\taxon{Definition}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{An \em{automorphism} of a field #{L} is a bijective homomorphism #{\sigma \colon L \to L}. We write #{\operatorname{Aut}(L)} for the group of automorphisms of #{L} under composition, i.e. #{(\sigma\tau)(x) = \sigma(\tau(x))}.}
