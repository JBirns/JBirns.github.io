\title{Theorem of the Primitive Element}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{If an extension #{L/K} is finite and separable, then #{L = K(\theta)} for some #{\theta \in L}.}

\proof{
\p{Write #{L = K(\alpha_1, \ldots, \alpha_n)} for some #{\alpha_i \in L}. We must show that #{L = K(\theta)} for some #{\theta \in L}. It suffices to prove the case #{n = 2}, since the general case follows by induction on #{n}.}

\p{Write #{L = K(\alpha, \beta)}, #{f = } minimal polynomial of #{\alpha} over #{K}, #{g = } minimal polynomial of #{\beta} over #{K}. Let #{M} be a splitting field for #{fg} over #{L}. Write}

##{f(X) = \prod_{i=1}^r (X - \alpha_i), \quad \alpha_i \in M,\; \alpha = \alpha_1, \qquad g(X) = \prod_{i=1}^s (X - \beta_i), \quad \beta_i \in M,\; \beta = \beta_1.}

\p{#{L/K} separable #{\implies \beta} separable over #{K} #{\implies \beta_1, \ldots, \beta_s} distinct.}

\p{We pick some #{c \in K} and let #{\theta = \alpha + c\beta}. Let #{F(X) = f(\theta - cX) \in K(\theta)[X]}. Then #{F(\beta) = f(\theta - c\beta) = f(\alpha) = 0} and #{g(\beta) = 0}.}

\p{If #{\beta_2, \ldots, \beta_s} are not roots of #{F} then}

##{\begin{aligned}
\gcd(F, g) = X - \beta \text{ in } M[X] &\implies \gcd(F, g) = X - \beta \text{ in } K(\theta)[X] \quad (*) \\
&\implies \beta \in K(\theta) \\
&\implies \alpha \in K(\theta) \text{ since } \alpha = \theta - c\beta,
\end{aligned}}

\p{where (#{*}) is \ref{GA21}.
So #{K(\alpha, \beta) \subset K(\theta)}. But clearly #{K(\theta) \subset K(\alpha, \beta)}. Hence #{L = K(\alpha, \beta) = K(\theta)}.}

\p{We are done unless #{F(\beta_j) = 0} for some #{2 \leq j \leq s}, i.e. #{f(\theta - c\beta_j) = 0} for some #{2 \leq j \leq s}, i.e.}

##{\alpha + c\beta = \alpha_i + c\beta_j \quad \text{for some } 1 \leq i \leq r,\; 2 \leq j \leq s.}

\p{If #{|K| = \infty}, then since #{\beta \notin \lbrace \beta_2, \ldots, \beta_s\rbrace } we can pick #{c \in K} such that this never happens.}

\p{If #{|K| < \infty}, then #{|L| < \infty} and \ref{GA0C} #{\implies L^\times} is cyclic, generated by #{\theta} (say) #{\implies L = K(\theta)}.}
}
