\title{Existence of algebraic closures}
\taxon{Theorem}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{Let #{K} be a field.}

\ul{
\li{\strong{(i)} There is an algebraic extension #{L/K} such that every non-constant #{f \in K[X]} has a root in #{L}.}
\li{\strong{(ii)} #{K} has an algebraic closure #{\overline{K}}.}
}

\proof{
\p{(i) Let #{S = \lbrace \text{monic, nonconstant polynomials in } K[X]\rbrace }.}

\p{\em{Rough idea:} #{L = K(\alpha_f : f \in S)}, where #{\alpha_f} is a root of #{f}.}

\p{\em{In detail:} Let #{R = K[X_f : f \in S]} be the polynomial ring in indeterminates #{\lbrace X_f : f \in S\rbrace }. So elements of #{R} are finite #{K}-linear combinations of monomials of the form #{X_{f_1}^{d_1} X_{f_2}^{d_2} \cdots X_{f_r}^{d_r}} where #{f_i \in S} and #{d_i \in \mathbb{N}}. Let #{I \trianglelefteq R} be the ideal generated by #{\lbrace f(X_f) : f \in S\rbrace }.}

\p{\strong{Claim.} #{I \neq R}.}

\p{\em{Proof of claim.} If not then #{1 \in I}, i.e.}

##{1 = \sum_{f \in T} g_f\, f(X_f)
 \qquad (*)}

\p{for some finite #{T \subset S} and polynomials #{g_f \in R}.}

\p{Let #{L/K} be a splitting field for #{\prod_{f \in T} f}, and for each #{f \in T}, let #{\alpha_f \in L} be a root of #{f}. We define a ring homomorphism}

##{\begin{aligned}
\phi \colon R &\to L[X_f : f \in S \setminus T] \\
X_f &\mapsto \begin{cases} \alpha_f & f \in T \\ X_f & f \notin T \end{cases}
\end{aligned}}

\p{and #{\phi(c) = c} for all #{c \in K}. Applying #{\phi} to (#{*}):}

##{1 = \sum_{f \in T} \phi(g_f)\, f(\alpha_f) = 0,}

\p{a contradiction. This proves the claim. #{\square}}

\p{Since #{I \neq R}, \ref{GA4R} shows that #{R/I} has a maximal ideal #{\iff} #{R} has a maximal ideal #{J} containing #{I}.}

\p{Let #{L = R/J} and #{\alpha_f = \operatorname{Im}(X_f) = X_f + J \in L}. Then #{f(\alpha_f) = 0} (since #{f(X_f) \in I \subset J}). Since}

##{L = \bigcup_{T \subset S \text{ finite subsets}} K(\alpha_f : f \in T),}

\p{it follows that #{L/K} is an algebraic extension.}

\p{(ii) Repeating the construction in (i) gives #{K \subset K_1 \subset K_2 \subset \cdots}, so that each nonconstant polynomial in #{K_n[X]} has a root in #{K_{n+1}}.}

\p{If #{f \in K[X]} has degree #{n \geq 1} then it has a root #{\alpha_1 \in K_1}. Then #{f(X)/(X - \alpha_1)} has a root #{\alpha_2 \in K_2}, and so on, so that #{f} splits into linear factors in #{K_n}.}

\p{Let #{\overline{K} = \bigcup_{n \geq 1} K_n}. This is a field since it is a union of fields totally ordered by inclusion. Then every polynomial in #{K[X]} splits into linear factors over #{\overline{K}}, and each element of #{\overline{K}} belongs to some #{K_n}, so is algebraic over #{K}. Now apply \ref{GA1M}.}
}
