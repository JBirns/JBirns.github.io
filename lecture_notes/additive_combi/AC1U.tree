\transclude{AC23}

\p{It is easy to verify that #{\Vert f\Vert _{U^3(G)}^8 = \mathbb{E}_h\Vert \Delta_hf\Vert _{U^2(G)}^4}, where #{\Delta_hf(x) = f(x)\overline{f(x + h)}}.}

\transclude{AC24}

\transclude{AC25}

\p{Setting #{f_\varepsilon = f} for #{\varepsilon \in \lbrace 0, 1\rbrace ^2 \times \lbrace 0\rbrace } (a face of the cube) and #{f_\varepsilon \equiv 1} otherwise, the left-hand side is #{\Vert f\Vert _{U^2(G)}^4} \em{(as it is now just counting the quadruples)}, so #{\Vert f\Vert _{U^2(G)} \leq \Vert f\Vert _{U^3(G)}}.}

\transclude{AC26}

\p{One might hope to generalise Meshulam’s Theorem (\ref{AC0M}) as follows.}

\transclude{AC27}

\p{\strong{Idea.} By \ref{AC26} with #{f = f_A = \mathbf{1}_A - \alpha}, #{T_4(\mathbf{1}_A, \mathbf{1}_A, \mathbf{1}_A, \mathbf{1}_A) - \alpha^4 = T_4(f_A, f_A, f_A, f_A)} plus terms in which one to three of the inputs are equal to #{f_A}, each of which is controlled by #{\Vert f_A\Vert _{U^3}}. Hence #{|T_4(\mathbf{1}_A, \mathbf{1}_A, \mathbf{1}_A, \mathbf{1}_A) - \alpha^4| \leq 15\Vert f_A\Vert _{U^3}} \em{(the value #{15} is irrelevant; we just need a constant)}. So if #{A} contains no non-trivial 4-APs and #{p^n \geq 2\alpha^{-3}}, then #{\frac{\alpha^4}{2} \leq 15\Vert f_A\Vert _{U^3}} \em{(#{T_4} was shown above to be bounded)}.}

\p{What can we say about functions whose #{U^3}-norm is large?}

