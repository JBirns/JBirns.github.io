\p{We will deduce \ref{AC1V} on Example sheet 3.}

\p{We do \em{not} know of a comparable bound for 4-APs. Fourier-analytic techniques also fail for this problem.}

\transclude{AC1Z}

\transclude{AC20}

\p{Example sheet 1, Question 3(i) showed that #{\Vert f\Vert _{U^2(G)} = \Vert \hat{f}\Vert _{\ell^4(\hat{G})}}, so this is indeed a norm. Example sheet 1, Question 3(ii) asserted the following.}

\transclude{AC21}

\p{Note that}

##{\sup_{\gamma \in \hat{G}} |\hat{f}(\gamma)|^4 \leq \sum_{\gamma \in \hat{G}} |\hat{f}(\gamma)|^4 \leq \sup_{\gamma \in \hat{G}} |\hat{f}(\gamma)|^2\sum_{\gamma \in \hat{G}} |\hat{f}(\gamma)|^2,}

\p{and thus, by Parseval,}

##{\Vert \hat{f}\Vert _{\ell^\infty(\hat{G})} \leq \Vert \hat{f}\Vert _{\ell^4(\hat{G})} = \Vert f\Vert _{U^2(G)} \leq \Vert \hat{f}\Vert _{\ell^\infty(\hat{G})}^{1/2} \cdot \Vert f\Vert _{L^2(G)}^{1/2}.}

\p{Moreover, if #{f = f_A = \mathbf{1}_A - \alpha}, then}

##{T_3(f, f, f) = T_3(\mathbf{1}_A - \alpha, \mathbf{1}_A - \alpha, \mathbf{1}_A - \alpha) = T_3(\mathbf{1}_A, \mathbf{1}_A, \mathbf{1}_A) - \alpha^3,}

\p{since the remaining terms cancel: there are #{3} terms of the form #{(-\alpha)\mathbb{E}_{x,d}\mathbf{1}_A(x + d)\mathbf{1}_A(x + 2d) = -\alpha^3}, and #{3} terms of the form #{(-\alpha)^2\mathbb{E}_{x,d}\mathbf{1}_A(x + d) = +\alpha^3}.}

\p{We could therefore reformulate the first step in the proof of Meshulam’s Theorem as follows: if #{p^n \geq 2\alpha^{-2}}, then}

##{\frac{\alpha^3}{2} \leq |T_3(\mathbf{1}_A, \mathbf{1}_A, \mathbf{1}_A) - \alpha^3| \leq \Vert f_A\Vert _{U^2(G)}}

\p{by \ref{AC21}. It remains to show that if #{\Vert f_A\Vert _{U^2}} is not too small, then there exists a subspace #{V \leq \mathbb{F}_p^n} of bounded codimension on which #{A} has increased density.}

\transclude{AC22}

