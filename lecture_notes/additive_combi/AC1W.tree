\title{Low-degree monomials over #{\mathbb{F}_3}}
\taxon{Notation}
\date{2024-01-15}
\author{JB00}
\import{macros}

\p{Let #{M_n} be the set of monomials in #{x_1, x_2, \ldots, x_n} whose degree in each variable is at most #{2}. Let #{V_n} be the vector space over #{\mathbb{F}_3} generated by #{M_n}. For any #{d \in [0, 2n]}, write #{M_n^d} for the set of monomials of #{M_n} of (total) degree at most #{d}, and #{V_n^d} for the corresponding vector space. Set #{m_d = \dim(V_n^d) = |M_n^d|}.}
