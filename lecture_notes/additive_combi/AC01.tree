\p{The largest known subset of #{\mathbb{F}_3^n} containing no non-trivial 3-APs has size #{\geq (2.218)^n} (Tyrrell 2022); we will return to this later.}

\p{\strong{General finite abelian groups}}

\p{From now on, let #{G} be a finite abelian group. #{G} comes equipped with a set of \em{characters}, i.e. group homomorphisms #{\gamma \colon G \to \mathbb{C}^\times}, which themselves form a group, #{\hat{G}}, referred to as the \em{dual} of #{G}. It turns out that if #{G} is finite abelian, then #{\hat{G} \cong G}. For instance:}

\ul{
\li{if #{G = \mathbb{F}_p^n}, then #{\hat{G} = \lbrace \gamma_t \colon x \mapsto \omega^{x \cdot t},\; t \in G\rbrace } \em{(here #{x \cdot t} is the scalar product)};}
\li{if #{G = \mathbb{Z}_p = \mathbb{Z}/p\mathbb{Z}}, then #{\hat{G} = \lbrace \gamma_t \colon x \mapsto \omega^{xt},\; t \in G\rbrace } \em{(here #{xt} is the regular product)}.}
}

\transclude{AC0O}

\p{It is easy to verify that #{f(x) = \sum_{\gamma \in \hat{G}} \hat{f}(\gamma)\overline{\gamma(x)}}. You may also check that \ref{AC0A} and \ref{AC0D}, \ref{AC06}, the convolution example and \ref{AC09}, \ref{AC0C} and \ref{AC0F} go through in this more general context.}

