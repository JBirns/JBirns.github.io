\import{macros}

\p{Let #{G = \mathbb{F}_p^n}, where #{p} is a small fixed prime (#{p = 2, 3, 5}) and #{n} is large (#{n \to \infty}).}

\transclude{AC02}

\transclude{AC03}

\p{It is easy to verify the \em{inversion formula}:}

##{f(x) = \sum_{t \in \mathbb{F}_p^n} \hat{f}(t)\omega^{-x \cdot t} \quad \forall x \in \mathbb{F}_p^n.}

\p{Indeed,}

##{\sum_{t \in \mathbb{F}_p^n} \hat{f}(t)\omega^{-x \cdot t} = \sum_{t \in \mathbb{F}_p^n} \big( \mathbb{E}_yf(y)\omega^{y \cdot t} \big)\omega^{-x \cdot t} = \mathbb{E}_yf(y)\underbrace{\sum_t \omega^{(y - x) \cdot t}}_{= p^n\mathbf{1}_{\lbrace y = x\rbrace }} = f(x).}

\transclude{AC04}

\p{Note: given #{A \subseteq \mathbb{F}_p^n}, #{\widehat{\mathbf{1}_A}(0) = \mathbb{E}_{x \in \mathbb{F}_p^n}\mathbf{1}_A(x) = \alpha}.}

\p{Writing #{-A = \lbrace -a : a \in A\rbrace }, we have}

##{\begin{aligned}
\widehat{\mathbf{1}_{-A}}(t) &= \mathbb{E}_{x \in \mathbb{F}_p^n}\mathbf{1}_{-A}(x)\omega^{x \cdot t} = \mathbb{E}_{x \in \mathbb{F}_p^n}\mathbf{1}_A(-x)\omega^{x \cdot t} \\
&= \mathbb{E}_{y \in \mathbb{F}_p^n}\mathbf{1}_A(y)\omega^{-y \cdot t} = \overline{\mathbb{E}_{y \in \mathbb{F}_p^n}\mathbf{1}_A(y)\omega^{y \cdot t}} = \overline{\widehat{\mathbf{1}_A}(t)}.
\end{aligned}}

\transclude{AC05}

