\title{Freiman–Ruzsa}
\taxon{Theorem}
\date{2024-01-15}
\author{JB00}
\import{macros}

\p{Let #{A \subseteq \mathbb{F}_p^n} be such that #{|A + A| \leq K|A|} (i.e. #{\sigma(A) \leq K}) for some #{K > 0}. Then #{A} is contained in a coset of a subspace #{H \leq \mathbb{F}_p^n} of size #{|H| \leq K^2p^{K^4}|A|}.}

\proof{
\p{Choose #{X \subseteq 2A - A} maximal such that the translates #{x + A} for #{x \in X} are disjoint. #{X} cannot be too large: for all #{x \in X}, #{x + A \subseteq 3A - A}, and by Plünnecke, #{|3A - A| \leq K^4|A|}. But the translates #{x + A}, #{x \in X}, are disjoint and each has size #{|A|}, so}

##{|X||A| = \Big| \bigsqcup_{x \in X} (x + A) \Big| \leq |3A - A|,}

\p{hence #{|X| \leq K^4}.}

\p{We next show that}

##{2A - A \subseteq X + A - A.
 \qquad (*)}

\p{Indeed, if #{y \in 2A - A} and #{y \notin X}, then #{(y + A) \cap (x + A) \neq \emptyset} for some #{x \in X} by maximality of #{X}, so #{y \in X + A - A}; if #{y \in X} then #{y} is trivially in #{X + A - A}.}

\p{It follows by induction from (#{*}) that for all #{\ell \geq 2},}

##{\ell A - A \subseteq (\ell - 1)X + A - A.
 \qquad (**)}

\p{Indeed,}

##{\begin{aligned}
\ell A - A &= A + (\ell - 1)A - A \\
&\subseteq A + (\ell - 2)X + A - A \qquad \text{(by the induction hypothesis)} \\
&= (\ell - 2)X + 2A - A \\
&\subseteq (\ell - 2)X + X + (A - A) \qquad (\text{by } (*)) \\
&= (\ell - 1)X + A - A.
\end{aligned}}

\p{Now let #{H} be the subgroup of #{\mathbb{F}_p^n} generated by #{A}, which we can write as}

##{H = \bigcup_{\ell \geq 1} (\ell A - A) \subseteq Y + A - A \quad (\text{by } (**)),}

\p{where #{Y} is the subgroup of #{\mathbb{F}_p^n} generated by #{X}. Then #{|Y| \leq p^{|X|} \leq p^{K^4}}, so}

##{|H| \leq |Y + A - A| \leq |Y||A - A| \leq p^{K^4}K^2|A|}

\p{by Plünnecke.}
}
