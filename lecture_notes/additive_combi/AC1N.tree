\title{Dissociated}
\taxon{Definition}
\date{2024-01-15}
\author{JB00}
\import{macros}

\p{Let #{G} be a finite abelian group. We say #{S \subseteq G} is \em{dissociated} if}

##{\sum_{s \in S} \varepsilon_ss = 0 \text{ for some } \varepsilon \in \lbrace -1, 0, 1\rbrace ^{|S|} \implies \varepsilon \equiv 0.}
