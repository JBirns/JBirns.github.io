\title{L’Hôpital’s Rule}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{“Allows us to deal with indeterminate forms.”}

\transclude{DE0H}

\p{This can be generalised; e.g. if #{f'(x_0) = g'(x_0) = 0} also, #{\lim_{x \to x_0} \frac{f(x)}{g(x)} = \lim_{x \to x_0} \frac{f''(x)}{g''(x)}} provided the limit on the RHS exists.}

\transclude{DE0I}
