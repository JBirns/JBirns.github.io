\title{Impulses & Point Forces}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Consider a sudden force #{F(t)} applied to our system between #{T - \varepsilon} and #{T + \varepsilon}, e.g. strike an oscillating system (a tuning fork, say).}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (5,0) node[right] {$t$};
\draw[->] (0,0) -- (0,2.2) node[above] {$F(t)$};
\draw[thick] (0,0) -- (2,0) .. controls (2.3,0) and (2.4,1.8) .. (2.6,1.8) .. controls (2.8,1.8) and (2.9,0) .. (3.2,0) -- (4.6,0);
\draw (2,0.07) -- (2,-0.07) node[below] {\small $T - \varepsilon$};
\draw (2.6,0.07) -- (2.6,-0.07);
\node[below] at (2.6,-0.5) {\small $T$};
\draw (3.2,0.07) -- (3.2,-0.07) node[below] {\small $T + \varepsilon$};
\end{tikzpicture}}

\p{As #{\varepsilon \to 0}, only the \em{impulse}}

##{I = \int_{T-\varepsilon}^{T+\varepsilon} F(t)\,dt}

\p{matters for the subsequent motion #{\to} it is (mathematically) convenient to consider the limit of a sudden impulse.}

\p{Forced damped oscillator: #{m\ddot{y} + b\dot{y} + ky = F(t)}. Integrate both sides of the ODE from #{T - \varepsilon} to #{T + \varepsilon}:}

##{\lim_{\varepsilon \to 0}\Big( m[\dot{y}]_{T-\varepsilon}^{T+\varepsilon} + \underbrace{b[y]_{T-\varepsilon}^{T+\varepsilon}}_{0 \text{ if } y \text{ continuous}} + \underbrace{k\int_{T-\varepsilon}^{T+\varepsilon} y\,dt}_{0 \text{ if } y \text{ remains finite}} \Big) = \underbrace{I}_{\text{impulse}}.}

\p{It follows that #{\lim_{\varepsilon \to 0} m[\dot{y}]_{T-\varepsilon}^{T+\varepsilon} = I}, i.e. the velocity is discontinuous.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (7,0) node[right] {$t$};
\draw[->] (1,-1.3) -- (1,1.6) node[above] {$y(t)$};
\draw[thick] (0,0) -- (2,0);
\draw[thick, domain=2:6.6, samples=150] plot (\x , {1.2*exp(-0.6*(\x -2))*sin(deg(3.2*(\x -2)))});
\node[below] at (2,-0.05) {$T$};
\node[right, align=left] at (5,-0.9) {\small typical damped\\ \small oscillator behaviour};
\end{tikzpicture}}

\p{\strong{Dirac delta function}}

\p{Consider a family of functions #{D(t; \varepsilon)} with}

\ul{
\li{\strong{(i)} #{\lim_{\varepsilon \to 0} D(t; \varepsilon) = 0} for all #{t \neq 0};}
\li{\strong{(ii)} #{\int_{-\infty}^\infty D(t; \varepsilon)\,dt = 1}.}
}

\p{The impulsive force considered earlier is #{F(t) = I\,D(t - T; \varepsilon)}.}

\p{Example family: #{D(t; \varepsilon) = \frac{e^{-t^2/\varepsilon^2}}{\varepsilon\sqrt{\pi}}} (Q14, Sheet 1, for normalisation).}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (-3.5,0) -- (3.5,0) node[right] {$t$};
\draw[->] (0,0) -- (0,2.6) node[above] {$D(t; \varepsilon)$};
\draw[thick, domain=-3.3:3.3, samples=80] plot (\x , {2.2*exp(-(\x /0.6)^2)});
\draw[thick, domain=-3.3:3.3, samples=80] plot (\x , {1.0*exp(-(\x /1.3)^2)});
\node[right] at (0.6,1.9) {smaller $\varepsilon$};
\node[right] at (1.6,0.6) {larger $\varepsilon$};
\end{tikzpicture}}

\p{The family is not unique, but for any such family the limit #{\varepsilon \to 0} yields the \em{Dirac delta function}.}

\transclude{DE2Q}

\transclude{DE2R}

\p{This generalises to (#{b > a}):}

##{\int_a^b g(x)\delta(x - x_0)\,dx = \begin{cases} g(x_0) & \text{if } a < x_0 < b, \\ 0 & \text{otherwise.} \end{cases}}

\p{\strong{Delta-function forcing}}

\p{Consider #{y'' + p(x)y' + q(x)y = \delta(x)}, with #{p, q} continuous at #{x = 0}. For #{x > 0} or #{x < 0}, we have #{y'' + p(x)y' + q(x)y = 0}. However, there is a discontinuity in #{y'} at #{x = 0}: integrate the ODE from #{-\varepsilon} to #{+\varepsilon}:}

##{\lim_{\varepsilon \to 0}\Big( [y']_{-\varepsilon}^\varepsilon + \underbrace{p(0)[y]_{-\varepsilon}^\varepsilon}_{0 \text{ if } y \text{ continuous}} + \underbrace{\int_{-\varepsilon}^\varepsilon q(x)y\,dx}_{0 \text{ if } y \text{ is finite}} \Big) = 1 \implies \lim_{\varepsilon \to 0}[y']_{-\varepsilon}^\varepsilon = 1:}

\p{the “jump condition”.}

\p{Note: continuity of #{y} at #{x = 0} is required, to avoid #{y' \sim \delta(x)} around #{x = 0} and #{y''} being even worse behaved.}

\p{\strong{General rule:} the highest order derivative term in the ODE addresses the delta-function forcing.}

\transclude{DE2S}

\p{\strong{Heaviside step function #{H(x)}}}

\transclude{DE2T}

\p{It follows that}

##{H(x) = \begin{cases} 0 & \text{for } x < 0, \\ 1 & \text{for } x > 0, \\ \text{undefined} & \text{for } x = 0. \end{cases}}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (-2.5,0) -- (2.5,0) node[right] {$x$};
\draw[->] (0,-0.3) -- (0,1.5) node[above] {$H(x)$};
\draw[very thick] (-2.4,0) -- (0,0);
\draw[very thick] (0,1) -- (2.3,1);
\draw (0,1) circle (2pt);
\draw (0,0) circle (2pt);
\node[left] at (0,1) {$1$};
\end{tikzpicture}}

\p{The FTC gives #{\frac{dH}{dx} = \delta(x)}, although formally #{H'(x)} does not exist since #{H} is discontinuous: it makes sense inside integrals, not outside.}

\p{Note: the “smoothing” effect of integration and the “sharpening” effect of differentiation.}

\p{\strong{Forcing with #{H(x)}}}

\p{Consider #{y'' + p(x)y' + q(x)y = H(x)}, with #{p, q} continuous at #{x = 0}. We have}

##{y'' + p(x)y' + q(x)y = \begin{cases} 0 & \text{for } x < 0, \\ 1 & \text{for } x > 0. \end{cases}}

\p{It follows that}

##{\lim_{\varepsilon \to 0}[y'']_{-\varepsilon}^\varepsilon + p(0)\lim_{\varepsilon \to 0}[y']_{-\varepsilon}^\varepsilon + q(0)\lim_{\varepsilon \to 0}[y]_{-\varepsilon}^\varepsilon = 1. \qquad (\ast)}

\p{If #{y''(x) \sim H(x)} around #{x = 0}, #{y'} and #{y} are continuous (by integrating) and (#{\ast}) is satisfied:}

##{\lim_{\varepsilon \to 0}[y']_{-\varepsilon}^\varepsilon = 0 \quad \text{and} \quad \lim_{\varepsilon \to 0}[y]_{-\varepsilon}^\varepsilon = 0:}

\p{the “jump” conditions for Heaviside forcing.}
