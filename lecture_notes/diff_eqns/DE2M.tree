\title{Variation of parameters}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{#{y'' + 4y = \underbrace{\sin 2x}_{f(x)}}. C.F.s: #{y_1 = \sin 2x}, #{y_2 = \cos 2x}. The forcing term is resonant. #{W(x) = -2}, so}

##{\begin{aligned}
y_p(x) &= \cos 2x\int^x -\frac{1}{2}\underbrace{\sin 2t\sin 2t}_{\frac{1}{2}(1 - \cos 4t)}\,dt - \sin 2x\int^x -\frac{1}{2}\underbrace{\cos 2t\sin 2t}_{\frac{1}{2}\sin 4t}\,dt \\
&= -\frac{1}{4}\cos 2x\Big[ x - \frac{1}{4}\underbrace{\sin 4x}_{2\sin 2x\cos 2x} \Big] + \frac{1}{4}\sin 2x\Big[ -\frac{1}{4}\underbrace{\cos 4x}_{2\cos^2 2x - 1} \Big] \\
&= \underbrace{\frac{1}{16}\sin 2x}_{\text{CF} \to \text{can drop}} - \underbrace{\frac{1}{4}x\cos 2x}_{x \times \text{CF}}
\end{aligned}}

\p{[c.f. detuning]. So we can have #{y_p = -\frac{1}{4}x\cos 2x}.}
