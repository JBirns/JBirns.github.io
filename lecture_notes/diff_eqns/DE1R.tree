\title{Solution Curves & Isoclines}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Graphical methods for “solving” ODEs.}

\p{\strong{Solution curves}}

\p{Consider #{\frac{dy}{dt} = f(t, y)}. Each initial condition (e.g. #{y(0) = y_0}) generates a distinct solution curve (trajectory).}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (0,0) -- (3.4,0) node[right] {$t$};
\draw[->] (0,0) -- (0,3) node[above] {$y$};
\draw[thick] (0,0.3) .. controls (1.2,0.6) and (2,1.2) .. (2.6,2.4);
\draw[thick] (0,1.1) .. controls (0.8,1.4) and (1.4,2.0) .. (1.8,2.8);
\fill (0,0.3) circle (1.5pt);
\fill (0,1.1) circle (1.5pt);
\end{tikzpicture}}

\p{Can we sketch these solution curves without solving the ODE?}

\transclude{DE1S}

\p{The initial condition #{y(0) = y_0} gives #{A = \frac{1 + y_0}{1 - y_0}}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.7]
\draw[->] (-2,0) -- (4,0) node[right] {$y_0$};
\draw[->] (0,-3.2) -- (0,3.2) node[above] {$A$};
\begin{scope}
\clip (-2,-3.2) rectangle (4,3.2);
\draw[thick, domain=-2:0.52, samples=60] plot (\x , {(1+\x)/(1-\x)});
\draw[thick, domain=1.5:4, samples=60] plot (\x , {(1+\x)/(1-\x)});
\end{scope}
\draw[dashed] (1,-3.2) -- (1,3.2);
\draw[dashed] (-2,-1) -- (4,-1);
\fill (-1,0) circle (1.5pt);
\node[above left] at (-1,0) {\small $-1$};
\node[below right] at (1,0) {\small $1$};
\node[right] at (4,-1) {\small $A = -1$};
\end{tikzpicture}}

\p{Some behaviour follows directly from the ODE: #{\dot{y} = 0} for all #{t} if #{|y| = 1} #{\Rightarrow} two \em{constant} solutions: #{y = \pm 1}.}

\p{\strong{Slope fields & isoclines}}

\p{#{\frac{dy}{dt} = f(t, y)} #{\Rightarrow} the gradient of the solution curve that passes through any point #{(t, y)}.}

\p{\em{Slope field}: represents the gradient field by short “sticks”, one centred on each point.}

\transclude{DE1T}

\p{\em{Isoclines} (sometimes useful): curves along which #{\dot{y}} is constant. E.g. for #{\frac{dy}{dt} = t(1 - y^2)}, the isoclines are curves such that #{t(1 - y^2) = D} (constant), i.e. #{y^2 = 1 - \frac{D}{t}}, where #{D} parameterises different isoclines.}

\ul{
\li{The slope field is tangent to solution curves.}
\li{If #{f(t, y)} is single-valued, solution curves cannot cross.}
}
