\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (0,0) -- (5.2,0) node[right] {$x$};
\draw[->] (0,0) -- (0,3.2) node[above] {$f(x)$};
\draw[thick, domain=0.1:4.6, samples=50] plot (\x , {0.8 + 0.1*(\x)^2});
\fill (1.6,1.056) circle (1.5pt);
\fill (3.2,1.824) circle (1.5pt);
\draw[dashed] (0.2,0.288) -- (4.4,2.304);
\draw (1.6,0.07) -- (1.6,-0.07) node[below] {$x_0$};
\draw (3.2,0.07) -- (3.2,-0.07) node[below] {$x_0 + h$};
\node[right] at (4.5,2.4) {slope $= \frac{f(x_0 + h) - f(x_0)}{h}$};
\end{tikzpicture}}

\p{For the derivative to exist at some point #{x_0} we need the left- and right-hand limits to exist and be equal:}

##{\underbrace{\lim_{h \to 0^-} \frac{f(x_0 + h) - f(x_0)}{h}}_{\text{left-hand limit}} = \underbrace{\lim_{h \to 0^+} \frac{f(x_0 + h) - f(x_0)}{h}}_{\text{right-hand limit}}.}

\p{This is a strong restriction on the “smoothness” of #{f(x)}.}

\transclude{DE07}

\p{\strong{Notation.}}

##{\underbrace{\frac{df}{dx}}_{\text{Leibniz}} = \underbrace{f'(x)}_{\text{Lagrange}} = \underbrace{\dot{f}(x)}_{\text{Newton}}; \qquad n^{\text{th}} \text{ derivative: } f^{(n)}(x).}

\p{\strong{Big-O and little-o notation: order parameters}}

\p{These are useful concepts to give some comparative scales of functions sufficiently close to some limiting point.}

\transclude{DE08}

\p{\strong{Note:} #{f(x) = o(g(x)) \Rightarrow f(x) = O(g(x))}, but not the other way around.}

\transclude{DE09}

\p{Order parameters are useful to classify remainder terms before taking limits:}

##{\frac{df}{dx}\Big|_{x_0} = \frac{f(x_0 + h) - f(x_0)}{h} + \frac{o(h)}{h} \quad \text{as } h \to 0,}

\p{where the limit of the remainder term is #{0} by the definition of the derivative (we take limits of both sides to get the definition). It follows that}

##{f(x_0 + h) = f(x_0) + h\frac{df}{dx}\Big|_{x_0} + o(h).}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (0,0) -- (5.2,0) node[right] {$x$};
\draw[->] (0,0) -- (0,2.6) node[above] {$f(x)$};
\draw[thick, domain=0.1:4.6, samples=50] plot (\x , {0.8 + 0.1*(\x)^2});
\fill (1.6,1.056) circle (1.5pt);
\draw[dashed] (0.2,0.608) -- (4.4,1.952);
\fill (3.2,1.824) circle (1.5pt);
\fill (3.2,1.568) circle (1.5pt);
\draw[<->] (3.35,1.568) -- (3.35,1.824);
\node[right] at (3.4,1.45) {\small $o(h)$};
\draw (1.6,0.07) -- (1.6,-0.07) node[below] {$x_0$};
\draw (3.2,0.07) -- (3.2,-0.07) node[below] {$x_0 + h$};
\node[right] at (4.5,2.1) {$f(x_0) + (x - x_0)f'(x_0)$};
\end{tikzpicture}}

\p{\strong{Rules for differentiation}}

\p{\strong{Chain rule}}

\p{Derivative of a function of a function.}

\transclude{DE0A}

\transclude{DE0B}

\p{\strong{Product rule}}

\transclude{DE0C}

\p{The quotient rule is the special case #{v \to \frac{1}{v}}:}

##{\frac{d}{dx}\Big( \frac{u}{v} \Big) = \frac{1}{v}u' + u\frac{d}{dx}\Big( \frac{1}{v} \Big) = \frac{u'}{v} - \frac{v'u}{v^2}.}

\p{\strong{Clarification of #{o(x)}.}}

##{\begin{gathered}
f(x) = o(g(x)) \text{ as } x \to x_0 \implies -f(x) = o(g(x)) \\ \text{and }  af(x) = o(g(x)) \text{ as } x \to x_0, \quad a \in \mathbb{R}.
\end{gathered}}

\p{#{o(g(x))} never needs a multiple or change of sign.}

\p{\strong{Leibniz’s rule}}

\p{Generalise the product rule to higher derivatives. Consider #{f(x) = u(x)v(x)}; then}

##{\begin{aligned}
f'(x) &= u'v + uv', \\
f'' &= u''v + u'v' + u'v' + uv'' = u''v + 2u'v' + uv'', \\
f''' &= u'''v + u''v' + 2u''v' + 2u'v'' + u'v'' + uv''' = u'''v + 3u''v' + 3u'v'' + uv'''
\end{aligned}}

\p{(Pascal’s triangle structure).}

\transclude{DE0D}
