\title{Functions of Several Variables}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Multivariate functions depend on #{> 1} variable, e.g.}

\ul{
\li{height of terrain: #{h(\text{latitude}, \text{longitude})};}
\li{density of air: #{\rho(x, y, z, t)}.}
}

