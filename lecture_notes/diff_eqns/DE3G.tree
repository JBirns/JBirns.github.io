\p{For #{\lambda_1, \lambda_2 < 0}: \em{stable node}: the same diagram but with all arrows reversed.}

\p{\strong{Case 3:} #{\lambda_1} and #{\lambda_2} a complex conjugate pair, #{\lambda_1 = \lambda_2^*}, #{\mathbf{v}_1 = \mathbf{v}_2^*}:}

##{\mathbf{Y}(t) = c\mathbf{v}_1e^{\lambda_1t} + (c\mathbf{v}_1e^{\lambda_1t})^* = c\mathbf{v}_1e^{\operatorname{Re}(\lambda_1)t}e^{i\operatorname{Im}(\lambda_1)t} + {}^*}

\p{(complex constant #{c}). #{\operatorname{Re}(\lambda_1) < 0 \to} \em{stable spiral}; #{\operatorname{Re}(\lambda_1) > 0 \to} \em{unstable spiral}.}

