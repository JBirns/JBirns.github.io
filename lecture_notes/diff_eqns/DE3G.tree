\title{Systems of Linear Equations}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Consider two functions #{y_1(t)} and #{y_2(t)} with}

##{\begin{aligned}
\dot{y}_1 &= ay_1 + by_2 + f_1(t), \\
\dot{y}_2 &= cy_1 + dy_2 + f_2(t), \quad a, b, c, d \text{ const}.
\end{aligned}}

\p{Vector form:}

##{\dot{\mathbf{Y}} = \mathsf{M}\mathbf{Y} + \mathbf{F}, \quad \mathsf{M} = \begin{pmatrix} a & b \\ c & d \end{pmatrix}, \; \mathbf{Y} = \begin{pmatrix} y_1 \\ y_2 \end{pmatrix}, \; \mathbf{F} = \begin{pmatrix} f_1 \\ f_2 \end{pmatrix}.}

\p{Two ways to solve:}

\ul{
\li{\p{\strong{(i)} Convert to a higher-order ODE in 1 variable:}
##{\begin{aligned}
\ddot{y}_1 &= a\dot{y}_1 + b\dot{y}_2 + \dot{f}_1 = a\dot{y}_1 + b(cy_1 + dy_2 + f_2) + \dot{f}_1 \\
&= a\dot{y}_1 + bcy_1 + d(\dot{y}_1 - ay_1 - f_1) + bf_2 + \dot{f}_1 \\
\implies \ddot{y}_1 &- (a + d)\dot{y}_1 + (ad - bc)y_1 = bf_2 - df_1 + \dot{f}_1:
\end{aligned}}
\p{a linear second-order ODE with constant coefficients.}}
\li{\strong{(ii)} Solve the first-order ODEs directly with matrix methods.}
}

\p{\em{Aside:} it is sometimes convenient to deal with higher-order ODEs as systems of first-order ODEs, e.g. #{\ddot{y} + \alpha\dot{y} + \beta y = f}. Define #{y_1 \equiv y} and #{y_2 \equiv \dot{y}}. So #{\dot{y}_1 = y_2} and #{\dot{y}_2 = \ddot{y} = -\alpha y_2 - \beta y_1 + f}:}

##{\dot{\mathbf{Y}} = \begin{pmatrix} 0 & 1 \\ -\beta & -\alpha \end{pmatrix}\mathbf{Y} + \begin{pmatrix} 0 \\ f \end{pmatrix}, \quad \mathbf{Y} = \begin{pmatrix} y_1 \\ y_2 \end{pmatrix}.}

\p{\strong{Matrix methods}}

\p{To solve #{\dot{\mathbf{Y}} = \mathsf{M}\mathbf{Y} + \mathbf{F}(t)}:}

\ul{
\li{\strong{(i)} Write #{\mathbf{Y} = \mathbf{Y}_c + \mathbf{Y}_p}, with #{\dot{\mathbf{Y}}_c = \mathsf{M}\mathbf{Y}_c}.}
\li{\strong{(ii)} Look for #{\mathbf{Y}_c} in the form #{\mathbf{Y}_c = \mathbf{v}e^{\lambda t}}, #{\mathbf{v}} const. We have #{\dot{\mathbf{Y}}_c = \lambda\mathbf{Y}_c = \mathsf{M}\mathbf{Y}_c \Rightarrow \mathsf{M}\mathbf{v} = \lambda\mathbf{v}}: #{\mathbf{v}} must be an eigenvector of #{\mathsf{M}} and #{\lambda} the eigenvalue. For systems of #{n} equations with #{n} distinct eigenvalues #{\lambda}, there are #{n} such complementary solutions, which we can add to get the general #{\mathbf{Y}_c}.}
\li{\strong{(iii)} Find a #{\mathbf{Y}_p} that satisfies the full system of ODEs.}
}

\transclude{DE3H}

\p{\strong{Non-degenerate phase portraits}}

\p{#{n} first-order ODEs have a phase space with points #{\mathbf{Y} = (y_1, y_2, \ldots, y_n)^T}. \em{Phase portrait}: solution trajectories in phase space.}

\p{Consider #{\dot{\mathbf{Y}} = \mathsf{M}\mathbf{Y}} (homogeneous), with fixed point #{\mathbf{Y} = \mathbf{0}}. For #{n = 2} and #{\lambda_1 \neq \lambda_2} (non-degenerate), the general solution is}

##{\mathbf{Y}(t) = \mathbf{v}_1e^{\lambda_1t} + \mathbf{v}_2e^{\lambda_2t}.}

\p{Consider phase portraits for #{\lambda_1 \neq 0}, #{\lambda_2 \neq 0}.}

\p{\strong{Case 1:} #{\lambda_1} and #{\lambda_2} real and of opposite signs; WLOG #{\lambda_1 > 0}, #{\lambda_2 < 0}. #{\mathbf{v}_1} and #{\mathbf{v}_2} can be chosen to be real. \em{Saddle node}:}

