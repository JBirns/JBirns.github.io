\title{Predator–prey system}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{#{x(t)}: number of prey at time #{t}; #{y(t)}: number of predators at time #{t}. Dynamics of prey:}

##{\dot{x} = \underbrace{\alpha x}_{\substack{\text{excess births}\\\text{over natural deaths}}} - \underbrace{\beta x^2}_{\substack{\text{competition over}\\\text{some scarce resource}}} - \underbrace{\gamma xy}_{\substack{\text{prey being killed: predators}\\\text{consume all prey they encounter}}}}

\p{(the first two terms form the logistic equation). Dynamics of predators:}

##{\dot{y} = \underbrace{\varepsilon xy}_{\text{birth rate of predators}} - \underbrace{\delta y}_{\text{natural death rate}}.}

\p{#{\alpha, \beta, \gamma, \delta, \varepsilon} are positive constants and not coronavirus variants.}

\p{Specific case:}

##{\dot{x} = \underbrace{8x - 2x^2 - 2xy}_{f(x, y)}, \qquad \dot{y} = \underbrace{xy - y}_{g(x, y)}.}

\p{Equilibrium points: #{2x(4 - x - y) = 0} and #{y(x - 1) = 0}. The first requires #{x = 0} or #{x = 4 - y}; the second #{y = 0} or #{x = 1}; so #{y = 0} and #{x = 4}, or #{y = 3} and #{x = 1}. We have equilibrium points #{(0, 0)}, #{(1, 3)}, #{(4, 0)}.}

##{\mathsf{M} = \begin{pmatrix} f_x & f_y \\ g_x & g_y \end{pmatrix} = \begin{pmatrix} 8 - 4x - 2y & -2x \\ y & x - 1 \end{pmatrix}.}

\ul{
\li{#{(0, 0)}: #{\binom{\dot{\xi}}{\dot{\eta}} = \begin{pmatrix} 8 & 0 \\ 0 & -1 \end{pmatrix}\binom{\xi}{\eta}}; eigenvalues #{8, -1}, eigenvectors #{\binom{1}{0}, \binom{0}{1}}: saddle node.}
\li{#{(4, 0)}: #{\binom{\dot{\xi}}{\dot{\eta}} = \begin{pmatrix} -8 & -8 \\ 0 & 3 \end{pmatrix}\binom{\xi}{\eta}}; eigenvalues #{-8, 3}, eigenvectors #{\binom{1}{0}, \binom{8}{-11}}: saddle node.}
\li{#{(1, 3)}: #{\binom{\dot{\xi}}{\dot{\eta}} = \begin{pmatrix} -2 & -2 \\ 3 & 0 \end{pmatrix}\binom{\xi}{\eta}}; eigenvalues #{-1 \pm i\sqrt{5}} (real part #{< 0}): stable spiral. At #{\binom{1}{0}}, #{\binom{\dot{\xi}}{\dot{\eta}} = \begin{pmatrix} -2 & -2 \\ 3 & 0 \end{pmatrix}\binom{1}{0} = \binom{-2}{3}} #{\Rightarrow} #{\dot{\eta} > 0} #{\to} the spiral is anticlockwise.}
}

