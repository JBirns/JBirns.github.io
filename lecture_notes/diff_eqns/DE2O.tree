\title{Driven damped oscillator}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

##{\ddot{y} + \underbrace{\mu}_{b/m}\dot{y} + \omega_0^2y = \frac{F_0}{m}\sin\omega t. \qquad (\ast)}

\p{Assuming light damping (#{\mu < 2\omega_0}, since #{K = \frac{\mu}{2\omega_0}}), the C.F. is}

##{y_c(t) = e^{-\mu t/2}[A\sin\omega_{\text{free}}t + B\cos\omega_{\text{free}}t], \quad \text{where } \omega_{\text{free}} = \sqrt{\omega_0^2 - \frac{\mu^2}{4}}.}

\p{For the P.I. try #{y_p(t) = (C\sin\omega t + D\cos\omega t)\frac{F_0}{m}}. Substitute into (#{\ast}):}

##{\begin{aligned}
\sin\omega t &: -\omega^2C - \mu\omega D + \omega_0^2C = 1, \\
\cos\omega t &: -\omega^2D + \mu\omega C + \omega_0^2D = 0.
\end{aligned}}

\p{This gives}

##{y_p(t) = \frac{F_0/m}{(\omega_0^2 - \omega^2)^2 + (\mu\omega)^2}\big[ (\omega_0^2 - \omega^2)\sin\omega t - \mu\omega\cos\omega t \big].}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (7.5,0) node[right] {$t$};
\draw[->] (0,-1.8) -- (0,2) node[above] {$y(t)$};
\draw[gray, domain=0:7, samples=200] plot (\x , {1.2*exp(-0.5*\x)*cos(deg(3*\x))});
\draw[thick, domain=0:7, samples=250] plot (\x , {1.2*exp(-0.5*\x)*cos(deg(3*\x)) + 0.8*sin(deg(4.2*\x))});
\draw[dashed] (0,0.8) -- (7.2,0.8);
\draw[dashed] (0,-0.8) -- (7.2,-0.8);
\node[right] at (7.3,0.8) {\small amplitude of $y_p$};
\node[left] at (0,1.2) {\small $y_c$};
\node[left] at (0,-1.3) {\small $y_p + y_c$};
\end{tikzpicture}}

\p{Amplitude of #{y_p}:}

##{\frac{F_0}{m}\sqrt{C^2 + D^2} = \frac{F_0/m}{\sqrt{(\omega_0^2 - \omega^2)^2 + (\mu\omega)^2}}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (6,0) node[right] {$\omega$};
\draw[->] (0,0) -- (0,3) node[above] {amplitude};
\draw[thick, domain=0:5.6, samples=100] plot (\x , {0.9/sqrt((4-\x *\x)^2 + (0.9*\x)^2)*4});
\draw (1.9,0.07) -- (1.9,-0.07) node[below] {$\omega_{\text{res}} = \sqrt{\omega_0^2 - \mu^2/2}$};
\node at (4.2,1.0) {$\propto \frac{1}{\omega^2}$};
\end{tikzpicture}}
