\title{Series about a regular singular point}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

##{4xy'' + 2(1 - x^2)y' - xy = 0. \qquad (\ast)}

\p{#{x = 0} is an RSP. Try #{y(x) = \sum_{n=0}^\infty a_nx^{n+\sigma}} (#{a_0 \neq 0}). Multiply (#{\ast}) by #{x}: #{4(x^2y'') + 2(1 - x^2)(xy') - x^2y = 0}. We have}

##{\sum_{n=0}^\infty a_nx^{n+\sigma}\big[ 4(n + \sigma)(n + \sigma - 1) + 2(1 - x^2)(n + \sigma) - x^2 \big] = 0.}

\p{#{\sigma} is determined by the lowest power of #{x}:}

##{x^\sigma: [4\sigma(\sigma - 1) + 2\sigma]a_0 = 0 \implies a_0\sigma(2\sigma - 1) = 0 \implies \sigma = 0 \text{ or } \tfrac{1}{2}}

\p{(“indicial equation”, #{a_0 \neq 0}). Next lowest power of #{x}:}

##{x^{\sigma+1}: a_1[4(\sigma + 1)\sigma + 2(1 + \sigma)] = 0 \implies a_1(\sigma + 1)(2\sigma + 1) = 0;}

\p{for either #{\sigma = 0} or #{\sigma = \frac{1}{2}} we must have #{a_1 = 0}.}

##{x^{n+\sigma}\; (n \geq 2): a_n[4(n + \sigma)(n + \sigma - 1) + 2(n + \sigma)] - 2a_{n-2}(n + \sigma - 2) - a_{n-2} = 0}

##{\implies 2(n + \sigma)(2n + 2\sigma - 1)a_n = (2n + 2\sigma - 3)a_{n-2}. \qquad (\dagger)}

\p{Consider the roots separately.}

\p{#{\sigma = 0}: (#{\dagger}) gives #{2n(2n - 1)a_n = (2n - 3)a_{n-2} \Rightarrow a_n = \frac{2n - 3}{2n(2n - 1)}a_{n-2}}. So #{a_2 = \frac{1}{12}a_0}; #{a_4 = \frac{5}{56}a_2 = \frac{5 \times 1}{8 \times 7 \times 4 \times 3}a_0} (#{a_1 = 0} so #{a_3 = 0} etc.). Solution:}

##{y = a_0\Big( 1 + \frac{x^2}{4 \times 3} + \frac{5x^4}{8 \times 7 \times 4 \times 3} + \cdots \Big).}

\p{Note: this is a Taylor series.}

\p{#{\sigma = \frac{1}{2}}: (#{\dagger}) gives #{(2n + 1)2na_n = (2n - 2)a_{n-2}} (#{n \geq 2}), so #{a_n = \frac{n - 1}{n(2n + 1)}a_{n-2}}; #{a_1 = 0 \Rightarrow a_3 = 0 \Rightarrow a_5 = 0} etc.; #{a_2 = \frac{1}{2 \times 5}a_0}, #{a_4 = \frac{3 \times 1}{4 \times 9 \times 2 \times 5}a_0}, etc. Relabelling #{a_0 \to b_0},}

##{y = b_0x^{1/2}\Big( 1 + \frac{x^2}{2 \times 5} + \frac{3 \times 1 \times x^4}{4 \times 9 \times 2 \times 5} + \cdots \Big):}

\p{a Frobenius series.}

\p{We have determined 2 linearly independent solutions, but this is not generally the case.}
