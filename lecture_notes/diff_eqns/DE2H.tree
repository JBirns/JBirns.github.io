\title{Linear Equidimensional ODEs}
\date{2021-10-01}
\author{JB00}
\import{macros}

\transclude{DE2I}

\p{Why “equidimensional”? Let #{y(x)} be a CF of (#{\ast}). Consider #{\phi(x) \equiv y(\lambda x)}, with #{\lambda} an arbitrary scaling parameter. By the chain rule,}

##{x\frac{d\phi}{dx} = x\lambda y'(\lambda x), \qquad x^2\frac{d^2\phi}{dx^2} = x^2\lambda^2y''(\lambda x),}

##{\implies ax^2\frac{d^2\phi}{dx^2} + bx\frac{d\phi}{dx} + c\phi = (\text{LHS of } (\ast) \text{ at argument } \lambda x) = 0.}

\p{\strong{Solving by eigenfunctions}}

\p{#{y = x^k} is an eigenfunction of #{x\frac{d}{dx}}: #{x\frac{d}{dx}x^k = kx^k}. Look for CFs of (#{\ast}): #{y_c = x^k}:}

##{ak(k - 1) + bk + c = 0 \implies ak^2 + (b - a)k + c = 0;}

\p{solve for #{k_1, k_2}. If #{k_1 \neq k_2} (nondegenerate), the general CF is #{y_c = Ax^{k_1} + Bx^{k_2}}.}

\p{\strong{Solving by substitution}}

\p{Switch the independent variable from #{x} to #{z = \ln x}. For #{y(x) = y(e^z)},}

##{\frac{dy}{dz} = y'(e^z)e^z = xy'(x), \qquad \frac{d^2y}{dz^2} = \underbrace{e^zy'(e^z)}_{xy'(x)} + \underbrace{e^{2z}y''(e^z)}_{x^2y''(x)}.}

\p{It follows that (#{\ast}) becomes}

##{\underbrace{a\frac{d^2y}{dz^2} + (b - a)\frac{dy}{dz} + cy}_{\text{constant coefficients}} = f(e^z).}

\p{CF: #{y_c \propto e^{\lambda z}}, with #{a\lambda^2 + (b - a)\lambda + c = 0}: the same characteristic equation as for #{k_1} and #{k_2}. The general CF (#{k_1 \neq k_2}) is #{y_c = Ae^{k_1z} + Be^{k_2z} = Ax^{k_1} + Bx^{k_2}}.}

\p{Degenerate case #{k_1 = k_2 = k}:}

##{y_c = Ae^{kz} + Bze^{kz} = Ax^k + B\underbrace{(\ln x)x^k}_{\ln x \times 1^{\text{st}} \text{ CF}}.}
