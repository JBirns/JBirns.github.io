\title{Key property of #{\exp}}
\taxon{Proposition}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{#{\exp(x_1)\exp(x_2) = \exp(x_1 + x_2)}.}

\proof{
\p{Follows from (#{\ast}) (see printed notes). Or from the limit definition:}

##{\begin{aligned}
\exp(x_1)\exp(x_2) &= \lim_{k \to \infty}\Big( 1 + \frac{x_1}{k} \Big)^k\lim_{k \to \infty}\Big( 1 + \frac{x_2}{k} \Big)^k = \lim_{k \to \infty}\Big[ \Big( 1 + \frac{x_1}{k} \Big)\Big( 1 + \frac{x_2}{k} \Big) \Big]^k \\
&= \lim_{k \to \infty}\Big[ 1 + \frac{x_1 + x_2}{k} + \frac{x_1x_2}{k^2} \Big]^k \\
&= \lim_{k \to \infty}\Big[ 1 + \frac{k}{k}(x_1 + x_2) + \cdots \Big] = 1 + (x_1 + x_2) + \frac{1}{2!}(x_1 + x_2)^2 + \cdots \\
&= \exp(x_1 + x_2).
\end{aligned}}
}
