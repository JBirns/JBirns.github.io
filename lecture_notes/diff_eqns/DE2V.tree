\title{Fibonacci sequence}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{#{y_n = y_{n-1} + y_{n-2}}, #{y_0 = y_1 = 1} #{\to} #{1, 1, 2, 3, 5, 8, 13, 21, \ldots}. We have}

##{y_{n+2} - y_{n+1} - y_n = 0. \qquad (\ast)}

\p{Try #{y_n = k^n}: #{k^2 - k - 1 = 0} (characteristic equation), #{k = \frac{1 \pm \sqrt{5}}{2}}. “Golden ratio” #{\phi_1 = \frac{1 + \sqrt{5}}{2}}, and #{-\frac{1}{\phi_1} = \frac{1 - \sqrt{5}}{2} = \phi_2}.}

\p{The general solution of (#{\ast}) is #{y_n = A\phi_1^n + B\phi_2^n}, with #{A} and #{B} determined by the initial conditions:}

##{\begin{gathered}
y_0 = 1 \Rightarrow 1 = A + B, \qquad y_1 = 1 \Rightarrow 1 = A\phi_1 + B\phi_2 \\ \implies A = \frac{\phi_1}{\sqrt{5}}, \quad B = -\frac{\phi_2}{\sqrt{5}} = \frac{1}{\phi_1\sqrt{5}}.
\end{gathered}}

\p{It follows that}

##{y_n = \frac{\phi_1^{n+1}}{\sqrt{5}} - \frac{\phi_2^{n+1}}{\sqrt{5}} = \frac{\phi_1^{n+1} - \phi_2^{n+1}}{\sqrt{5}} = \frac{\phi_1^{n+1} - (-1/\phi_1)^{n+1}}{\sqrt{5}}.}

\p{This is a sequence of integers, and #{\phi_1} is irrational! Since #{\phi_1 > 1}, #{y_n \to \frac{\phi_1^{n+1}}{\sqrt{5}}} as #{n \to \infty}, and #{\lim_{n \to \infty}\big( \frac{y_{n+1}}{y_n} \big) = \phi_1}.}
