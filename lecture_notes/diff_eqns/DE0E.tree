\title{Taylor Series}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{\strong{Taylor’s Theorem}}

\p{Previously: #{f(x_0 + h) = f(x_0) + hf'(x_0) + o(h)} as #{h \to 0}. This extends to the following theorem.}

\transclude{DE0F}

\p{Note: #{E_n = O(h^{n+1})} is a stronger statement than #{o(h^n)}: e.g. #{h^{n + \frac{1}{2}} = o(h^n)} but #{\neq O(h^{n+1})} as #{h \to 0}.}

\p{\strong{Taylor Polynomials}}

\p{With #{x_0 + h = x}, Taylor’s theorem gives}

##{f(x) = \underbrace{f(x_0) + (x - x_0)f'(x_0) + \cdots + \frac{(x - x_0)^n}{n!}f^{(n)}(x_0)}_{n^{\text{th}} \text{ order Taylor polynomial of } f(x) \text{ about } x_0} + E_n.}

\ul{
\li{The #{n^{\text{th}}} order Taylor polynomial matches the first #{n} derivatives of #{f(x)} at #{x_0}.}
\li{It provides a local approximation to #{f(x)} in the vicinity of #{x_0}, with error #{E_n = O(h^{n+1})}.}
\li{If the Taylor polynomial converges (as a series) as #{n \to \infty} then this gives the \em{Taylor series} of #{f(x)} about #{x_0}.}
}

\p{\strong{Sketching a proof of Taylor’s Theorem (about #{x = 0})} (non-examinable). Start from the FTC (next lecture): #{\int_0^x f'(t)\,dt = f(x) - f(0)}, so, using #{\frac{d}{dt}(t - x) = 1},}

##{\begin{aligned}
f(x) &= f(0) + \int_0^x f'(t)\,dt = f(0) + \int_0^x \frac{d}{dt}(t - x)f'(t)\,dt \\
&= f(0) + [(t - x)f'(t)]_0^x - \int_0^x (t - x)f''(t)\,dt \\
&= f(0) + xf'(0) - \frac{1}{2}\int_0^x \frac{d}{dt}(t - x)^2f''(t)\,dt \\
&= f(0) + xf'(0) - \frac{1}{2}\big[ (t - x)^2f''(t) \big]_0^x + \frac{1}{2}\int_0^x (t - x)^2f^{(3)}(t)\,dt \\
&\;\;\vdots \\
&= f(0) + xf'(0) + \frac{x^2}{2!}f''(0) + \cdots + \frac{x^n}{n!}f^{(n)}(0) + \underbrace{\frac{1}{n!}\int_0^x (x - t)^nf^{(n+1)}(t)\,dt}_{E_n}.
\end{aligned}}

\p{The MVT can show #{E_n = \frac{1}{(n + 1)!}f^{(n+1)}(x_n)x^{n+1}}.}
