\title{Laplace-type integral dominated by an endpoint}
\taxon{Example}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{#{I(x) = \int_a^b f(t)e^{xt}\,dt} as #{x \to \infty}, where #{b > a}, #{f(b) \neq 0} and #{f} is nice. #{e^{bx} \gg e^{ax}} as #{x \to \infty}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (0,0) -- (4.5,0) node[right] {$t$};
\draw[->] (0,0) -- (0,2.4) node[above] {integrand};
\draw (0.6,0.08) -- (0.6,-0.08) node[below] {$a$};
\draw (3.4,0.08) -- (3.4,-0.08) node[below] {$b$};
\draw[domain=0.6:3.4, samples=40] plot (\x, {0.7 + 0.08*sin(400*\x)});
\draw[domain=0.6:3.4, samples=40] plot (\x, {1.0 + 0.1*sin(300*\x) + 0.08*\x});
\draw[domain=0.6:3.4, samples=40] plot (\x, {1.3 + 0.15*\x *\x /3});
\node[right] at (3.5,0.7) {\small $f$, when $x = 0$};
\node[right] at (3.5,1.3) {\small larger $x$};
\node[right] at (3.5,2.0) {\small larger $x$ still};
\end{tikzpicture}}

\p{So for bigger #{x} the integrand concentrates near #{t = b}, and}

##{I(x) \approx f(b)\int_a^b e^{xt}\,dt \sim f(b)\frac{e^{xb}}{x};}

\p{too rough! Let us IBP repeatedly:}

##{\begin{aligned}
I(x) &= \sum_{k=1}^N (-1)^{k-1}\big[ f^{(k-1)}(t)e^{xt}x^{-k} \big]_a^b + \frac{(-1)^N}{x^N}\int_a^b f^{(N)}(t)e^{xt}\,dt \\
&= e^{xb}\Big( \sum_{k=1}^N (-1)^{k-1}f^{(k-1)}(b)x^{-k} - e^{-x(b-a)}\sum_{k=1}^N (-1)^{k-1}f^{(k-1)}(a)x^{-k} \\
&\qquad\qquad + \frac{(-1)^N}{x^N}\int_a^b f^{(N)}(t)e^{x(t-b)}\,dt \Big) \\
&= e^{xb}(J_1 + J_2 + J_3).
\end{aligned}}

\p{#{J_1} could be an asymptotic approximation with #{\phi_k = \frac{1}{x^k}} as #{x \to \infty}. We need to show #{J_2 = o(x^{-N})}, #{J_3 = o(x^{-N})} as #{x \to \infty}:}

##{\frac{J_2}{x^{-N}} = -e^{-x(b-a)}\sum_{k=1}^N (-1)^{k-1}f^{(k-1)}(a)x^{N-k} \to 0 \text{ as } x \to \infty, \; \forall N,}

##{\begin{aligned}
\Big| \frac{J_3}{x^{-N}} \Big| &= \Big| \int_a^b f^{(N)}(t)e^{x(t-b)}\,dt \Big| \leq \int_a^b |f^{(N)}(t)|e^{x(t-b)}\,dt \\
&\leq \underbrace{\sup_{a \leq t \leq b}|f^{(N)}(t)|}_{K}\int_a^b e^{x(t-b)}\,dt \leq K \cdot \frac{1}{x}(1 - e^{-x(b-a)}) \to 0 \text{ as } x \to \infty, \; \forall N.
\end{aligned}}

\p{So}

##{\int_a^b f(t)e^{xt}\,dt \sim \sum_{k=1}^\infty (-1)^{k-1}\frac{f^{(k-1)}(b)}{x^k} \cdot e^{bx}.}
