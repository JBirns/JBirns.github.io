\title{Laplace integral}
\taxon{Definition}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{\em{Laplace integrals} are of the form}

##{I(x) = \int_a^b f(t)e^{x\phi(t)}\,dt, \quad b > a,}

\p{where #{f} and #{\phi} are “nice enough” functions; in particular #{\int_a^b |f|\,dt < K < \infty} for some #{K}.}
