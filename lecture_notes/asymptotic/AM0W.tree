\title{Steepest descent for #{\phi = z^2}}
\taxon{Example}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{#{I = \int_C f(z)e^{ixz^2}\,dz} as #{x \to \infty}, #{\phi = iz^2}. Deform #{C} from #{z_1} to #{z_2} into #{C_1} (a constant-#{v} curve from #{z_1} on which #{u} decreases), a bridge #{C_2}, and #{C_3} (a constant-#{v} curve into #{z_2}).}

