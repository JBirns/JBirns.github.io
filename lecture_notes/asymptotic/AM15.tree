\title{Hyperasymptotics for the Stieltjes integral}
\taxon{Example}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{When #{N + 1 = \lfloor 1/\varepsilon \rfloor}, the integrand in #{E_N} has a max at #{t \approx 1/\varepsilon}. Expand about there:}

##{\frac{1}{1 + \varepsilon t} = \frac{1}{2[1 + \frac{1}{2}(\varepsilon t - 1)]} = \frac{1}{2}\sum_k \Big( -\frac{1}{2} \Big)^k(\varepsilon t - 1)^k,}

\p{giving #{I(\varepsilon) = \sum_{n=0}^N a_n + \sum_{n=0}^M b_n}.}

