\title{Motivation}
\date{2023-10-01}
\author{JB00}
\import{macros}

\ul{
\li{Most real problems don’t have closed form solutions, or if they do, they are unworkably complicated or difficult to interpret.}
\li{Numerical approximations can be useful but might be computationally expensive or the results inscrutable.}
\li{Taylor series approximations can be limited in applicability or have desperately slow convergence.}
\li{Asymptotic approximations: the emphasis here is on being \em{useful} and \em{accurate}.}
}

\transclude{AM02}

\p{These are the 3 main applications:}

\ul{
\li{\strong{(i)} approximating tricky integrals;}
\li{\strong{(ii)} regular singular points in ODEs;}
\li{\strong{(iii)} the WKBJ method.}
}

\ul{
\li{Convergent methods give arbitrarily accurate approximations with more terms/iterations.}
\li{Asymptotic methods give arbitrarily accurate approximations as some variable approaches a limit.}
}
