78) (-0.276,1.218) (-0.267,1.249) (-0.257,1.270) (-0.247,1.282) (-0.237,1.282) (-0.227,1.270) (-0.218,1.247) (-0.208,1.213) (-0.198,1.169) (-0.188,1.117) (-0.178,1.058) (-0.169,0.994) (-0.159,0.928) (-0.149,0.861) (-0.139,0.796) (-0.129,0.735) (-0.120,0.680) (-0.110,0.633) (-0.100,0.595) (-0.090,0.568) (-0.080,0.551) (-0.071,0.547) (-0.061,0.553) (-0.051,0.570) (-0.041,0.597) (-0.031,0.632) (-0.022,0.675) (-0.012,0.721) (-0.002,0.771) (0.008,0.821) (0.018,0.869) (0.027,0.914) (0.037,0.952) (0.047,0.982) (0.057,1.004) (0.067,1.014) (0.076,1.014) (0.086,1.002) (0.096,0.979) (0.106,0.945) (0.116,0.902) (0.125,0.850) (0.135,0.791) (0.145,0.727) (0.155,0.661) (0.165,0.594) (0.174,0.529) (0.184,0.467) (0.194,0.412) (0.204,0.365) (0.214,0.327) (0.223,0.299) (0.233,0.282) (0.243,0.277) (0.253,0.284) (0.263,0.301) (0.272,0.328) (0.282,0.364) (0.292,0.407) (0.302,0.454) (0.312,0.505) (0.321,0.556) (0.331,0.605) (0.341,0.651) (0.351,0.691) (0.361,0.723) (0.370,0.746) (0.380,0.759) (0.390,0.761)};
\node[gray, above] at (-1.3,1.4) {$y_3$};
\draw (-5,-1.5) -- (-0.4,-1.5) node[midway, below] {zone 1};
\draw (0.4,-1.5) -- (3,-1.5) node[midway, below] {zone 2};
\draw[gray] (-1.5,-2.2) -- (1.2,-2.2) node[midway, below] {zone 3};
\node[below right] at (0.05,0) {$a$};
\end{tikzpicture}}
\p{#{y_1} is valid in zone 1, #{y_2} in zone 2:}
##{\begin{aligned}
y_1 &= A|q|^{-1/4}e^{\frac{i}{\varepsilon}\int \sqrt{|q|}\,dx} + B|q|^{-1/4}e^{-\frac{i}{\varepsilon}\int \sqrt{|q|}\,dx} \\ &= C|q|^{-1/4}\cos\Big[ \frac{1}{\varepsilon}\int_x^a \sqrt{|q|}\,dx' - \gamma \Big],
\end{aligned}}
\p{with #{\gamma, C} constants, and}
##{y_2 = Dq^{-1/4}\exp\Big( -\frac{1}{\varepsilon}\int_a^x \sqrt{q}\,dx' \Big).}
\p{\em{Solution near the turning point:} assume #{|x - a| \ll 1}. Then (#{\oplus}) can be approximated by #{\varepsilon^2y'' = \mu(x - a)y}, #{\mu = q'(a)}. Let #{z = (\mu /\varepsilon^2)^{1/3}(x - a)}. Then}
##{\frac{d^2y}{dz^2} = zy \quad \text{(Airy equation!)} \implies y_3 = E\operatorname{Ai}(z),}
\p{#{E} constant (throw away #{\operatorname{Bi}(z)} as it blows up at #{\infty}).}
\p{We need to match/glue #{y_1} to #{y_3} to #{y_2} to get a consistent global solution to our equation (#{\oplus}).}
\p{\em{Matching.}}
\ul{
\li{\p{Overlap of zones 1 & 3: #{\varepsilon \ll a - x \ll 1}; we may Taylor expand #{q} here in #{y_1}, i.e. #{q \approx \mu(x - a)}:}
##{y_1 \approx C[\mu(a - x)]^{-1/4}\cos\Big[ \frac{\sqrt{\mu}}{\varepsilon}\frac{2}{3}(a - x)^{3/2} - \gamma \Big].}
\p{For large negative #{z} (true when #{|z| \gg 1}), #{y_3 \sim E\frac{1}{\sqrt{\pi}}(-z)^{-1/4}\cos\big( \frac{2}{3}(-z)^{3/2} - \frac{1}{4}\pi \big)}, so}
##{y_3 \sim \frac{E}{\sqrt{\pi}[(\mu /\varepsilon^2)^{1/3}(a - x)]^{1/4}}\cos\Big( \frac{2}{3}\frac{\sqrt{\mu}}{\varepsilon}(a - x)^{3/2} - \frac{\pi}{4} \Big).}
\p{#{-z \gg 1 \Rightarrow a - x \gg \varepsilon^{2/3} \gg \varepsilon}. This approximation lies in the overlap region because #{\varepsilon^{2/3} \ll 1} as #{\varepsilon \to 0}. So matching requires #{\gamma = \frac{\pi}{4}}, #{E = \sqrt{\pi}(\mu\varepsilon)^{-1/6}C}.}}
\li{\p{Overlap of zones 2 & 3: #{\varepsilon \ll x - a \ll 1}:}
##{y_2 \approx D[\mu(x - a)]^{-1/4}\exp\Big[ -\frac{\sqrt{\mu}}{\varepsilon}\frac{2}{3}(x - a)^{3/2} \Big],}
##{y_3 \sim \frac{E}{2\sqrt{\pi}z^{1/4}}e^{-\frac{2}{3}z^{3/2}} \sim \frac{E}{2\sqrt{\pi}[(\mu /\varepsilon^2)^{1/3}(x - a)]^{1/4}}\exp\Big[ -\frac{2}{3}\frac{\sqrt{\mu}}{\varepsilon}(x - a)^{3/2} \Big]}
\p{for #{z \gg 1}, i.e. #{x - a \gg \varepsilon^{2/3}}. So #{E = 2\sqrt{\pi}(\mu\varepsilon)^{-1/6}D}.}}
}
\p{In summary, we have the \em{connection formulae}:}
##{y \sim \begin{cases} Dq^{-1/4}\exp\big[ -\frac{1}{\varepsilon}\int_a^x \sqrt{q}\,dx' \big], & x - a \gg \varepsilon, \\ 2\sqrt{\pi}(\mu\varepsilon)^{-1/6}D\operatorname{Ai}\big[ \varepsilon^{-2/3}\mu^{1/3}(x - a) \big], & |x - a| \ll 1, \\ 2D|q|^{-1/4}\cos\big[ \frac{1}{\varepsilon}\int_x^a \sqrt{|q|}\,dx' - \frac{\pi}{4} \big], & a - x \gg \varepsilon. \end{cases}}
\p{#{D} remains undetermined because we have not imposed a boundary condition at #{x \to -\infty}.}
\p{If #{q'(a) < 0}, transform #{x \mapsto -x}, apply the same process and then transform back.}}
\li{\p{\strong{(c)} \em{WKBJ method with two turning points.} Suppose #{a < b} with #{q(a) = q(b) = 0} and #{q'(a) < 0 < q'(b)}, and #{q} does not diverge in #{[a, b]}.}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (-3.2,0) -- (3.4,0);
\draw[->] (0,-1.3) -- (0,1.6) node[above] {$q$};
\draw[thick, domain=-2.8:2.8, samples=60] plot (\x, {0.3*\x *\x - 1});
\node[below left] at (-1.83,0) {$a$};
\node[below right] at (1.83,0) {$b$};
\node at (-3.4,0.5) {region A};
\node at (0.9,0.7) {region B};
\node at (3.4,0.5) {region C};
\end{tikzpicture}}
\p{What is #{y} in this situation when we insist that #{y \to 0} as #{x \to \pm\infty}?}
\ul{
\li{In region A: #{y_A \sim Aq^{-1/4}e^{-\frac{1}{\varepsilon}\int_x^a \sqrt{q}\,dx'}}, valid when #{a - x \gg \varepsilon}.}
\li{In region C: #{y_C = Cq^{-1/4}e^{-\frac{1}{\varepsilon}\int_b^x \sqrt{q}\,dx'}}, valid when #{x - b \gg \varepsilon}.}
\li{In region B: #{y_B \sim B|q|^{-1/4}\cos\big[ \frac{1}{\varepsilon}\int \sqrt{|q|}\,dx - \gamma \big]}, valid when #{x - a \gg \varepsilon} and #{b - x \gg \varepsilon}.}
}
\p{Matching #{y_A} to #{y_B} and #{y_B} to #{y_C} gives different expressions, and these have to agree. Match #{y_A} to #{y_B} (using the connection formulae):}
##{y_{AB} \sim 2A|q|^{-1/4}\cos\Big( \frac{1}{\varepsilon}\int_a^x \sqrt{|q|}\,dx' - \frac{\pi}{4} \Big) = 2A|q|^{-1/4}\cos(\theta(x)).}
\p{Match #{y_B} to #{y_C}:}
##{y_{BC} \sim 2C|q|^{-1/4}\cos\Big( \frac{1}{\varepsilon}\int_x^b \sqrt{|q|}\,dx' - \frac{\pi}{4} \Big) = 2C|q|^{-1/4}\cos(\phi - \theta),}
\p{where #{\phi = \frac{1}{\varepsilon}\int_a^b \sqrt{|q|}\,dx - \frac{\pi}{2}}, constant.}
\p{In region B, we require #{y_{AB} = y_{BC}}, so #{A = \pm C} and #{\cos\theta \mp \cos(\phi - \theta) = 0}. Both cases (#{\pm}) are covered by #{\cos^2(\phi - \theta) - \cos^2\theta = 0}, i.e. #{\sin(2\theta - \phi)\sin\phi = 0}. If #{\sin\phi = 0}, this holds for all #{x}. So #{\phi = n\pi}, #{n = 0, 1, 2, \ldots}:}
##{\boxed{\frac{1}{\varepsilon}\int_a^b \sqrt{|q|}\,dx = \Big( n + \frac{1}{2} \Big)\pi.}}
\p{This quantisation condition must be met if there exist bound solutions to (#{\oplus}) with the specified boundary conditions. If #{q = q(x, \lambda)}, the condition specifies what values #{\lambda} can take. #{A = (-1)^nC}: #{A = C} gives “even solutions”, #{A = -C} “odd solutions”.}}
\li{\p{\strong{(d)} \em{1D bound states in QM.}}
##{-\frac{\hbar^2}{2m}\frac{d^2\psi}{dx^2} + V(x)\psi = E\psi}
\p{is the time-independent Schrödinger equation.}
\ul{
\li{It describes the wave function #{\psi} of a particle of mass #{m} and energy #{E} in a 1D potential #{V(x)}.}
\li{We want bound states: #{\psi \to 0} as #{|x| \to \infty}.}
\li{We identify #{\varepsilon = \hbar} (very small) and #{q = 2m(V - E)}.}
}
\p{Consider #{V(x)} such that for given #{E > 0} there are 2 turning points #{a} and #{b}; these are determined by #{V(x) = E}, so #{a = a(E)}, #{b = b(E)}. A bound state requires, for some #{E},}
##{\Big[ \int_{a(E)}^{b(E)} \sqrt{2m(E - V(x))}\,dx = \Big( n + \frac{1}{2} \Big)\pi\hbar, \quad n = 0, 1, \ldots \Big]}
\p{For each #{n}, we solve #{E = E_n}: #{E = E_0, E_1, E_2, \ldots}, #{E_{n+1} > E_n} for all #{n}.}
\ul{
\li{#{[\,\cdot\,]} is the \em{Bohr–Sommerfeld quantisation condition}.}
\li{\p{In classical mechanics a bound particle oscillates strictly between #{a} and #{b}, with #{E = p^2/2m + V}, #{p} = momentum, so #{p^2 = 2m(E - V)}. The quantisation condition gives}
##{\oint p\,dx = (2n + 1)\pi\hbar,}
\p{integrating over 1 period of oscillation.}}
\li{Local wavenumber #{k = \sqrt{|q|}/\varepsilon = \sqrt{2m(E - V)}/\hbar = p/\hbar}; wavelength #{= \frac{2\pi}{k} = \frac{2\pi\hbar}{p}} = de Broglie wavelength.}
}}
\li{\p{\strong{(e)} \em{The QM harmonic oscillator.} #{V = \frac{m\omega^2}{2}x^2}, #{\omega} constant (Newton II #{\Rightarrow} #{\ddot{x} + \omega^2x = 0}). #{E = p^2/2m + V = p^2/2m + m\omega^2x^2/2}: for fixed energy, a particle follows an elliptical orbit in phase space #{(x, p)}.}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.7]
\draw[->] (-3,0) -- (3,0) node[right] {$x$};
\draw[->] (0,-1.8) -- (0,2) node[above] {$p$};
\draw (0,0) ellipse (1.2 and 0.7);
\draw (0,0) ellipse (1.8 and 1.05);
\draw (0,0) ellipse (2.4 and 1.4);
\end{tikzpicture}}
\p{Consider the area enclosed by an elliptical orbit:}
##{\iint_{\text{ellipse}} dx\,dp = \oint p\,dx = (2n + 1)\pi\hbar}
\p{by the quantisation condition. The semi-axes are #{\sqrt{2mE}} and #{\sqrt{2E/m\omega^2}}, so area #{= 2\pi E/\omega} by the area of an ellipse. So}
##{E_n = \Big( n + \frac{1}{2} \Big)\hbar\omega, \quad n = 0, 1, 2, \ldots}}
}
