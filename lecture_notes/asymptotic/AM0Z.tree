\li{\p{\strong{(b)} \em{WKBJ solution with one simple turning point.} Suppose (#{\oplus}) has 1 turning point at #{x = a} (i.e. #{q(a) = 0}, #{q'(a) \neq 0}; WLOG #{q'(a) > 0}). (#{\oplus}) can be written as #{y'' = \frac{q}{\varepsilon^2}y = Qy}, and #{Q} is very large as #{\varepsilon \to 0}. This motivates a solution like #{y = e^{S(x)/\varepsilon}}. Put into (#{\oplus}):}
##{\varepsilon S'' + (S')^2 = q. \qquad (\dagger)}
\p{We assume #{S = \sum_{n=0}^\infty \varepsilon^nS_n}, so}
##{(\cdots) + \varepsilon(\cdots) + \varepsilon^2(\cdots) + \cdots = 0,}
\p{with each bracket #{= 0}.}
\ul{
\li{At order #{\varepsilon^0}: #{(S_0')^2 = q}, so #{S_0 = \pm\int \sqrt{q}\,dx}.}
\li{At order #{\varepsilon^1}: #{S_0'' + 2S_0'S_1' = 0 \Rightarrow S_1' = -\frac{1}{2}(\log S_0')' \Rightarrow S_1 = -\frac{1}{4}\log q}.}
}
\p{Therefore}
##{y = Aq^{-1/4}e^{\frac{1}{\varepsilon}\int \sqrt{q}\,dx} + Bq^{-1/4}e^{-\frac{1}{\varepsilon}\int \sqrt{q}\,dx}.}
\p{This solution is only good far from turning points.}
\ul{
\li{When #{q > 0}, #{y} is exponentially decaying/growing.}
\li{When #{q < 0}, #{y} oscillates with local frequency #{\approx \sqrt{|q|}/\varepsilon} (recall, if #{y \propto e^{i\phi(x)}}, the local frequency is #{d\phi /dx}).}
\li{This approximation is invalid at and near #{q = 0}, because the asymptotic ordering in (#{\dagger}) assumed #{|q| \gg \varepsilon}.}
}
\p{\em{Question:} how close to #{x = a} is our approximation valid? Assume #{|x - a| \ll 1}; then #{q \approx q'(a)(x - a)}, so we need #{|x - a| \gg \varepsilon}.}
