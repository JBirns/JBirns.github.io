\title{Approximating Integrals}
\date{2023-10-01}
\author{JB00}
\import{macros}

\p{\strong{Taylor expanding the integrand – Stieltjes integrals}}

\transclude{AM0L}

\p{\strong{Integration by parts}}

##{\int_a^b f'(t)g(t)\,dt = [fg]_a^b - \int_a^b fg'\,dt.}

\p{\em{Generalisation:}}

##{I = \int_a^b f\,g^{(n)}(t)\,dt = \sum_{k=1}^n (-1)^{k-1}\big[ f^{(k-1)}g^{(n-k)} \big]_a^b + (-1)^n\int_a^b f^{(n)}g\,dt.}

\p{The idea: repeated IBP can generate an asymptotic approximation composed of boundary terms under certain circumstances.}

\transclude{AM0M}

\transclude{AM0N}

\p{\strong{The Gamma Function}}

\p{Recall the definition of the Gamma function:}

##{\Gamma(z) = \int_0^\infty t^{z-1}e^{-t}\,dt, \quad \operatorname{Re}(z) > 0.}

\p{\em{Basic properties:}}

\ul{
\li{\strong{(a)} #{\Gamma} is an analytic function for #{\operatorname{Re}(z) > 0};}
\li{\strong{(b)} #{\Gamma(z + 1) = z\Gamma(z)} (recursion relation);}
\li{\strong{(c)} #{\Gamma(n + 1) = n!} for #{n \in \mathbb{Z}^+}, and #{\Gamma(1) = 1};}
\li{\strong{(d)} #{\int_0^\infty t^{z-1}e^{-xt}\,dt = \frac{\Gamma(z)}{x^z}} for #{x > 0}.}
}

\p{For more properties: p. 14 Chapling.}

\p{\strong{Watson’s Lemma}}

\p{Consider #{F(x) = \int_0^T f(t)e^{-xt}\,dt} as #{x \to \infty}, #{0 < T \leq \infty}.}

\transclude{AM0O}

\transclude{AM0P}

\p{\strong{Laplace’s Integrals & Laplace’s Method}}

\transclude{AM0Q}

\p{How does #{I} behave as #{x \to \infty}?}

\ul{
\li{Watson’s Lemma deals with the special case #{\phi(t) = -t} (#{a = 0}, #{b = T}). #{I(x)} in this case is dominated by contributions near #{t = 0}.}
\li{In general, we have the “principle of localisation” (Laplace): “the asymptotic expansion of #{I(x)} as #{x \to \infty} is determined by contributions from small neighbourhoods of the maxima of #{\phi}”.}
}

\ul{
\li{\strong{(i)} Watson’s case: the endpoint dominates (the maximum of #{\phi = -t} is at #{t = 0}).}
\li{\strong{(ii)} Suppose #{\phi} has its maximum at an internal point #{t = c}. Then as #{x \to \infty}, the integral is dominated by a small region around #{t = c}.}
}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (4.2,0) node[right] {$t$};
\draw[->] (0,0) -- (0,1.6) node[above] {$\phi$};
\draw[thick] (0.6,0.4) .. controls (1.4,1.6) and (2.6,1.6) .. (3.4,0.2);
\fill (2.0,1.3) circle (1.5pt);
\draw (0.6,0.07) -- (0.6,-0.07) node[below] {$a$};
\draw (2.0,0.07) -- (2.0,-0.07) node[below] {$c$};
\draw (3.4,0.07) -- (3.4,-0.07) node[below] {$b$};
\node[right] at (4.6,1.0) {max of $\phi$ at an internal point};
\begin{scope}[shift={(0,-3.4)}]
\draw[->] (0,0) -- (4.2,0) node[right] {$t$};
\draw[->] (0,0) -- (0,2.4) node[above] {integrand};
\draw (0.6,0.4) -- (1.6,0.5) -- (2.0,0.8) -- (2.4,0.5) -- (3.4,0.3);
\draw (0.6,0.3) -- (1.6,0.6) -- (2.0,1.5) -- (2.4,0.6) -- (3.4,0.15);
\draw (0.6,0.2) -- (1.7,0.5) -- (2.0,2.1) -- (2.3,0.5) -- (3.4,0.08);
\draw (0.6,0.07) -- (0.6,-0.07) node[below] {$a$};
\draw (2.0,0.07) -- (2.0,-0.07) node[below] {$c$};
\draw (3.4,0.07) -- (3.4,-0.07) node[below] {$b$};
\node[right] at (4.6,0.4) {$x = 0$};
\node[right] at (4.6,1.6) {$x$ increases};
\end{scope}
\end{tikzpicture}}

\p{Let’s look at different cases.}

\ul{
\li{\p{\strong{(a)} Suppose #{\phi(t)} is monotonic on #{[a, b]}.}
\ul{
\li{\p{If #{\phi'(t) > 0} on #{t \in [a, b]} and #{f(b) \neq 0}, we expect #{I} to be dominated at the endpoint #{t = b}. Let #{u = \phi(t)}, #{t = \phi^{-1}(u)}:}
##{I(x) = \int_a^b f(t)e^{x\phi(t)}\,dt = \int_{\phi(a)}^{\phi(b)} \Big[ \frac{f(t)}{\phi'(t)} \Big]e^{xu}\,du.}
\p{Use \ref{AM0N} (IBP) to get}
##{I(x) \sim \frac{f(b)e^{x\phi(b)}}{x\phi'(b)} \quad \text{as } x \to \infty.}}
\li{\p{If #{\phi'(t) < 0} on #{t \in [a, b]} and #{f(a) \neq 0}, then}
##{I(x) \sim \frac{f(a)e^{x\phi(a)}}{x|\phi'(a)|} \quad \text{as } x \to \infty.}}
}}
\li{\p{\strong{(b)} Suppose #{\phi} has an internal maximum at #{t = c}, so that #{\phi'(c) = 0} and #{\phi''(c) < 0}, and #{f(c) \neq 0}. Split}
##{I(x) = \int_{c-\varepsilon}^{c+\varepsilon} f(t)e^{x\phi(t)}\,dt + \int_{\Omega_\varepsilon} f(t)e^{x\phi(t)}\,dt = I_1 + I_2,}
\p{where #{\Omega_\varepsilon = [a, c - \varepsilon] \cup [c + \varepsilon, b]}.}
\p{Let’s look at #{I_2} first. Let #{L_\varepsilon = \max_{t \in \Omega_\varepsilon} \phi}, so #{L_\varepsilon < \phi(c)}, the absolute maximum. Then}
##{|I_2| \leq e^{xL_\varepsilon}\int_{\Omega_\varepsilon} |f(t)|\,dt \leq e^{xL_\varepsilon}\int_a^b |f(t)|\,dt < Ke^{xL_\varepsilon},}
\p{so #{I_2 = O(e^{xL_\varepsilon}) \ll e^{x\phi(c)}} as #{x \to \infty}.}
\p{Now look at #{I_1}: expand #{f} and #{\phi} around #{t = c}:}
##{\phi(t) = \phi(c) + \underbrace{\phi'(c)}_{= 0}(t - c) + \frac{\phi''(c)}{2}(t - c)^2 + \cdots, \qquad f(t) = f(c) + \cdots.}
\p{So}
##{\begin{aligned}
I_1 &= \int_{c-\varepsilon}^{c+\varepsilon} [f(c) + \cdots]\exp\big[ x\phi(c) + \tfrac{1}{2}x\phi''(c)(t - c)^2 + \cdots \big]\,dt \\
&\approx f(c)e^{x\phi(c)}\int_{c-\varepsilon}^{c+\varepsilon} e^{\frac{1}{2}x\phi''(c)(t - c)^2}\,dt.
\end{aligned}}
\p{Let #{s = [-x\phi''(c)]^{1/2}(t - c)}. Then}
##{I_1 \approx \frac{f(c)e^{x\phi(c)}}{\sqrt{-x\phi''(c)}}\int_{-[-x\phi''(c)]^{1/2}\varepsilon}^{[-x\phi''(c)]^{1/2}\varepsilon} e^{-s^2/2}\,ds.}
\p{Take #{x} large, keeping #{\varepsilon} fixed (#{\ast}):}
##{I_1 \sim \frac{f(c)e^{x\phi(c)}}{\sqrt{-x\phi''(c)}}\int_{-\infty}^\infty e^{-s^2/2}\,ds \sim f(c)e^{x\phi(c)}\sqrt{\frac{2\pi}{-x\phi''(c)}}.}
\p{Step (#{\ast}) is justified because the error is of the form #{\int_z^\infty e^{-t^2/2}\,dt \sim \frac{1}{z}e^{-z^2/2}} as #{z \to \infty} (see \ref{AM0M}), which is very small. So #{I_1 \gg I_2}, and}
##{I(x) \sim I_1 \sim f(c)e^{x\phi(c)}\sqrt{\frac{2\pi}{-x\phi''(c)}}}
\p{(see Miller §3.3 for something more rigorous).}}
}

\transclude{AM0R}

\ul{
\li{\p{\strong{(c)} What if #{\phi} achieves its absolute maximum at an internal point #{t = c} and also at an endpoint #{t = b}? Thus #{\phi(b) = \phi(c) = \max_{t \in [a,b]} \phi}, with #{\phi'(c) = 0}, #{\phi'(b) \neq 0}, and #{f(c) \neq 0} and #{f(b) \neq 0}.}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (3.6,0);
\draw[->] (0,0) -- (0,1.8);
\draw[thick] (0.3,0.2) .. controls (0.6,1.6) and (1.0,1.6) .. (1.5,0.9) .. controls (2.0,0.2) and (2.7,0.4) .. (3.0,1.35);
\fill (0.82,1.33) circle (1.5pt);
\fill (3.0,1.35) circle (1.5pt);
\draw (0.3,0.07) -- (0.3,-0.07) node[below] {$a$};
\draw (0.82,0.07) -- (0.82,-0.07) node[below] {$c$};
\draw (3.0,0.07) -- (3.0,-0.07) node[below] {$b$};
\node[right, align=left] at (4.0,0.9) {The internal point dominates\\ the integral as $x \to \infty$.};
\end{tikzpicture}}
\p{The endpoint contribution is #{\propto \frac{e^{x\phi(b)}}{x}} and the internal contribution is #{\propto \frac{e^{x\phi(c)}}{\sqrt{x}}}, and so as #{x \to \infty}, endpoint #{\ll} internal.}}
\li{\p{\strong{(d)} What if #{\phi} has many internal local maxima, i.e. #{\phi'(c_i) = 0} and #{\phi''(c_i) < 0} for #{i = 1, 2, \ldots, n}? Then only the absolute maximum matters. E.g. with three local maxima #{c_1 < c_2 < c_3} and #{\phi(c_3)} the largest:}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (4,0) node[right] {$t$};
\draw[->] (0,0) -- (0,1.8) node[above] {$\phi$};
\draw[thick] (0.3,0.2) .. controls (0.6,1.1) and (0.9,1.1) .. (1.1,0.5) .. controls (1.3,0) and (1.6,1.3) .. (1.8,1.0) .. controls (2.0,0.6) and (2.2,0.4) .. (2.4,0.8) .. controls (2.6,1.6) and (2.9,1.7) .. (3.4,0.3);
\draw (0.3,0.07) -- (0.3,-0.07) node[below] {$a$};
\draw (0.75,0.07) -- (0.75,-0.07) node[below] {$c_1$};
\draw (1.7,0.07) -- (1.7,-0.07) node[below] {$c_2$};
\draw (2.75,0.07) -- (2.75,-0.07) node[below] {$c_3$};
\draw (3.4,0.07) -- (3.4,-0.07) node[below] {$b$};
\end{tikzpicture}}
\p{#{c_3} contributes #{\propto \frac{e^{x\phi(c_3)}}{\sqrt{x}}}, #{c_2} contributes #{\propto \frac{e^{x\phi(c_2)}}{\sqrt{x}}}, #{c_1} contributes #{\propto \frac{e^{x\phi(c_1)}}{\sqrt{x}}}; so #{c_3}’s contribution #{\gg} #{c_1}’s, #{c_2}’s. Local maxima that are not the absolute maximum contribute terms that are exponentially smaller.}
\p{E.g. if #{\phi(c_1) = \phi(c_2)} are both the absolute maximum: if several local maxima are also the absolute maximum, their contributions must be summed up as they are all dominant:}
##{I(x) \sim \sqrt{\frac{2\pi}{-x\phi''(c_1)}}f(c_1)e^{x\phi(c_1)} + \sqrt{\frac{2\pi}{-x\phi''(c_2)}}f(c_2)e^{x\phi(c_2)}.}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (4,0) node[right] {$t$};
\draw[->] (0,0) -- (0,1.8) node[above] {$\phi$};
\draw[thick] (0.3,0.3) .. controls (0.8,1.6) and (1.3,1.6) .. (1.8,0.6) .. controls (2.1,0.2) and (2.5,1.6) .. (2.9,1.25) .. controls (3.1,1.0) .. (3.4,0.4);
\fill (1.05,1.27) circle (1.5pt);
\fill (2.75,1.27) circle (1.5pt);
\draw (0.3,0.07) -- (0.3,-0.07) node[below] {$a$};
\draw (1.05,0.07) -- (1.05,-0.07) node[below] {$c_1$};
\draw (2.75,0.07) -- (2.75,-0.07) node[below] {$c_2$};
\draw (3.4,0.07) -- (3.4,-0.07) node[below] {$b$};
\end{tikzpicture}}}
}

\p{\strong{Back to case (b): a more rigorous proof of the “non-local” contribution.}}

##{I_2 = \int_{\Omega_\varepsilon} f(t)e^{x\phi(t)}\,dt = \underbrace{\int_a^{c-\varepsilon} fe^{x\phi}\,dt}_{\phi \text{ is increasing}} + \underbrace{\int_{c+\varepsilon}^b fe^{x\phi}\,dt}_{\phi \text{ is decreasing}},}

\p{which are #{O\big( \frac{1}{x}e^{x\phi(c-\varepsilon)} \big)} and #{O\big( \frac{1}{x}e^{x\phi(c+\varepsilon)} \big)} respectively, both #{\ll \frac{1}{\sqrt{x}}e^{x\phi(c)}}.}

\ul{
\li{\p{\strong{(e)} What if an endpoint is a (local and absolute) maximum, i.e. #{\phi'(b) = 0}, #{\phi''(b) < 0} and #{f(b) \neq 0}?}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.8]
\draw[->] (0,0) -- (4,0);
\draw[->] (0,0) -- (0,2);
\draw[thick] (0.3,0.6) .. controls (0.8,1.1) and (1.2,0.4) .. (1.7,0.7) .. controls (2.1,1.0) and (2.2,1.7) .. (2.8,1.7);
\draw[thick, dotted] (2.8,1.7) .. controls (3.2,1.7) and (3.4,1.0) .. (3.4,0.2);
\draw[dotted] (2.8,1.7) -- (2.8,0);
\draw (0.3,0.07) -- (0.3,-0.07) node[below] {$a$};
\draw (2.8,0.07) -- (2.8,-0.07) node[below] {$b$};
\end{tikzpicture}}
\p{Proceed as in case (b):}
##{I \sim \int_{b-\varepsilon}^b fe^{x\phi}\,dt \sim \frac{f(b)e^{x\phi(b)}}{\sqrt{-x\phi''(b)}}\int_{-\infty}^0 e^{-s^2/2}\,ds \sim \frac{1}{2}\frac{f(b)e^{x\phi(b)}}{\sqrt{-x\phi''(b)}}\sqrt{2\pi}.}}
}

\transclude{AM0S}

\ul{
\li{\p{\strong{(f)} What if #{\phi'(c) = \phi''(c) = \cdots = \phi^{(p-1)}(c) = 0} and #{\phi^{(p)}(c) < 0}, where #{p} is an even positive integer, and #{f(c) \neq 0}? Taylor expansion of #{\phi} gives #{\phi = \phi(c) + \frac{\phi^{(p)}(c)}{p!}(t - c)^p + \cdots}, so}
##{I \sim \int_{c-\varepsilon}^{c+\varepsilon} f(t)e^{x\phi(t)}\,dt \sim \int_{c-\varepsilon}^{c+\varepsilon} f(c)e^{x\phi(c)}e^{x\phi^{(p)}(c)(t - c)^p/p!}\,dt.}
\p{Substitute #{s = [-x\phi^{(p)}(c)/p!]^{1/p}(t - c)} and let #{x \to \infty}:}
##{I \sim \Big[ \frac{p!}{-x\phi^{(p)}(c)} \Big]^{1/p}f(c)e^{x\phi(c)}\int_{-\infty}^\infty e^{-s^p}\,ds.}
\p{Note: using #{u = s^p},}
##{\int_0^\infty e^{-s^p}\,ds = \int_0^\infty \frac{e^{-u}u^{\frac{1}{p} - 1}}{p}\,du = \frac{1}{p}\Gamma\Big( \frac{1}{p} \Big) = \Gamma\Big( 1 + \frac{1}{p} \Big),}
\p{so}
##{I \sim \Big[ \frac{p!}{-x\phi^{(p)}(c)} \Big]^{1/p}f(c)e^{x\phi(c)} \cdot 2\Gamma\Big( 1 + \frac{1}{p} \Big) \quad \text{as } x \to \infty.}}
\li{\strong{(g)} How do I get higher-order terms? You keep higher-order terms in the Taylor expansions of #{f} and #{\phi} (around #{c}). This is ugly in general; see pp. 22–23 in Chapling.}
}

\transclude{AM0T}

\p{\strong{Oscillatory Integrals and the Method of Stationary Phase}}

\p{Consider “Fourier-type” integrals, like}

##{F(x) = \int_a^b f(t)e^{ix\phi(t)}\,dt, \quad b > a,\; x \text{ very large}.}

\p{As #{x \to \infty} the modulus of #{e^{ix\phi}} stays #{1}, but the integrand oscillates more and more and goes crazy. In fact, you get catastrophic cancellation in the integral and generally #{F(x) \to 0}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (0,-1.6) -- (0,1.8) node[above] {integrand};
\draw[->] (0,0) -- (5.2,0) node[right] {$t$};
\draw[thick, domain=0.6:4.6] plot (\x, {0.5 + 0.18*\x});
\draw[thick, domain=0.6:4.6] plot (\x, {-0.5 - 0.18*\x});
\node[right] at (4.6,1.33) {$f$};
\node[right] at (4.6,-1.33) {$-f$};
\draw[gray, domain=0.6:4.6, samples=80] plot (\x, {(0.5 + 0.18*\x)*sin(300*\x)});
\draw[red, domain=0.6:4.6, samples=300] plot (\x, {(0.5 + 0.18*\x)*sin(1500*\x)});
\draw (0.6,0.07) -- (0.6,-0.07) node[below left] {$a$};
\draw (4.6,0.07) -- (4.6,-0.07) node[below right] {$b$};
\node[red, right] at (5.4,1.0) {large $x$};
\node[gray, right] at (5.4,0.5) {small $x$};
\end{tikzpicture}}

\p{\em{Key idea:} as #{x} gets very big, the ‘wavelength’ of oscillations becomes much smaller than the length scale of variation of #{f} (and #{\phi}), so locally it looks like we’re integrating sinusoids, which will integrate to #{0}. (Zooming in, the positive and negative lobes cancel.)}

\transclude{AM0U}

\ul{
\li{\p{\strong{(a)} Consider linear #{\phi}. Q: How fast does #{F \to 0} as #{x \to \infty}?}
##{\begin{aligned}
F(x) &= \Big[ \frac{fe^{ixt}}{ix} \Big]_a^b - \frac{1}{ix}\int_a^b f'(t)e^{ixt}\,dt \\ &= \frac{1}{ix}\Big[ f(b)e^{ixb} - f(a)e^{ixa} - \underbrace{\int_a^b f'(t)e^{ixt}\,dt}_{\to 0 \text{ as } x \to \infty \text{ by R--L}} \Big].
\end{aligned}}
\p{Assuming #{f(a) \neq 0} and #{f(b) \neq 0},}
##{F(x) \sim \frac{1}{ix}\big[ f(t)e^{ixt} \big]_a^b = O(1/x).}
\ul{
\li{The behaviour of #{f} at the endpoints controls the leading order asymptotics of #{F}.}
\li{If #{f \to 0} at the endpoints then #{F} is small beyond all orders in #{x^{-k}}. In particular, if #{F(x) = \int_{-\infty}^\infty f(t)e^{ixt}\,dt}, then we usually assume #{f \to 0} as #{t \to \pm\infty}, so #{F(x) = O(x^{-N})} for all #{N \in \mathbb{Z}^+} if #{f} is infinitely differentiable.}
}}
\li{\p{\strong{(b)} Consider general #{\phi}, but monotonic on #{[a, b]}, meaning #{\phi'(t) \neq 0}. Let #{u = \phi(t)}, #{t = \phi^{-1}(u)}:}
##{F(x) = \int_a^b f(t)e^{ix\phi(t)}\,dt = \int_{\phi(a)}^{\phi(b)} \frac{f(t)}{\phi'(t)}e^{ixu}\,du \sim \frac{1}{ix}\Big[ \frac{f(t)}{\phi'(t)}e^{ix\phi(t)} \Big]_a^b = O\Big( \frac{1}{x} \Big)}
\p{by IBP like in (a).}}
\li{\p{\strong{(c)} If #{\phi} has one stationary point #{c \in (a, b)}, meaning #{\phi'(c) = 0}: around the point #{c}, the catastrophic cancellation in #{F} is less pronounced (a “plateau at #{c}”).}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw[->] (0,-1.2) -- (0,1.4) node[above] {integrand};
\draw[->] (0,0) -- (5,0) node[right] {$t$};
\draw[gray, domain=0.4:4.4, samples=400] plot (\x, {0.9*sin(3000*(\x -2.4)^2)});
\draw[dashed] (0.4,0.9) -- (4.4,0.9) (0.4,-0.9) -- (4.4,-0.9);
\draw (0.4,0.07) -- (0.4,-0.07) node[below left] {$a$};
\draw (2.4,0.07) -- (2.4,-0.07);
\node[below] at (2.4,-1.0) {$c$};
\draw (4.4,0.07) -- (4.4,-0.07) node[below right] {$b$};
\end{tikzpicture}}
\p{\em{Localisation Principle for Oscillating Integrals:} “The asymptotic expansion of #{F} for large #{x} is controlled by the points of stationary phase (and possibly the endpoints).” (Due to Stokes, Kelvin.)}
##{\begin{aligned}
F(x) &= \underbrace{\int_a^{c-\varepsilon} f(t)e^{ix\phi(t)}\,dt}_{= O(\frac{1}{x}) \text{ by (b)}} + \int_{c-\varepsilon}^{c+\varepsilon} f(t)e^{ix\phi(t)}\,dt + \underbrace{\int_{c+\varepsilon}^b f(t)e^{ix\phi(t)}\,dt}_{= O(\frac{1}{x}) \text{ by (b)}} \\ &= \int_{c-\varepsilon}^{c+\varepsilon} fe^{ix\phi}\,dt + O\Big( \frac{1}{x} \Big).
\end{aligned}}
\p{Taylor expand #{\phi} around #{c}, and #{f}: #{\phi(t) = \phi(c) + \frac{\phi''(c)}{2}(t - c)^2 + \cdots}, #{f = f(c) + \cdots}. So}
##{\int_{c-\varepsilon}^{c+\varepsilon} fe^{ix\phi}\,dt \approx f(c)e^{ix\phi(c)}\int_{c-\varepsilon}^{c+\varepsilon} \exp\Big[ \frac{ix\phi''(c)(t - c)^2}{2} \Big]\,dt.}
\p{Define #{s = \big| \frac{x\phi''(c)}{2} \big|^{1/2}(t - c)}:}
##{= \frac{f(c)e^{ix\phi(c)}}{|x\phi''(c)/2|^{1/2}}\int_{-|\frac{x}{2}\phi''(c)|^{1/2}\varepsilon}^{|\frac{x}{2}\phi''(c)|^{1/2}\varepsilon} e^{i\sigma s^2}\,ds,}
\p{where #{\sigma = \operatorname{sgn}(\phi''(c)) = \pm 1},}
##{\sim \frac{f(c)e^{ix\phi(c)}}{|x\phi''(c)/2|^{1/2}}\underbrace{\int_{-\infty}^\infty e^{i\sigma s^2}\,ds}_{\text{``Fresnel integral''} = \sqrt{\pi}e^{i\pi\sigma /4} \text{ by ES1}} \quad \text{as } x \to \infty.}
\p{Therefore}
##{F(x) \sim f(c)e^{ix\phi(c)}\sqrt{\frac{2\pi}{-ix\phi''(c)}}.}
\p{Note: the endpoint contributions are #{O(\frac{1}{x})}, the stationary one is #{O(\frac{1}{\sqrt{x}})}. This is the \em{method of stationary phase}.}}
}

\transclude{AM0V}

\p{\strong{Final points.}}

\ul{
\li{\em{All} stationary points of #{\phi} contribute to leading order in the expansion, i.e. there is no hierarchy of size (compare with Laplace’s method).}
\li{Endpoints \em{can} contribute to the next order in the expansion (at #{O(\frac{1}{x})}).}
\li{Be aware of the problem in the definition of “#{\sim}” if we find #{F} is oscillatory and has many zeroes.}
}

\p{\strong{Method of Steepest Descent}}

\p{Consider integrals of the form}

##{I(x) = \int_C f(z)e^{x\phi(z)}\,dz \quad \text{as } x \to \infty,}

\p{where #{C} is a contour in #{\mathbb{C}}, and #{f} and #{\phi} are complex-valued functions analytic in a domain containing #{C}. In what follows, #{z \in \mathbb{C}}, #{z = p + iq}, #{p, q \in \mathbb{R}}; #{\phi = u(p, q) + iv(p, q)}, #{u, v} real functions. Then}

##{I(x) = \int_C f\underbrace{e^{xu}}_{\text{amplitude}} \cdot \underbrace{e^{ixv}}_{\text{oscillatory part}}\,dz.}

\p{\strong{Interlude 1: Cauchy–Riemann equations.} #{\phi} analytic on #{D}; then #{u_p = v_q}, #{u_q = -v_p}. Then #{\nabla u = (u_p, u_q)}, #{\nabla v = (v_p, v_q)}, so #{\nabla u \cdot \nabla v = 0}.}

\ul{
\li{Level contours of #{u, v} are orthogonal.}
\li{Also #{\nabla v} is tangent to curves of constant #{u}, and #{\nabla u} is tangent to curves of constant #{v}.}
\li{On constant-#{v} curves, #{u} is maximally increasing/decreasing, and vice versa.}
}

\p{E.g. #{\phi = z^2 \Rightarrow u = p^2 - q^2}, #{v = 2pq}.}

