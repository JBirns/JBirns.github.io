\title{Orthogonal families}
\taxon{Lemma}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{If #{(e_1, \ldots, e_k)} is orthogonal then}

\ul{
\li{\strong{(i)} the family is free;}
\li{\strong{(ii)} if #{v = \sum_{j=1}^k \lambda_je_j}, then #{\lambda_j = \dfrac{\langle v, e_j \rangle}{\Vert e_j\Vert ^2}}.}
}

\proof{
\p{(i) If #{\sum_{j=1}^k \lambda_je_j = 0}, then for each #{i},}

##{0 = \Big\langle \sum_{j=1}^k \lambda_je_j, e_i \Big\rangle = \sum_{j=1}^k \lambda_j\langle e_j, e_i \rangle = \lambda_i\Vert e_i\Vert ^2}

\p{by orthogonality, so #{\lambda_i = 0}: the family is free.}

\p{(ii) If #{v = \sum_{i=1}^k \lambda_ie_i} then #{\langle v, e_j \rangle = \lambda_j\langle e_j, e_j \rangle = \lambda_j\Vert e_j\Vert ^2}, so #{\lambda_j = \dfrac{1}{\Vert e_j\Vert ^2}\langle v, e_j \rangle}.}
}
