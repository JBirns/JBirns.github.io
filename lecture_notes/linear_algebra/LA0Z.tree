\title{also of Steinitz}
\taxon{Corollary}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Let #{V} be a vector space over #{F} with dimension #{n \in \mathbb{N}_{>0}}.}

\ul{
\li{\strong{(i)} Any set of independent vectors has at \em{most} #{n} elements, with equality iff it is a basis.}
\li{\strong{(ii)} Any spanning (generating) set of vectors has at \em{least} #{n} elements, with equality iff it is a basis.}
}

\proof{
\p{Exercise.}
}
