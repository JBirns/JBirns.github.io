\title{Trace of the dual map}
\taxon{Lemma}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Let #{\alpha \colon V \to V} be linear and #{\alpha^* \colon V^* \to V^*} the dual map. Then #{\operatorname{Tr}\alpha = \operatorname{Tr}\alpha^*}.}

\proof{
\p{#{\operatorname{Tr}\alpha = \operatorname{Tr}([\alpha]_{\mathcal{B}}) = \operatorname{Tr}([\alpha]_{\mathcal{B}}^T) = \operatorname{Tr}([\alpha^*]_{\mathcal{B}^*})} by \ref{LA35}.}
}
