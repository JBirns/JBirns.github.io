\title{Classification of volume forms}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{d} be a volume form on #{F^n} and #{A = \big( A^{(1)} \mid \cdots \mid A^{(n)} \big)}. Then}

##{d\big( A^{(1)}, \ldots, A^{(n)} \big) = d(e_1, \ldots, e_n)\det(A),}

\p{where #{(e_i)} is the canonical basis. #{\leadsto} Up to a constant, #{\det} is the \em{only} volume form on #{F^n}.}

\proof{
\p{By linearity in each argument,}

##{\begin{aligned}
d\big( A^{(1)}, \ldots, A^{(n)} \big) &= d\Big( \sum_{i=1}^n a_{i1}e_i, A^{(2)}, \ldots, A^{(n)} \Big) \\
&= \sum_{i=1}^n a_{i1}\,d\big( e_i, A^{(2)}, \ldots, A^{(n)} \big) \\
&= \sum_{i=1}^n a_{i1}\,d\Big( e_i, \sum_{j=1}^n a_{j2}e_j, \ldots, A^{(n)} \Big) \\
&= \sum_{i=1}^n \sum_{j=1}^n a_{i1}a_{j2}\,d\big( e_i, e_j, A^{(3)}, \ldots, A^{(n)} \big) \\
&= \cdots = \sum_{1 \leq i_1, \ldots, i_n \leq n} \Big( \prod_{k=1}^n a_{i_kk} \Big) d(e_{i_1}, e_{i_2}, \ldots, e_{i_n}).
\end{aligned}}

\p{For #{d(e_{i_1}, \ldots, e_{i_n})} \em{not} to be #{0}, we need all the #{i_k} to be distinct, i.e. there exists #{\sigma \in S_n} with #{i_k = \sigma(k)}. This means}

##{\begin{aligned}
d\big( A^{(1)}, \ldots, A^{(n)} \big) &= \sum_{\sigma \in S_n} \prod_{k=1}^n a_{\sigma(k)k}\,d(e_{\sigma(1)}, \ldots, e_{\sigma(n)}) \\
&= \sum_{\sigma \in S_n} \Big[ \prod_{k=1}^n a_{\sigma(k)k} \Big] \varepsilon(\sigma)\,d(e_1, \ldots, e_n) && \text{(1)} \\
&= \underbrace{d(e_1, \ldots, e_n)}_{\text{scalar}}\underbrace{\Big[ \sum_{\sigma \in S_n} \varepsilon(\sigma)\prod_{k=1}^n a_{\sigma(k)k} \Big]}_{\det A}.
\end{aligned}}

\p{Here (1) \ref{LA49}.}
}
