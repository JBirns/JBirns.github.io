\title{Parseval’s identity}
\taxon{Lemma}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{If #{V} is a finite dimensional inner product space and #{(e_1, \ldots, e_n)} is an \em{orthonormal} basis, then}

##{\langle u, v \rangle = \sum_{i=1}^n \langle u, e_i \rangle\overline{\langle v, e_i \rangle}.}

\proof{
\p{#{u = \sum_{i=1}^n \langle u, e_i \rangle e_i} and #{v = \sum_{i=1}^n \langle v, e_i \rangle e_i} (#{\Vert e_i\Vert  = 1}), so}

##{\langle u, v \rangle = \Big\langle \sum_{i=1}^n \langle u, e_i \rangle e_i, \sum_{j=1}^n \langle v, e_j \rangle e_j \Big\rangle = \sum_{i=1}^n \langle u, e_i \rangle\overline{\langle v, e_i \rangle}}

\p{by orthonormality.}
}
