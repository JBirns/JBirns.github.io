\title{Matrix of the dual map}
\taxon{Proposition}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Let #{V, W} be finite dimensional spaces over #{F} with bases #{\mathcal{B}}, #{\mathcal{C}} respectively. Let #{\mathcal{B}^*}, #{\mathcal{C}^*} be the dual bases of #{V^*}, #{W^*}. Then}

##{[\alpha^*]_{\mathcal{C}^*,\mathcal{B}^*} = [\alpha]_{\mathcal{B},\mathcal{C}}^T.}

\proof{
\p{Write #{\mathcal{B} = (b_1, \ldots, b_n)}, #{\mathcal{C} = (c_1, \ldots, c_m)}, #{\mathcal{B}^* = (\beta_1, \ldots, \beta_n)}, #{\mathcal{C}^* = (\gamma_1, \ldots, \gamma_m)}. Say #{[\alpha]_{\mathcal{B},\mathcal{C}} = A = (a_{ij})_{1 \leq i \leq m,\, 1 \leq j \leq n}}. Recall #{\alpha^* \colon W^* \to V^*}. Let us compute}

##{\alpha^*(\gamma_r)(b_s) = \gamma_r \circ \alpha(b_s) = \gamma_r\Big( \sum_t a_{ts}c_t \Big) = \sum_t a_{ts}\gamma_r(c_t) = a_{rs},}

\p{since column #{s} of #{A} holds the coordinates of #{\alpha(b_s)} in #{\mathcal{C}}. Now say #{[\alpha^*]_{\mathcal{C}^*,\mathcal{B}^*} = \big( \alpha^*(\gamma_1) \mid \cdots \mid \alpha^*(\gamma_m) \big) = (m_{ij})_{1 \leq i \leq n,\, 1 \leq j \leq m}}. Then}

##{\alpha^*(\gamma_r) = \sum_{i=1}^n m_{ir}\beta_i \implies \alpha^*(\gamma_r)(b_s) = \sum_{i=1}^n m_{ir}\underbrace{\beta_i(b_s)}_{\delta_{is}} = m_{sr}.}

\p{Conclusion: #{\alpha^*(\gamma_r)(b_s) = a_{rs} = m_{sr}}, i.e. #{[\alpha^*]_{\mathcal{C}^*,\mathcal{B}^*} = [\alpha]_{\mathcal{B},\mathcal{C}}^T}.}
}
