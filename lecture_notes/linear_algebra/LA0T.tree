\title{Bases and unique coordinates}
\taxon{Lemma}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Let #{V} be an #{F}-vector space. Then #{(v_1, \ldots, v_n)} is a basis of #{V} #{\iff} any vector #{v \in V} has a unique decomposition #{v = \sum_{i=1}^n \lambda_iv_i}, #{\lambda_i \in F}.}

\proof{
\p{By assumption #{\langle v_1, \ldots, v_n \rangle = V}, so for all #{v \in V} there exists #{(\lambda_1, \ldots, \lambda_n) \in F^n} s.t. #{v = \sum_{i=1}^n \lambda_iv_i}.}

\p{Uniqueness: if #{v = \sum_{i=1}^n \lambda_iv_i = \sum_{i=1}^n \lambda'_iv_i} then #{\sum_{i=1}^n (\lambda_i - \lambda'_i)v_i = 0}, so #{\lambda_i = \lambda'_i} for all #{1 \leq i \leq n}, since #{(v_1, \ldots, v_n)} is free.}
}
