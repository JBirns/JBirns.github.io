\title{Identity and composites of linear maps}
\taxon{Remark}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{U, V, W} be #{F}-vector spaces.}

\ul{
\li{\strong{(i)} #{\mathrm{Id}_V \colon V \to V}, #{x \mapsto x} is a linear map.}
\li{\strong{(ii)} If #{\beta \colon U \to V} and #{\alpha \colon V \to W} are linear, then #{\alpha \circ \beta \colon U \to W} is linear. Linearity is \em{stable} under composition.}
}
