\draw[->, thick] (O) -- (a) node[below] {$a$};
\draw[->, thick] (O) -- (b) node[above left] {$b$};
\draw[->, thick] (O) -- (c) node[left] {$c$};
\draw (a) -- ($(a)+(b)$) -- (b);
\draw (c) -- ($(c)+(a)$) -- ($(c)+(a)+(b)$) -- ($(c)+(b)$) -- cycle;
\draw[dashed] (a) -- ($(a)+(c)$);
\draw[dashed] ($(a)+(b)$) -- ($(a)+(b)+(c)$);
