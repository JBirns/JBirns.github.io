\p{In particular, for #{A = \begin{pmatrix} \lambda_1 & & * \\ & \ddots & \\ 0 & & \lambda_n \end{pmatrix}}, #{\det A = \prod_{i=1}^n \lambda_i}.}

\transclude{LA4O}

\p{If #{a, b, c} span a parallelepiped, then #{|\mathrm{volume}(\vec{a}, \vec{b}, \vec{c})| = |(a \wedge b) \cdot c|}. On the other hand, #{\det(a, b, c) = (a \wedge b) \cdot c} (check that this is a volume form). So}

##{\det(a, b, c) = \text{signed volume}.}

