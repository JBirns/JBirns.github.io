\title{Examples of vector spaces}
\taxon{Example}
\date{2026-11-24}
\author{JB00}
\import{macros}

\ul{
\li{\p{\strong{(i)} #{n \in \mathbb{N}}, #{F^n}: column vectors of length #{n} with entries in #{F}, #{v = \begin{pmatrix} x_1 \\ \vdots \\ x_n \end{pmatrix}}, #{x_i \in F}, #{1 \leq i \leq n}, with}
##{v + w = \begin{pmatrix} v_1 \\ \vdots \\ v_n \end{pmatrix} + \begin{pmatrix} w_1 \\ \vdots \\ w_n \end{pmatrix} = \begin{pmatrix} v_1 + w_1 \\ \vdots \\ v_n + w_n \end{pmatrix}, \qquad \lambda v = \begin{pmatrix} \lambda v_1 \\ \vdots \\ \lambda v_n \end{pmatrix} \in F^n.}
\p{Check: #{F^n} is an #{F}-vector space.}}
\li{\p{\strong{(ii)} For any set #{X}, #{\mathbb{R}^X = \lbrace f \colon X \to \mathbb{R}\rbrace } (the set of real-valued functions on #{X}). Then #{\mathbb{R}^X} is an #{\mathbb{R}}-vector space with}
##{(f_1 + f_2)(x) = f_1(x) + f_2(x), \qquad (\lambda f)(x) = \lambda f(x),\; \lambda \in \mathbb{R}.}}
\li{\strong{(iii)} #{M_{n,m}(F)}, the #{n \times m} #{F}-valued matrices, with entries #{a_{ij} \in F}, #{1 \leq i \leq n}, #{1 \leq j \leq m}. The sum is the sum of entries, and #{\lambda M = (\lambda m_{ij})_{1 \leq i \leq n,\, 1 \leq j \leq m}} where #{M = (m_{ij})}. So #{M_{n,m}} is an #{F}-vector space.}
}
