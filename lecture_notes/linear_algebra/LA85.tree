\title{Orthogonal and unitary groups}
\taxon{Definition}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{V} be a finite dimensional inner product space.}

\ul{
\li{#{F = \mathbb{R}}: #{O(V) = \lbrace \alpha \in \mathcal{L}(V) : \alpha \text{ isometry}\rbrace } is the \em{orthogonal group} of #{V}.}
\li{#{F = \mathbb{C}}: #{U(V) = \lbrace \alpha \in \mathcal{L}(V) : \alpha \text{ isometry}\rbrace } is the \em{unitary group} of #{V}.}
}
