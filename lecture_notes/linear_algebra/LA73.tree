\title{Matrices of Hermitian forms}
\taxon{Lemma}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{A sesquilinear form #{\phi \colon V \times V \to \mathbb{C}} is Hermitian #{\iff} for all bases #{\mathcal{B}} of #{V}, #{[\phi]_{\mathcal{B}} = \overline{[\phi]_{\mathcal{B}}}^T}.}

\proof{
\p{Let #{A = [\phi]_{\mathcal{B}} = (a_{ij})_{1 \leq i,j \leq n}}, #{a_{ij} = \phi(e_i, e_j)}. Then #{a_{ji} = \phi(e_j, e_i) = \overline{\phi(e_i, e_j)} = \bar{a}_{ij}}, so #{[\phi]_{\mathcal{B}}^T = \overline{[\phi]_{\mathcal{B}}}}.}

\p{Conversely, suppose #{[\phi]_{\mathcal{B}} = A} with #{A = \bar{A}^T}, #{\mathcal{B} = (e_1, \ldots, e_n)}. Let #{u = \sum_{i=1}^n \lambda_ie_i}, #{v = \sum_{i=1}^n \mu_ie_i}. Then}

##{\phi(u, v) = \phi\Big( \sum_{i=1}^n \lambda_ie_i, \sum_{j=1}^n \mu_je_j \Big) = \sum_{i,j=1}^n \lambda_i\bar{\mu}_j\phi(e_i, e_j) = \sum_{i,j=1}^n \lambda_i\bar{\mu}_ja_{ij}.}

\p{Then}

##{\begin{aligned}
\overline{\phi(v, u)} &= \overline{\phi\Big( \sum_{i=1}^n \mu_ie_i, \sum_{j=1}^n \lambda_je_j \Big)} = \overline{\sum_{i,j=1}^n \mu_i\bar{\lambda}_j\phi(e_i, e_j)} \\
&= \sum_{i,j=1}^n \bar{\mu}_i\lambda_j\bar{a}_{ij} = \sum_{i,j=1}^n \lambda_i\bar{\mu}_j\underbrace{\bar{a}_{ji}}_{a_{ij}} = \phi(u, v).
\end{aligned}}
}
