\title{Existence and uniqueness of JNF}
\taxon{Theorem}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Every matrix #{A \in M_n(\mathbb{C})} is similar to a matrix in JNF, which is unique up to reordering the Jordan blocks.}

\proof{
\p{(Non-examinable; follows from GRM.) Proof in the notes.}
}
