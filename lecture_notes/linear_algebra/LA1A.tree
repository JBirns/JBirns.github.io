\title{Linear map}
\taxon{Definition}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Let #{V, W} be vector spaces over #{F}. A map #{\alpha \colon V \to W} is \em{linear} iff}

##{\forall (\lambda_1, \lambda_2) \in F^2,\; \forall (v_1, v_2) \in V \times V, \quad \alpha(\lambda_1v_1 + \lambda_2v_2) = \lambda_1\alpha(v_1) + \lambda_2\alpha(v_2).}
