\title{JNFs for #{n = 2, 3}}
\taxon{Example}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{For #{n = 2}, the possible JNFs are}

##{\begin{aligned}
\begin{pmatrix} \lambda_1 & 0 \\ 0 & \lambda_2 \end{pmatrix},\; m = (t - \lambda_1)(t - \lambda_2); \qquad \begin{pmatrix} \lambda & 0 \\ 0 & \lambda \end{pmatrix},\; m = (t - \lambda); \\
\begin{pmatrix} \lambda & 1 \\ 0 & \lambda \end{pmatrix},\; m = (t - \lambda)^2.
\end{aligned}}

\p{For #{n = 3}:}

##{\begin{aligned}
\begin{pmatrix} \lambda_1 & 0 & 0 \\ 0 & \lambda_2 & 0 \\ 0 & 0 & \lambda_3 \end{pmatrix},\; m = (t - \lambda_1)(t - \lambda_2)(t - \lambda_3); \\
\begin{pmatrix} \lambda_1 & 0 & 0 \\ 0 & \lambda_2 & 0 \\ 0 & 0 & \lambda_2 \end{pmatrix},\; m = (t - \lambda_1)(t - \lambda_2); \\
\begin{pmatrix} \lambda_1 & 0 & 0 \\ 0 & \lambda_2 & 1 \\ 0 & 0 & \lambda_2 \end{pmatrix},\; m = (t - \lambda_1)(t - \lambda_2)^2; \\
\begin{pmatrix} \lambda & 0 & 0 \\ 0 & \lambda & 0 \\ 0 & 0 & \lambda \end{pmatrix},\; m = (t - \lambda); \\
\begin{pmatrix} \lambda & 0 & 0 \\ 0 & \lambda & 1 \\ 0 & 0 & \lambda \end{pmatrix},\; m = (t - \lambda)^2; \\
\begin{pmatrix} \lambda & 1 & 0 \\ 0 & \lambda & 1 \\ 0 & 0 & \lambda \end{pmatrix},\; m = (t - \lambda)^3.
\end{aligned}}
