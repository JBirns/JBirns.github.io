\p{\strong{Elementary facts about polynomials}}

\p{We will study #{P(\alpha)} where #{P} is a polynomial and #{\alpha \in \mathcal{L}(V)}.}

\ul{
\li{#{F} a field; #{f(t) = a_nt^n + a_{n-1}t^{n-1} + \cdots + a_1t + a_0}, #{a_i \in F}. The largest exponent #{n} s.t. #{a_n \neq 0} is #{n = \deg f}.}
\li{#{\deg(f + g) \leq \max\lbrace \deg f, \deg g\rbrace }, #{\deg(fg) = \deg f + \deg g}.}
\li{#{F[t] \coloneqq \lbrace \text{polynomials with coefficients in } F\rbrace }.}
\li{#{\lambda} is a \em{root} of #{f(t) \iff f(\lambda) = 0}.}
}

