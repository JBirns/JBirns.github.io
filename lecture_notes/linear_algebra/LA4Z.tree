\title{Eigenvectors, Eigenvalues and Triangular Matrices}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{#{\leadsto} First step towards the diagonalisation of endomorphisms. Let #{V} be a vector space over #{F}, #{\dim_F V = n < \infty}, and #{\alpha \colon V \to V} linear, an endomorphism of #{V}.}

\p{\strong{General problem.} Can we find a basis #{\mathcal{B}} of #{V} s.t. in this basis, #{[\alpha]_{\mathcal{B}} \coloneqq [\alpha]_{\mathcal{B},\mathcal{B}}} has a “nice” form?}

\p{Reminder: if #{\mathcal{B}'} is another basis of #{V} and #{P} the change of basis matrix, #{[\alpha]_{\mathcal{B}'} = P^{-1}[\alpha]_{\mathcal{B}}P}. Equivalently: given a square matrix, is it conjugate to a matrix with a “simple” form?}

