\title{Orthogonal, orthonormal}
\taxon{Definition}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{A set #{(e_1, \ldots, e_k)} of non-zero vectors of #{V} is}

\ul{
\li{\strong{(i)} \em{orthogonal} if #{\langle e_i, e_j \rangle = 0} for #{i \neq j};}
\li{\strong{(ii)} \em{orthonormal} if #{\langle e_i, e_j \rangle = \delta_{ij}}, where #{\delta_{ij} = 1} if #{i = j} and #{0} if #{i \neq j}.}
}
