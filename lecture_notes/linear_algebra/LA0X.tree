\p{\strong{Exercise.} Show that the following are equivalent:}

\ul{
\li{\strong{(i)} #{\sum_{i=1}^l V_i = \bigoplus_{i=1}^l V_i} (the sum is direct);}
\li{\strong{(ii)} for all #{i}, #{V_i \cap \Big( \sum_{j \neq i} V_j \Big) = \lbrace 0\rbrace };}
\li{\strong{(iii)} for any basis #{\mathcal{B}_i} of #{V_i}, #{\mathcal{B} = \bigcup_{i=1}^l \mathcal{B}_i} is a basis of #{\sum_{i=1}^l V_i}.}
}
