\title{Normal form of a linear map}
\taxon{Proposition}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{V, W} be vector spaces over #{F} with #{\dim_F V = n}, #{\dim_F W = m}, and let #{\alpha \colon V \to W} be a linear map. Then there exist a basis #{\mathcal{B}} of #{V} and a basis #{\mathcal{C}} of #{W} such that}

##{[\alpha]_{\mathcal{B},\mathcal{C}} = \begin{pmatrix} I_r & 0 \\ 0 & 0 \end{pmatrix}.}

\proof{
\p{Choose #{\mathcal{B}} and #{\mathcal{C}} wisely.}

\ul{
\li{Fix #{r \in \mathbb{N}} s.t. #{\dim\operatorname{Ker}\alpha = n - r}.}
\li{#{N(\alpha) = \operatorname{Ker}(\alpha) = \lbrace x \in V : \alpha(x) = 0\rbrace }.}
\li{Fix a basis of #{N(\alpha)}: #{v_{r+1}, \ldots, v_n}, and extend it to a basis #{\mathcal{B} = (v_1, \ldots, v_r, v_{r+1}, \ldots, v_n)} of #{V}.}
}

\p{\strong{Claim:} #{(\alpha(v_1), \ldots, \alpha(v_r))} is a basis of #{\operatorname{Im}\alpha}.}

\ul{
\li{Span: for #{v = \sum_{i=1}^n \lambda_iv_i}, #{\alpha(v) = \sum_{i=1}^n \lambda_i\alpha(v_i) = \sum_{i=1}^r \lambda_i\alpha(v_i)}. Let #{y \in \operatorname{Im}\alpha}; then there is #{v \in V} s.t. #{y = \alpha(v)}, so #{y = \sum_{i=1}^r \lambda_i\alpha(v_i) \in \langle \alpha(v_1), \ldots, \alpha(v_r) \rangle}.}
\li{Free: if #{\sum_{i=1}^r \lambda_i\alpha(v_i) = 0} then #{\alpha\big( \sum_{i=1}^r \lambda_iv_i \big) = 0}, so #{\sum_{i=1}^r \lambda_iv_i \in \operatorname{Ker}\alpha}, so #{\sum_{i=1}^r \lambda_iv_i = \sum_{i=r+1}^n \mu_iv_i}, so #{\sum_{i=1}^r \lambda_iv_i - \sum_{i=r+1}^n \mu_iv_i = 0}. Hence #{\lambda_i = 0}, #{\mu_i = 0} since #{\mathcal{B}} is free, and the family is free.}
}

\p{Conclusion: #{(\alpha(v_1), \ldots, \alpha(v_r))} is a basis of #{\operatorname{Im}\alpha} and #{(v_{r+1}, \ldots, v_n)} is a basis of #{\operatorname{Ker}\alpha}. Take}

##{\mathcal{B} = (v_1, \ldots, v_r, v_{r+1}, \ldots, v_n), \qquad \mathcal{C} = (\underbrace{\alpha(v_1), \ldots, \alpha(v_r)}_{\operatorname{Im}\alpha}, w_{r+1}, \ldots, w_m),}

\p{completing to a basis of #{W}. Then}

##{[\alpha]_{\mathcal{B},\mathcal{C}} = \big( \alpha(v_1) \mid \cdots \mid \alpha(v_r) \mid \alpha(v_{r+1}) \mid \cdots \mid \alpha(v_n) \big) = \begin{pmatrix} I_r & 0 \\ 0 & 0 \end{pmatrix}.}
}
