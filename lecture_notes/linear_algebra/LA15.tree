\title{Warning}
\taxon{Remark}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{If #{V = U \oplus W}, we say that #{W} is \em{a} complement of #{U} in #{V} (not “the”). There is no uniqueness of such a complement. E.g. in #{V = \mathbb{R}^2}, with #{U} a line through #{0} and #{W_1}, #{W_2} two other distinct lines through #{0}, #{V = U \oplus W_1 = U \oplus W_2}.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns,calc}}{\begin{tikzpicture}[scale=0.9]
\draw (-2,-0.5) -- (2,0.5) node[right] {$U$};
\draw (-2,0) -- (2,0) node[right] {$W_1$};
\draw[dashed] (-1.5,-0.9) -- (1.5,0.9) node[right] {$W_2$};
\fill (0,0) circle (1.5pt) node[below] {$0$};
\end{tikzpicture}}
