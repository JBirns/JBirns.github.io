\title{Volume form?}
\taxon{Remark}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{In #{\mathbb{R}^3}: #{\mathbb{R}^3 \times \mathbb{R}^3 \times \mathbb{R}^3 \to \mathbb{R}}, #{(a, b, c) \mapsto (a \wedge b) \cdot c}, where}

##{a \wedge b = \begin{pmatrix} a_1 \\ a_2 \\ a_3 \end{pmatrix} \wedge \begin{pmatrix} b_1 \\ b_2 \\ b_3 \end{pmatrix} = \begin{pmatrix} a_2b_3 - a_3b_2 \\ a_3b_1 - a_1b_3 \\ a_1b_2 - a_2b_1 \end{pmatrix}.}
