\title{Non-degenerate forms and isomorphisms to the dual}
\taxon{Corollary}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{When #{U} and #{V} are finite dimensional, choosing a non-degenerate bilinear form #{\phi \colon U \times V \to F} is equivalent to choosing an isomorphism #{\phi_L \colon U \to V^*}.}
