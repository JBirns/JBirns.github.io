\title{Quotient}
\taxon{Definition}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Let #{V} be an #{F}-vector space and #{U \leq V}. The \em{quotient space} #{V/U} is the abelian group #{V/U} equipped with the scalar multiplication}

##{F \times V/U \to V/U, \quad (\lambda, v + U) \mapsto \lambda v + U.
 \qquad (*)}
