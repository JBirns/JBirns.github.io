\title{A cofactor expansion}
\taxon{Example}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{A = \begin{pmatrix} 1 & 2 & -1 \\ 3 & -1 & 1 \\ 4 & 2 & -7 \end{pmatrix}}, with sign pattern #{\begin{pmatrix} + & - & + \\ - & + & - \\ + & - & + \end{pmatrix}}. Expanding along the 2nd column,}

##{\begin{aligned}
\det A &= -2\det\begin{pmatrix} 3 & 1 \\ 4 & -7 \end{pmatrix} - \det\begin{pmatrix} 1 & -1 \\ 4 & -7 \end{pmatrix} - 2\det\begin{pmatrix} 1 & -1 \\ 3 & 1 \end{pmatrix} \\
&= -2(-25) - (-3) - 2(4) = 45.
\end{aligned}}
