\title{Adjugate formula for the inverse}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{A \in M_n(F)}. Then}

##{(\operatorname{adj}A)A = \det(A)\,I.}

\p{In particular, if #{A} is invertible,}

##{A^{-1} = \frac{1}{\det A}\operatorname{adj}(A).}

\proof{
\p{We just proved}

##{\det A = \sum_{i=1}^n (-1)^{i+j}\big( \det A_{\hat{i}\hat{j}} \big)a_{ij} = \sum_{i=1}^n (\operatorname{adj}A)_{ji}a_{ij} = \big( (\operatorname{adj}A)A \big)_{jj}}

\p{by definition of #{\operatorname{adj}(A)}.}

\p{Off the diagonal: pick #{j \neq k}. Then (with #{A^{(k)}} in positions #{j} and #{k})}

##{\begin{aligned}
0 &= \det\big( A^{(1)}, \ldots, A^{(k)}, \ldots, A^{(k)}, \ldots, A^{(n)} \big) \\
&= \det\Big( A^{(1)}, \ldots, \sum_{i=1}^n a_{ik}e_i, \ldots, A^{(k)}, \ldots, A^{(n)} \Big) \\
&= \sum_{i=1}^n a_{ik}\det\big( A^{(1)}, \ldots, e_i, \ldots, A^{(k)}, \ldots, A^{(n)} \big) \\
&= \sum_{i=1}^n (\operatorname{adj}A)_{ji}a_{ik} = \big( (\operatorname{adj}A)A \big)_{jk}.
\end{aligned}}
}
