\import{macros}

\p{Let #{V} be a vector space over #{\mathbb{R}} (#{\mathbb{C}}). An inner product is a positive definite symmetric (Hermitian) form on #{V}, written #{\phi(u, v) = \langle u, v \rangle}.}

\ul{
\li{\em{Norm}: #{\Vert v\Vert  = \sqrt{\langle v, v \rangle}}, where #{\langle v, v \rangle \in \mathbb{R}_+} since #{\phi} is positive, and #{\Vert v\Vert  = 0 \iff v = 0} since #{\phi} is definite. #{\leadsto} The associated notion of length.}
}

