\title{Adjugate Matrix}
\date{2022-10-01}
\author{JB00}
\import{macros}

\p{Recall: for #{A \in M_n(F)}, #{A = \big( A^{(1)} \mid \cdots \mid A^{(n)} \big)}, we know the action of the determinant when swapping two vectors #{j}, #{k}:}

##{\det\big( A^{(1)}, \ldots, A^{(j)}, \ldots, A^{(k)}, \ldots, A^{(n)} \big) = -\det\big( A^{(1)}, \ldots, A^{(k)}, \ldots, A^{(j)}, \ldots, A^{(n)} \big)}

\p{since #{\det} is an alternate form.}

\ul{
\li{Using that #{\det A = \det(A^T)}, we can similarly prove that swapping two rows changes the determinant by a factor of #{(-1)}.}
}

\transclude{LA4Q}

\p{\strong{Column (row) expansion and the adjugate matrix}}

\p{Column expansion reduces the computation of #{n \times n} determinants to #{(n-1) \times (n-1)} determinants #{\leadsto} very useful to compute determinants.}

