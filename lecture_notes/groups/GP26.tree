\title{Examples of group actions}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

\ul{
\li{\strong{(i)} The trivial action: #{\rho(g, x) = x} for all #{x \in X}, #{g \in G}.}
\li{\strong{(ii)} #{S_n} acts on #{\lbrace 1, 2, \ldots, n\rbrace  = X} by permuting the elements of #{X}. E.g. #{S_3} acts on #{\lbrace 1, 2, 3\rbrace }: #{\sigma = (1\,2) \in S_3} has #{\sigma(1) = 2}, #{\sigma(2) = 1}, #{\sigma(3) = 3}. With #{\tau = (1\,3) \in S_3}, #{\tau\sigma = (1\,3)(1\,2) = (1\,2\,3)}, and #{(\tau\sigma)(1) = 2 = \tau(2) = \tau(\sigma(1))}. Similarly subgroups of #{S_n} act on #{X}.}
\li{\p{\strong{(iii)} #{D_8 = \lbrace e, r, r^2, r^3, t, rt, r^2t, r^3t\rbrace } acts on the edges of a square}
\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns}}{\begin{tikzpicture}[scale=0.8]
\draw (0,0) rectangle (1,1);
\node[above] at (0.5,1) {\small $a$}; \node[right] at (1,0.5) {\small $b$};
\node[below] at (0.5,0) {\small $c$}; \node[left] at (0,0.5) {\small $d$};
\begin{scope}[xshift=4cm]
\draw (0,0) rectangle (1,1);
\node[above left] at (0,1) {\small $1$}; \node[above right] at (1,1) {\small $2$};
\node[below right] at (1,0) {\small $3$}; \node[below left] at (0,0) {\small $4$};
\end{scope}
\end{tikzpicture}}
\p{with #{t(a) = c}, #{t(c) = a}, #{t(b) = b}, #{t(d) = d}, #{r(a) = b}. It also acts on the vertices of a square: #{t(1) = 4}, #{t(4) = 1}, #{t(2) = 3}, #{t(3) = 2}.}}
\li{\p{\strong{(iv)} #{G} acts on itself by left multiplication. This is called the \em{left regular action}:}
##{G \times G \to G, \quad (g, k) \mapsto gk.}
\p{Check: (0) #{gk \in G} (by closure); (i) #{\rho(gh, k) = ghk} and #{\rho(g, \rho(h, k)) = \rho(g, hk) = ghk} — or in shorthand #{(gh)k = ghk = g(hk)}; (ii) #{\rho(e, k) = ek = k}.}
\p{We also have the \em{right regular action} #{G \times G \to G}, #{(g, k) \mapsto kg^{-1}} (check!).}}
\li{\p{\strong{(v)} #{G} acts on itself by \em{conjugation}:}
##{G \times G \to G, \quad (g, k) \mapsto gkg^{-1}.}
\p{Check: (0) #{gkg^{-1} \in G} by closure; (i) #{\rho(gh, k) = ghk(gh)^{-1} = ghkh^{-1}g^{-1}} and #{\rho(g, \rho(h, k)) = \rho(g, hkh^{-1}) = ghkh^{-1}g^{-1}};}
\p{(ii) #{\rho(e, k) = eke^{-1} = k}.}}
\li{\strong{(vi)} Let #{N \trianglelefteq G}. Then #{G} acts on #{N} by conjugation: #{G \times N \to N}, #{(g, n) \mapsto gng^{-1}}. (0) #{gng^{-1} \in N} since #{N \trianglelefteq G}; (i) and (ii) as above.}
\li{\p{\strong{(vii)} Let #{H \leq G}. Then #{G} acts on the set of left cosets #{(G : H)} of #{H} in #{G}. This is called the \em{left coset action}:}
##{G \times (G : H) \to (G : H), \quad (g, kH) \mapsto gkH.}
\p{(0) #{gkH \in (G : H)} ✓; (i) #{\rho(gh, kH) = (gh)kH = ghkH} and #{\rho(g, \rho(h, kH)) = \rho(g, hkH) = ghkH} ✓; (ii) #{\rho(e, kH) = ekH = kH} ✓.}}
}
