\title{Conjugacy classes can split in #{A_n}}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{#{(1\,2\,3)} is not conjugate to #{(1\,3\,2)} in #{A_4}: if #{\tau(1\,2\,3)\tau^{-1} = (1\,3\,2)} then #{\tau = (1\,2)} or #{(3\,2)} or #{(1\,3) \in S_4 \setminus A_4}.}

\p{Or consider #{C_{A_4}((1\,2\,3)) = C_{S_4}((1\,2\,3)) \cap A_4}. #{C_{S_4}((1\,2\,3)) = \langle (1\,2\,3) \rangle \leq A_4}, so #{C_{A_4}((1\,2\,3)) = C_{S_4}((1\,2\,3))}, so by the Orbit–Stabiliser Theorem}

##{|\operatorname{ccl}_{A_4}((1\,2\,3))| = \frac{|A_4|}{|C_{A_4}((1\,2\,3))|} = \frac{|S_4|/2}{|C_{S_4}((1\,2\,3))|} = \frac{|\operatorname{ccl}_{S_4}((1\,2\,3))|}{2}.}

\p{So the conjugacy class of #{8} #{3}-cycles in #{S_4} splits into two conjugacy classes in #{A_4}.}
