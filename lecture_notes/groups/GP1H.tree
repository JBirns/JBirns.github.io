\p{Recall: if #{N \trianglelefteq G}, #{g \in G}, #{n \in N}, then #{gng^{-1} \in N}, so #{gng^{-1} = \hat{n}} for some #{\hat{n} \in N}, so #{gn = \hat{n}g}.}

