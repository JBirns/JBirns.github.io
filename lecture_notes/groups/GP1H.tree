\p{Recall #{\theta \colon G \to H} is a homomorphism if #{\theta(xy) = \theta(x)\theta(y)};}

##{\begin{aligned}
\operatorname{Im}(\theta) &= \lbrace \theta(g) : g \in G\rbrace  \leq H \quad \text{(1)}, \\
\ker(\theta) &= \lbrace g \in G : \theta(g) = e_H\rbrace  \trianglelefteq G \quad \text{(Example Sheet 1)}.
\end{aligned}}

