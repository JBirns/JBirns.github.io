\p{\strong{Aside.} Suppose #{f \colon A \to B}.}

\ul{
\li{\strong{(i)} #{f} is an \em{injective} map if for #{a_1, a_2 \in A}, #{f(a_1) = f(a_2) \implies a_1 = a_2}, i.e. each element of #{A} maps to a different element of #{B}.}
\li{\strong{(ii)} #{f} is \em{surjective} (onto) if given #{b \in B} there exists #{a \in A} s.t. #{f(a) = b} (every element in #{B} is “hit”).}
\li{\strong{(iii)} #{f} is \em{bijective} if #{f} is both injective and surjective.}
}

\transclude{GP1R}

