\title{Subgroups generated by elements}
\taxon{Remark}
\date{2021-10-01}
\author{JB00}
\import{macros}

\ul{
\li{\p{\strong{(i)} Suppose #{g \in G}. Then #{\lbrace g^n : n \in \mathbb{Z}\rbrace } is a subgroup of #{G}; in fact it is the smallest subgroup of #{G} containing #{g}. We call it the \em{subgroup of #{G} generated by #{g}} and write #{\langle g \rangle = \lbrace g^n : n \in \mathbb{Z}\rbrace }. Also #{|\langle g \rangle| = o(g)} if finite, since if #{o(g) = m},}
##{\langle g \rangle = \lbrace e, g, g^2, \ldots, g^{m-1}\rbrace  \qquad (g^{m-1} = g^{-1}).}
\p{Otherwise both are infinite.}}
\li{\strong{(ii)} We can define the abstract cyclic group of order #{n}, #{C_n = \langle x \rangle}, #{o(x) = n}. Then #{(\lbrace 0, 1, \ldots, n-1\rbrace , +_n)} and #{(\lbrace n\text{th roots of unity}\rbrace , \times)} are realisations of this group; they are all isomorphic.}
\li{\strong{(iii)} Let #{G} be a group and #{g_1, \ldots, g_k \in G}. Then the subgroup of #{G} generated by #{g_1, \ldots, g_k}, denoted #{\langle g_1, \ldots, g_k \rangle}, is the smallest subgroup of #{G} containing all the #{g_i}’s. It is the intersection of all the subgroups of #{G} that contain all the #{g_i}’s.}
}
