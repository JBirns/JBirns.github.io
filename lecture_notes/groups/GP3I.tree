\title{Möbius Groups}
\date{2021-10-01}
\author{JB00}
\import{macros}

\transclude{GP3J}

\p{Why #{ad - bc \neq 0}?}

##{f(z) - f(w) = \frac{(ad - bc)(z - w)}{(cz + d)(cw + d)}.}

\p{So #{ad - bc = 0 \Rightarrow f} constant (not interesting), and #{ad - bc \neq 0 \Rightarrow f} injective.}

\p{When does #{f(z) = g(z)}? Suppose there exist #{\geq 3} values of #{z} in #{\mathbb{C}} s.t.}

##{\frac{az + b}{cz + d} = \frac{\alpha z + \beta}{\gamma z + \delta}, \qquad ad - bc \neq 0,\; \alpha\delta - \beta\gamma \neq 0.}

\p{Then there exists #{\lambda \in \mathbb{C}}, #{\lambda \neq 0}, s.t. #{\begin{pmatrix} \alpha & \beta \\ \gamma & \delta \end{pmatrix} = \lambda\begin{pmatrix} a & b \\ c & d \end{pmatrix}}.}

\p{Indeed, we have #{3} distinct values of #{z} for which #{(az + b)(\gamma z + \delta) = (\alpha z + \beta)(cz + d)}. So these quadratics are identical (since each has only #{2} roots, but they agree for #{3} values). So}

##{a\gamma = \alpha c, \quad b\delta = \beta d, \quad a\delta + b\gamma = \alpha d + \beta c.}

\p{Let #{\mu = a\delta - b\gamma = \alpha d - \beta c}. So #{\mu^2 = (ad - bc)(\alpha\delta - \beta\gamma) \neq 0}. Then}

##{\begin{pmatrix} d & -b \\ -c & a \end{pmatrix}\begin{pmatrix} \alpha & \beta \\ \gamma & \delta \end{pmatrix} = \begin{pmatrix} \mu & 0 \\ 0 & \mu \end{pmatrix} \implies \begin{pmatrix} \alpha & \beta \\ \gamma & \delta \end{pmatrix} = \frac{\mu}{ad - bc}\begin{pmatrix} a & b \\ c & d \end{pmatrix}.}

\p{\em{Problem:} #{f} is not defined at #{z = -\frac{d}{c}}. We would like #{f(-\frac{d}{c}) = \infty}, so we consider #{f} defined on #{\mathbb{C} \cup \lbrace \infty\rbrace  = \mathbb{C}_\infty}, the \em{extended complex plane}. So if #{f(z) = \frac{az + b}{cz + d}}, the domain is now #{\mathbb{C}_\infty}, and}

##{c \neq 0:\; f(\infty) = \frac{a}{c},\; f\big(-\tfrac{d}{c}\big) = \infty; \qquad c = 0:\; f(\infty) = \infty.}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns}}{\begin{tikzpicture}[scale=1.1]
\draw (-2.6,-0.9) -- (2,-0.9) -- (3,0.4) -- (-1.6,0.4) -- cycle;
\node at (-1.9,-0.65) {$\mathbb{C}$};
\draw (0,0) circle (0.9);
\draw[dashed] (-0.9,0) arc (180:360:0.9 and 0.25);
\draw (-0.9,0) arc (180:0:0.9 and 0.25);
\node at (0,-0.5) {\scriptsize unit sphere};
\fill (0,0.9) circle (1.2pt); \node[above] at (0,0.9) {$\infty$};
\fill (2.2,-0.2) circle (1.2pt); \node[right] at (2.2,-0.2) {$z$};
\draw[dashed] (0,0.9) -- (2.2,-0.2);
\node[right, align=left] at (3.1,0.5) {\small Riemann sphere and\\ \small stereographic projection};
\end{tikzpicture}}

\transclude{GP3K}

