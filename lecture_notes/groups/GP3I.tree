\transclude{GP3P}

\p{So the image of #{3} points determines the map.}

\p{\strong{Conjugacy classes in #{\mathcal{M}}}}

\p{Recall #{\Phi \colon GL_2(\mathbb{C}) \to \mathcal{M}} is a surjective homomorphism. Suppose #{A} and #{B} are conjugate in #{GL_2(\mathbb{C})}, i.e. there exists #{P \in GL_2(\mathbb{C})} s.t. #{PAP^{-1} = B}. Then}

##{\Phi(P)\Phi(A)\Phi(P^{-1}) = \Phi(PAP^{-1}) = \Phi(B) \in \mathcal{M},}

\p{i.e. #{\Phi(A)} and #{\Phi(B)} are conjugate in #{\mathcal{M}}. Use our knowledge of conjugacy classes in #{GL_2(\mathbb{C})} (\ref{GP3C}):}

\ul{
\li{\strong{(i)} #{\begin{pmatrix} \lambda & 0 \\ 0 & \mu \end{pmatrix}}, #{\lambda \neq \mu}, #{\lambda \neq 0 \neq \mu}: #{\Phi\left(\begin{pmatrix} \lambda & 0 \\ 0 & \mu \end{pmatrix}\right) = f}, #{f(z) = \nu z} with #{\nu = \lambda /\mu \neq 0, 1}.}
\li{\strong{(ii)} #{\begin{pmatrix} \lambda & 0 \\ 0 & \lambda \end{pmatrix}}, #{\lambda \neq 0}: #{\Phi\left(\begin{pmatrix} \lambda & 0 \\ 0 & \lambda \end{pmatrix}\right) = \mathrm{id}}.}
\li{\p{\strong{(iii)} #{\begin{pmatrix} \lambda & 1 \\ 0 & \lambda \end{pmatrix}}, #{\lambda \neq 0}: #{\Phi\left(\begin{pmatrix} \lambda & 1 \\ 0 & \lambda \end{pmatrix}\right) = f}, #{f(z) = \frac{\lambda z + 1}{\lambda} = z + \frac{1}{\lambda}}, i.e. #{f = \Phi\left(\begin{pmatrix} 1 & \frac{1}{\lambda} \\ 0 & 1 \end{pmatrix}\right)}. And #{\begin{pmatrix} 1 & \frac{1}{\lambda} \\ 0 & 1 \end{pmatrix}} is conjugate to #{\begin{pmatrix} 1 & 1 \\ 0 & 1 \end{pmatrix}} via}
##{\begin{pmatrix} \lambda & 0 \\ 0 & 1 \end{pmatrix}\begin{pmatrix} 1 & \frac{1}{\lambda} \\ 0 & 1 \end{pmatrix}\begin{pmatrix} \frac{1}{\lambda} & 0 \\ 0 & 1 \end{pmatrix} = \begin{pmatrix} 1 & 1 \\ 0 & 1 \end{pmatrix}.}
\p{So #{f} is conjugate to #{g} where #{g(z) = z + 1}.}}
}

\transclude{GP3Q}

\transclude{GP3R}

\p{\strong{Circles in #{\mathbb{C}_\infty}}}

\p{A \em{Euclidean circle} is the set of points in #{\mathbb{C}} given by some equation #{|z - z_0| = r}, #{r > 0}. A \em{Euclidean line} is the set of points in #{\mathbb{C}} given by some equation #{|z - a| = |z - b|}.}

\p{A \em{circle in #{\mathbb{C}_\infty}} is either a Euclidean circle or a set #{L \cup \lbrace \infty\rbrace } where #{L} is a Euclidean line. Its general equation is of the form}

##{Az\bar{z} + \bar{B}z + B\bar{z} + C = 0, \qquad A, C \in \mathbb{R},\; |B|^2 > AC,
 \qquad (*)}

\p{where #{z = \infty} is a solution #{\iff A = 0}. (#{A = 0 \Rightarrow} line; #{C = 0 \Rightarrow} through the origin.)}

\p{There is a unique circle passing through any #{3} distinct points in #{\mathbb{C}_\infty}.}

\transclude{GP3S}

\transclude{GP3T}

\p{\strong{Cross-ratios}}

\transclude{GP3U}

\p{Note #{[0, 1, w, \infty] = w}.}

\p{\strong{Warning:} different authors use different permutations of #{1, 2, 3, 4} as the definition.}

\transclude{GP3V}

\p{So #{[z_1, z_2, z_3, z_4] = g(z_3)} where #{g} is the unique Möbius map that sends #{z_1 \mapsto 0}, #{z_2 \mapsto 1}, #{z_4 \mapsto \infty}. (One can define the cross-ratio like this.)}

\transclude{GP3W}
