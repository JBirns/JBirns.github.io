##{\begin{aligned}
A_4 = \lbrace &e, (1\,2)(3\,4), (1\,3)(2\,4), (1\,4)(2\,3), \\
&(1\,2\,3), (1\,3\,2), (1\,2\,4), (1\,4\,2), (1\,3\,4), (1\,4\,3), (2\,3\,4), (2\,4\,3)\rbrace .
\end{aligned}}

\p{E.g. #{(1\,4\,2) = (1\,4)(1\,2)}.}
