\title{Permutations are products of transpositions}
\taxon{Proposition}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Any #{\sigma \in S_n} (#{n \geq 2}) can be written as a product of transpositions.}

\proof{
\p{By \ref{GP0T} it is enough to show a #{k}-cycle can be written as a product of transpositions:}

##{(a_1, a_2, a_3, \ldots, a_k) = (a_1\, a_2)(a_2\, a_3)\cdots(a_{k-1}\, a_k).}

\p{E.g.}

##{\begin{aligned}
(1\,2\,3\,4\,5) &= (1\,2)(2\,3)(3\,4)(4\,5) \\
&= (1\,2)(1\,2)(1\,2)(2\,3)(3\,4)(4\,5) \\
&= (1\,5)(1\,4)(1\,3)(1\,2),
\end{aligned}}

\p{so the expression is not unique.}
}
