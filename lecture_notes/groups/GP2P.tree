\title{Cauchy's Theorem}
\taxon{Theorem}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Let #{G} be a finite group and #{p} a prime that divides #{|G|}. Then there exists an element in #{G} of order #{p}.}

\proof{
\p{Let}

##{X = \lbrace (x_1, x_2, \ldots, x_p) : x_1x_2\cdots x_p = e,\; x_i \in G\rbrace .}

\p{Let #{H = \langle h \mid h^p = e \rangle \cong C_p} act on #{X} as follows:}

##{H \times X \to X, \quad (h, (x_1, \ldots, x_p)) \mapsto (x_2, x_3, \ldots, x_p, x_1);}

\p{in general #{(h^i, (x_1, \ldots, x_p)) \mapsto (x_{1+i}, x_{2+i}, \ldots, x_{p+i})}, with suffices taken modulo #{p}.}

\p{Check this is a group action:}

\ul{
\li{\p{\strong{(i)} if #{x_1x_2\cdots x_p = e} then}
##{\begin{aligned}
x_{1+i}x_{2+i}\cdots x_{p+i} &= (x_1x_2\cdots x_i)^{-1}x_1x_2\cdots x_p(x_1x_2\cdots x_i) \\ &= (x_1\cdots x_i)^{-1}e(x_1\cdots x_i) = e;
\end{aligned}}}
\li{\strong{(ii)} #{h^{i+j}(x_1, \ldots, x_p) = (x_{i+j+1}, \ldots, x_{i+j+p}) = h^i(h^j(x_1, \ldots, x_p))};}
\li{\strong{(iii)} #{e(x_1, \ldots, x_p) = h^p(x_1, \ldots, x_p) = (x_1, \ldots, x_p)}.}
}

\p{So this is a group action.}

\p{Let #{\bar{x} = (x_1, x_2, \ldots, x_p) \in X}. As the distinct orbits partition #{X} (\ref{GP2H}),}

##{\sum_{\text{distinct orbits}} |\operatorname{Orb}_H(\bar{x})| = |X|.
 \qquad (\dagger)}

\p{Note #{|X| = |G|^{p-1}} (choose #{x_1, \ldots, x_{p-1}}; then #{x_p} is determined), so #{p \mid |X|}, so #{p} divides the LHS. But by the Orbit–Stabiliser Theorem #{|\operatorname{Orb}_H(\bar{x})|} divides #{|H| = p}, so #{|\operatorname{Orb}_H(\bar{x})| = 1} or #{p}.}

\p{Now #{\bar{e} = (e, e, \ldots, e) \in X} and #{|\operatorname{Orb}_H(\bar{e})| = 1}. So there exist at least #{p - 1} other orbits of length #{1} by (#{\dagger}). So there exists #{\bar{x} \in X}, #{\bar{x} \neq \bar{e}}, with #{|\operatorname{Orb}_H(\bar{x})| = 1}, so #{\bar{x} = (x, x, \ldots, x)} with #{x \neq e} and #{x^p = e}.}
}
