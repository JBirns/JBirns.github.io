\p{\strong{Notation:}}

##{\begin{array}{llll}
\forall & \text{for all} & \text{s.t.} & \text{such that} \\
\exists & \text{there exists} & \therefore & \text{therefore} \\
\Rightarrow & \text{implies} & \text{↯} & \text{contradiction}
\end{array}}

\p{A \em{binary operation} #{*} on a set #{X} is a way of combining #{2} elements of #{X} to unambiguously give another element of #{X}, i.e. #{* \colon X \times X \to X}.}

