\p{\strong{Aside.} We need the notion of functions [see Numbers & Sets, IA].}

\p{#{f} is a \em{function} between sets #{A} and #{B} if it assigns each element of #{A} a unique element of #{B}:}

##{f \colon A \to B, \quad a \mapsto f(a).}

\p{E.g. #{f \colon \mathbb{Z} \to \mathbb{Z}}, #{x \mapsto x + 1}; #{g \colon \mathbb{Z} \to \mathbb{Z}}, #{x \mapsto 2x}.}

\p{\em{Composition of functions:} suppose #{g \colon A \to B} and #{f \colon B \to C}. Define}

##{f \circ g \colon A \to C, \quad a \mapsto (f \circ g)(a) = f(g(a)).}

\p{E.g. #{(f \circ g)(x) = 2x + 1}, #{(g \circ f)(x) = 2x + 2}.}

\p{Suppose #{f_1 \colon A \to B}, #{f_2 \colon A \to B}. Then #{f_1 = f_2} if #{f_1(a) = f_2(a)} for all #{a \in A}.}

\p{#{f \colon A \to B} is a \em{bijection} if it defines a pairing between elements of #{A} and elements of #{B}. That is, given #{b \in B} there exists a unique #{a \in A} s.t. #{f(a) = b}.}

\p{E.g. #{f \colon \mathbb{Z} \to \mathbb{Z}}, #{x \mapsto x + 1}. In this case we can define #{f^{-1} \colon B \to A}, #{b \mapsto a} where #{f(a) = b}. Then}

##{f \circ f^{-1} = \mathrm{id}_B, \qquad f^{-1} \circ f = \mathrm{id}_A, \qquad \text{where } \mathrm{id}_B(b) = b.}

