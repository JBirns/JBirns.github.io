\p{\strong{Euler’s totient function.} Let #{n \in \mathbb{N}}. #{\phi(n) = |\lbrace 1 \leq a \leq n : \operatorname{hcf}(a, n) = 1\rbrace |}. So #{\phi(12) = |\lbrace 1, 5, 7, 11\rbrace | = 4}.}

\transclude{GP1G}

\p{Fermat’s Little Theorem is a special case: #{p} prime, #{a \in \mathbb{Z}}, #{\operatorname{hcf}(a, p) = 1}. Then #{a^{p-1} \equiv 1 \pmod p}.}
