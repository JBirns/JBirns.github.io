\title{Remarks on orbits}
\taxon{Remark}
\date{2021-10-01}
\author{JB00}
\import{macros}

\ul{
\li{\strong{(i)} We could have proved \ref{GP2H} by noting that #{x_1 \sim x_2} if there exists #{g \in G} s.t. #{g(x_1) = x_2} is an equivalence relation [see Numbers & Sets].}
\li{\strong{(ii)} #{\operatorname{Orb}_G(x)} is #{G}-invariant, i.e. #{g(\operatorname{Orb}_G(x)) \subseteq \operatorname{Orb}_G(x)}, since if #{y \in \operatorname{Orb}_G(x)}, #{y = h(x)} for some #{h \in G}, so #{g(y) = g(h(x)) = (gh)(x) \in \operatorname{Orb}_G(x)}.}
\li{\strong{(iii)} #{G} is transitive on #{\operatorname{Orb}_G(x)}: let #{y, z \in \operatorname{Orb}_G(x)}, so #{y = g(x)}, #{z = h(x)} for some #{g, h \in G}. Then #{z = h(g^{-1}(y))}.}
}
