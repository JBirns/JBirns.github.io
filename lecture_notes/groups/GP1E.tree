\title{The order of an element divides the order of the group}
\taxon{Corollary}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{G} be a finite group, #{g \in G}. Then #{o(g) \mid |G|}. In particular #{g^{|G|} = e}.}

\proof{
\p{Note #{\langle g \rangle = \lbrace e, g, \ldots, g^{n-1}\rbrace } where #{o(g) = n}. Then #{o(g) = |\langle g \rangle| \mid |G|} by Lagrange, so #{g^{|G|} = e} (\ref{GP0N}).}
}
