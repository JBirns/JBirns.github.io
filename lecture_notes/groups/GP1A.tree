\title{Lagrange's Theorem}
\taxon{Theorem}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{Let #{H} be a subgroup of the finite group #{G}. Then the order of #{H} divides the order of #{G}, i.e. #{|H| \mid |G|}.}

\proof{
\p{By \ref{GP17}, #{G} is partitioned into distinct cosets of #{H}, say #{G = g_1H \sqcup g_2H \sqcup \cdots \sqcup g_kH} (#{g_1 = e}, say). By \ref{GP16}, #{|g_iH| = |H|} for #{1 \leq i \leq k}, so #{|G| = |H|k}.}
}
