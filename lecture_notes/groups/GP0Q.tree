    \node[below right] at (1,0) {\scriptsize 1};
    \node[below left] at (0,0) {\scriptsize 2};
    \node at (0.5,-0.55) {$r^2$};
  \end{scope}
  \begin{scope}[shift={(6.6,0)}]
    \draw (0,0) rectangle (1,1);
