\title{Cross-ratio}
\taxon{Definition}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{The \em{cross-ratio} of distinct points #{z_1, z_2, z_3, z_4 \in \mathbb{C}} is}

##{[z_1, z_2, z_3, z_4] = \frac{(z_1 - z_3)(z_2 - z_4)}{(z_1 - z_2)(z_3 - z_4)},}

\p{with}

##{\begin{aligned}
[\infty, z_2, z_3, z_4] &= \frac{z_2 - z_4}{z_3 - z_4}, & [z_1, \infty, z_3, z_4] &= -\frac{z_1 - z_3}{z_3 - z_4}, \\
[z_1, z_2, z_3, \infty] &= \frac{z_1 - z_3}{z_1 - z_2}, & [z_1, z_2, \infty, z_4] &= -\frac{z_2 - z_4}{z_1 - z_2}.
\end{aligned}}
