\title{Conjugacy classes of #{S_5} and #{A_5}}
\taxon{Example}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{#{S_5}, #{|S_5| = 120}:}

##{\begin{array}{cccccc}
x & \text{cycle type} & \# & \operatorname{sgn} & |C_{S_5}(x)| & C_{S_5}(x) \\ \hline
e & (1,1,1,1,1) & 1 & 1 & 120 & S_5 \\
(1\,2) & (2,1,1,1) & 10 & -1 & 12 & C_2 \times S_3 \\
(1\,2)(3\,4) & (2,2,1) & 15 & 1 & 8 & \langle (1\,3\,2\,4), (1\,2) \rangle \cong D_8 \\
(1\,2\,3) & (3,1,1) & 20 & 1 & 6 & \langle (1\,2\,3), (4\,5) \rangle \cong C_6 \\
(1\,2\,3)(4\,5) & (3,2) & 20 & -1 & 6 & \langle (1\,2\,3), (4\,5) \rangle \cong C_6 \\
(1\,2\,3\,4) & (4,1) & 30 & -1 & 4 & \langle (1\,2\,3\,4) \rangle \\
(1\,2\,3\,4\,5) & (5) & 24 & 1 & 5 & \langle (1\,2\,3\,4\,5) \rangle
\end{array}}

\p{Now consider #{A_5}, #{|A_5| = 60}:}

##{\begin{array}{cccc}
x & \text{cycle type} & C_{A_5}(x) & |\operatorname{ccl}_{A_5}(x)| \\ \hline
e & (1,1,1,1,1) & A_5 & 1 \\
(1\,2)(3\,4) & (2,2,1) & \langle (1\,2)(3\,4), (1\,3)(2\,4) \rangle & 15 \\
(1\,2\,3) & (3,1,1) & \langle (1\,2\,3) \rangle & 20 \\
(1\,2\,3\,4\,5) & (5) & \langle (1\,2\,3\,4\,5) \rangle & 12 \\
(2\,1\,3\,4\,5) & (5) & \langle (2\,1\,3\,4\,5) \rangle & 12
\end{array}}

\p{The classes of #{(1\,2)(3\,4)} and #{(1\,2\,3)} stay the same size (since #{C_{A_5}} halves); the class of #{5}-cycles halves (since #{C_{A_5}} stays the same), splitting into two classes of size #{12}.}
