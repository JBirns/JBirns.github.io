\title{#{O_3(\mathbb{R})} is generated by reflections}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Any element of #{O_3(\mathbb{R})} is a product of at most #{3} reflections.}

\proof{
\p{Let #{\lbrace \mathbf{e}_1, \mathbf{e}_2, \mathbf{e}_3\rbrace } be the standard orthonormal basis for #{\mathbb{R}^3} and let #{A \in O_3(\mathbb{R})}. #{|A\mathbf{e}_3| = |\mathbf{e}_3| = 1} since #{A} is an isometry, so there exists a reflection #{r_1} s.t. #{r_1A(\mathbf{e}_3) = \mathbf{e}_3}. Let #{\Pi = \langle \mathbf{e}_1, \mathbf{e}_2 \rangle \perp \mathbf{e}_3}; so #{r_1A(\Pi) = \Pi}.}

\p{There exists a reflection #{r_2} s.t. #{r_2(\mathbf{e}_3) = \mathbf{e}_3} and #{r_2(r_1A(\mathbf{e}_2)) = \mathbf{e}_2}. So #{r_2r_1A} fixes #{\mathbf{e}_2} and #{\mathbf{e}_3}. So #{r_2r_1A(\mathbf{e}_1) = \pm\mathbf{e}_1}, since angles are preserved, so it is still #{\perp}.}

\p{If #{r_2r_1A(\mathbf{e}_1) = \mathbf{e}_1}, let #{r_3 = \mathrm{id}}. If #{r_2r_1A(\mathbf{e}_1) = -\mathbf{e}_1}, let #{r_3} be the reflection in the plane #{\perp} to #{\mathbf{e}_1}. So #{r_3r_2r_1A} fixes #{\mathbf{e}_1, \mathbf{e}_2, \mathbf{e}_3}, so #{r_3r_2r_1A = \mathrm{id}}, so}

##{A = r_1^{-1}r_2^{-1}r_3^{-1} = r_1r_2r_3.}
}
