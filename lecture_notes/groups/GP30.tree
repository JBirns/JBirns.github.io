\p{#{A_4}:}

##{\begin{array}{cccc}
\text{example member} & \text{cycle type} & C_{A_4}(x) & |\operatorname{ccl}_{A_4}(x)| \\ \hline
e & (1,1,1,1) & A_4 & 1 \\
(1\,2\,3) & (3,1) & \langle (1\,2\,3) \rangle & 4 \\
(1\,3\,2) & (3,1) & \langle (1\,3\,2) \rangle & 4 \\
(1\,2)(3\,4) & (2,2) & V_4 \cong C_2 \times C_2 & 3
\end{array}}

\p{where #{V_4 = \lbrace e, (1\,2)(3\,4), (1\,3)(2\,4), (1\,4)(2\,3)\rbrace }.}
