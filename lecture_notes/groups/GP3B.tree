\title{Conjugate matrices}
\taxon{Remark}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Matrices #{A} and #{B} are conjugate if they represent the same linear map, i.e. if #{PAP^{-1} = B} then #{P} represents a change of basis matrix (see IB Linear Algebra). E.g. with #{\mathbf{e}_1 = \begin{pmatrix} 1 \\ 0 \end{pmatrix}}, #{\mathbf{e}_2 = \begin{pmatrix} 0 \\ 1 \end{pmatrix}} the standard basis, let}

##{A \colon \mathbf{e}_1 \mapsto 2\mathbf{e}_1,\; \mathbf{e}_2 \mapsto 3\mathbf{e}_2, \qquad A = \begin{pmatrix} 2 & 0 \\ 0 & 3 \end{pmatrix}.}

\p{Let #{P \colon \mathbf{e}_1 \mapsto \mathbf{e}_2}, #{\mathbf{e}_2 \mapsto \mathbf{e}_1}, the change of basis #{P = \begin{pmatrix} 0 & 1 \\ 1 & 0 \end{pmatrix} = P^{-1}}. Then}

##{PAP^{-1} = \begin{pmatrix} 0 & 1 \\ 1 & 0 \end{pmatrix}\begin{pmatrix} 2 & 0 \\ 0 & 3 \end{pmatrix}\begin{pmatrix} 0 & 1 \\ 1 & 0 \end{pmatrix} = \begin{pmatrix} 0 & 3 \\ 2 & 0 \end{pmatrix}\begin{pmatrix} 0 & 1 \\ 1 & 0 \end{pmatrix} = \begin{pmatrix} 3 & 0 \\ 0 & 2 \end{pmatrix},}

\p{i.e. #{\mathbf{e}_1 \mapsto 3\mathbf{e}_1}, #{\mathbf{e}_2 \mapsto 2\mathbf{e}_2}: the same map written in the swapped basis.}
