\title{The Dihedral and Symmetric Groups}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{First note composition of functions is associative. Let #{f, g, h \colon X \to X} and #{x \in X}. Then}

##{\begin{aligned}
(f \circ (g \circ h))(x) &= f((g \circ h)(x)) \\
&= f(g(h(x))) \\
&= ((f \circ g) \circ h)(x),
\end{aligned}}

\p{so #{f \circ (g \circ h) = (f \circ g) \circ h}.}

\p{\strong{Dihedral groups}}

\p{Let #{P} be a regular polygon with #{n} sides and #{V} its set of vertices. We can assume #{V = \lbrace e^{2\pi ik/n} : 0 \leq k < n\rbrace }, the #{n}th roots of unity in #{\mathbb{C}}. Then the symmetries of #{P} are the isometries (i.e. distance preserving maps of #{\mathbb{C}}) that map #{V} to #{V}.}

\p{We will show that for #{n \geq 3} the set of symmetries of #{P}, under composition, forms a nonabelian group of order #{2n}. This group is called the \em{dihedral group} of order #{2n}, denoted #{D_{2n}}. (Warning — sometimes #{D_{2n}} is denoted #{D_n}.) We have already met #{D_6} — \ref{GP04}(10).}

\transclude{GP0Q}

\p{Let}

##{r \colon P \to P,\; z \mapsto e^{2\pi i/n}z, \qquad t \colon P \to P,\; z \mapsto \bar{z}.}

\p{These are both isometries:}

##{\begin{aligned}
|r(z) - r(w)| &= |e^{2\pi i/n}z - e^{2\pi i/n}w| = |e^{2\pi i/n}|\,|z - w| = |z - w|, \\
|t(z) - t(w)|^2 &= |\bar{z} - \bar{w}|^2 = (\bar{z} - \bar{w})(z - w) = |z - w|^2 \implies |t(z) - t(w)| = |z - w|.
\end{aligned}}

\p{Note #{r^n = \mathrm{id}}, #{r^{-1} = r^{n-1}}, and #{t^2 = \mathrm{id} \implies t = t^{-1}}. Also}

##{tr(z) = e^{-2\pi i/n}\bar{z} = r^{-1}t(z) \implies tr = r^{-1}t.}

\p{We show that the set of symmetries of #{P} is precisely}

##{\lbrace \underbrace{e, r, r^2, \ldots, r^{n-1}}_{\text{rotations}}, \underbrace{t, rt, \ldots, r^{n-1}t}_{\text{reflections}}\rbrace .}

\p{Then this set under composition of functions gives the group #{D_{2n}}.}

\p{Let #{f} be a symmetry of #{P}. Then #{f(1) = e^{2\pi ik/n}} for some #{k}, so #{g = r^{-k} \circ f} is a symmetry of #{P} fixing #{1} (“loses the corner”). Then #{g(e^{2\pi i/n}) = e^{2\pi i/n}} or #{e^{-2\pi i/n}}, since the distance from #{1} is preserved. Also #{g} interchanges vertices of #{P} so fixes #{P}’s centre of mass #{\frac{1}{n}\sum_{k=0}^{n-1} e^{2\pi ik/n} = 0}.}

\p{If #{g(e^{2\pi i/n}) = e^{2\pi i/n}} then #{g} fixes #{0}, #{1} and #{e^{2\pi i/n}}, so #{g = \mathrm{id}}, so #{f = r^k}.}

\p{If #{g(e^{2\pi i/n}) = e^{-2\pi i/n}} then #{t \circ g(e^{2\pi i/n}) = e^{2\pi i/n}}, #{t \circ g(1) = 1}, #{t \circ g(0) = 0}, so #{t \circ g = \mathrm{id}}, i.e. #{t \circ r^{-k} \circ f = \mathrm{id}}, so #{f = r^k \circ t^{-1} = r^k \circ t}.}

\p{Algebraically we write}

##{D_{2n} = \langle \underbrace{r, t}_{\text{generators}} \mid \underbrace{r^n = e,\; t^2 = e,\; trt = r^{-1}}_{\text{relations}} \rangle.}

\p{Finally, #{D_2 \cong C_2} (the cyclic group of order #{2}) and #{D_4} is \ref{GP04}(9); both are abelian. Also #{D_\infty} exists.}

\p{\strong{Aside: subgroup lattice.} #{D_6 = \lbrace e, r, r^2, t, rt, r^2t\rbrace }:}

\tex{\usepackage{amsmath,amssymb}\usepackage{tikz}\usetikzlibrary{patterns}}{\begin{tikzpicture}[every node/.style={inner sep=2pt}]
\node (G) at (0,3.2) {$D_6$};
\node (r) at (-3.2,1.8) {$\langle r \rangle = \{e, r, r^2\}$};
\node (t) at (-0.6,0.8) {$\langle t \rangle$};
\node (rt) at (1.4,0.8) {$\langle rt \rangle$};
\node (r2t) at (3.4,0.8) {$\langle r^2t \rangle$};
\node (e) at (0,-0.6) {$\{e\}$};
\draw (G) -- node[above left] {\scriptsize 2} (r);
\draw (G) -- node[left] {\scriptsize 3} (t);
\draw (G) -- node[right] {\scriptsize 3} (rt);
\draw (G) -- node[above right] {\scriptsize 3} (r2t);
\draw (r) -- node[below left] {\scriptsize 3} (e);
\draw (t) -- node[left] {\scriptsize 2} (e);
\draw (rt) -- node[right] {\scriptsize 2} (e);
\draw (r2t) -- node[below right] {\scriptsize 2} (e);
\node[right, align=left, font=\small] at (4.6,3.2) {order $6$};
\node[right, font=\small] at (4.6,1.8) {order $3$};
\node[right, font=\small] at (4.6,0.8) {order $2$};
\node[right, font=\small] at (4.6,-0.6) {order $1$};
\end{tikzpicture}}

\p{These are all the subgroups of #{D_6}: by Lagrange a proper non-trivial subgroup has order #{2} or #{3}; the order-#{2} subgroups are generated by the three reflections, and the only element of order #{3} (with its inverse) generates #{\langle r \rangle}. Edge labels are indices.}

\p{\strong{Symmetric groups}}

\p{Let #{X} be a set. A bijection #{f \colon X \to X} is called a \em{permutation} of #{X}. Let #{\mathrm{Sym}(X)} denote the set of all permutations of #{X}.}

