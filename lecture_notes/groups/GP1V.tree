\title{Direct Products and Small Groups}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{\strong{Direct products}}

\p{Let #{H} and #{K} be groups. We construct the (external) \em{direct product}, #{H \times K}, as follows:}

\ul{
\li{elements: #{(h, k)}, #{h \in H}, #{k \in K};}
\li{operation: #{(h_1, k_1) * (h_2, k_2) = (h_1 *_H h_2, k_1 *_K k_2) = (h_1h_2, k_1k_2)}, i.e. componentwise multiplication.}
}

\p{Then #{(H \times K, *)} is a group:}

\ul{
\li{closure: #{H} a group #{\Rightarrow h_1h_2 \in H}; #{K} a group #{\Rightarrow k_1k_2 \in K};}
\li{identity: #{(e_H, e_K)};}
\li{inverse: #{(h, k)^{-1} = (h^{-1}, k^{-1})};}
\li{associativity: since the group operations in both #{H} and #{K} are associative.}
}

\transclude{GP1W}

\transclude{GP1X}

\transclude{GP1Y}

\p{Thus we know when #{C_m \times C_n \cong C_{mn}} (Sheet 2, Q10).}

\p{Recognising when a group can be written as a direct product of subgroups is trickier.}

\transclude{GP1Z}

\transclude{GP20}

\transclude{GP21}

\p{\strong{Small groups}}

\p{Recall #{D_{2n}}, the symmetries of a regular #{n}-gon, generated by #{r \colon z \mapsto e^{2\pi i/n}z}, #{t \colon z \mapsto \bar{z}}. The elements of #{D_{2n}} are #{\lbrace e, r, \ldots, r^{n-1}, t, rt, \ldots, r^{n-1}t\rbrace }.}

\transclude{GP22}

\p{\strong{Groups of small order.}}

\ul{
\li{#{|G| = 1}: #{G = \lbrace e\rbrace }.}
\li{#{|G| = 2}: #{G \cong C_2} by Lagrange (\ref{GP1F}).}
\li{#{|G| = 3}: #{G \cong C_3}, similarly.}
\li{\p{#{|G| = 4}: by Lagrange, if #{1 \neq g \in G} then #{o(g) \mid 4}. If there exists #{g \in G} with #{o(g) = 4} then #{G \cong C_4}.}
\p{Suppose not. Let #{1 \neq a \in G}; then #{o(a) = 2}. So #{G} is abelian (Sheet 1, Q7), so #{C_2 \cong \langle a \rangle \trianglelefteq G}. Let #{b \in G \setminus \langle a \rangle}. Then #{C_2 \cong \langle b \rangle \trianglelefteq G}. Also #{\langle a \rangle \cap \langle b \rangle = \lbrace e\rbrace }. Consider #{ab}:}
\ul{
\li{if #{ab = e} then #{a = b^{-1} = b} ↯;}
\li{if #{ab = a} then #{b = e} ↯;}
\li{if #{ab = b} then #{a = e} ↯.}
}
\p{So #{G = \lbrace e, a, b, ab\rbrace  = \langle a \rangle\langle b \rangle \cong \langle a \rangle \times \langle b \rangle \cong C_2 \times C_2}.}
\p{So there are two groups of order #{4}: #{C_4} and #{C_2 \times C_2}, both abelian.}}
\li{#{|G| = 5}: #{G \cong C_5} by Lagrange.}
\li{\p{#{|G| = 6}: if #{1 \neq g \in G} then #{o(g) = 2, 3} or #{6} by Lagrange. If all non-identity elements have order #{2} then #{|G|} is a power of #{2} ↯ (Sheet 1, Q7). So there exists #{b \in G} with #{o(b) = 3} (note if #{o(g) = 6} then #{o(g^2) = 3}). #{C_3 \cong \langle b \rangle \trianglelefteq G} since it has index #{2}. Let #{a \in G \setminus \langle b \rangle}. Then #{a^2 \in \langle b \rangle} (consider #{a\langle b \rangle \in G/\langle b \rangle}).}
\p{If #{a^2 = b} or #{b^2} then #{o(a) = 6}, so #{G \cong C_6}.}
\p{Suppose #{a^2 = e}. Also #{aba^{-1} \in \langle b \rangle} (since #{\langle b \rangle \trianglelefteq G}):}
\ul{
\li{if #{aba^{-1} = e} then #{b = e} ↯;}
\li{if #{aba^{-1} = b} then #{ab = ba}, so #{o(ab) = 6}, so #{G \cong C_6};}
\li{if #{aba^{-1} = b^2 = b^{-1}}, then #{o(a) = 2}, #{o(b) = 3}, #{aba^{-1} = b^{-1}}, so #{G \cong D_6}.}
}
\p{So there are two groups of order #{6}: #{C_6} and #{D_6 \cong S_3}. Note #{C_6 \not\cong D_6} as #{C_6} is abelian and #{D_6} is not.}}
\li{#{|G| = 7}: #{G \cong C_7}.}
\li{\p{#{|G| = 8}: by Lagrange, if #{1 \neq g \in G} then #{o(g) = 2, 4} or #{8}.}
\p{If all non-identity elements have order #{2} then #{G} is abelian. Let #{1 \neq a \in G}, so #{C_2 \cong \langle a \rangle \trianglelefteq G}. Choose #{b \notin \langle a \rangle}; then #{\langle a, b \rangle = \lbrace 1, a, b, ab\rbrace  = \langle a \rangle\langle b \rangle \cong \langle a \rangle \times \langle b \rangle}. Choose #{c \in G \setminus \langle a, b \rangle}. Then}
##{G = \langle a, b \rangle \sqcup \langle a, b \rangle c = \langle a, b \rangle\langle c \rangle \cong \langle a, b \rangle \times \langle c \rangle \cong \langle a \rangle \times \langle b \rangle \times \langle c \rangle \cong C_2 \times C_2 \times C_2.}
\p{Now suppose there exists #{g \in G} with #{o(g) > 2}, so there exists #{a \in G} with #{o(a) = 4}. Then #{C_4 \cong \langle a \rangle \trianglelefteq G} (since it has index #{2}). Let #{b \in G \setminus \langle a \rangle}. Then #{b^2 \in \langle a \rangle} (consider #{b\langle a \rangle \in G/\langle a \rangle}). If #{b^2 = a} or #{a^3} then #{o(b) = 8}, so #{G \cong C_8}.}
\p{Now #{bab^{-1} \in \langle a \rangle} since #{\langle a \rangle \trianglelefteq G}, say #{bab^{-1} = a^i}. Then}
##{b^2ab^{-2} = ba^ib^{-1} = (bab^{-1})^i = a^{i^2}.}
\p{But #{b^2 \in \langle a \rangle \implies b^2ab^{-2} = a}, so #{i^2 \equiv 1 \bmod 4}, so #{i \equiv \pm 1 \bmod 4}.}
\p{If #{bab^{-1} = a} then #{ba = ab} and #{G} is abelian:}
\ul{
\li{if #{b^2 = e}, then #{G = \langle a \rangle \sqcup \langle a \rangle b = \langle a \rangle\langle b \rangle \cong \langle a \rangle \times \langle b \rangle \cong C_4 \times C_2};}
\li{if #{b^2 = a^2}, then #{(ba^{-1})^2 = e}, so #{G \cong \langle a \rangle \times \langle ba^{-1} \rangle \cong C_4 \times C_2}.}
}
\p{Suppose #{bab^{-1} = a^{-1}}:}
\ul{
\li{if #{b^2 = e} then #{G \cong D_8};}
\li{however if #{b^2 = a^2}, we have a new group #{Q_8}, the \em{quaternion group}.}
}
\p{\em{Realisations of #{Q_8}:} #{Q_8 = \lbrace \pm 1, \pm i, \pm j, \pm k\rbrace } with}
##{ij = k,\; jk = i,\; ki = j, \quad ji = -k,\; kj = -i,\; ik = -j, \quad i^2 = j^2 = k^2 = -1,}
\p{so #{o(i) = o(j) = o(k) = 4} and #{o(-1) = 2}. Another realisation of #{Q_8}:}
##{\left\lbrace  \pm\begin{pmatrix} 1 & 0 \\ 0 & 1 \end{pmatrix}, \pm\begin{pmatrix} i & 0 \\ 0 & -i \end{pmatrix}, \pm\begin{pmatrix} 0 & i \\ i & 0 \end{pmatrix}, \pm\begin{pmatrix} 0 & -1 \\ 1 & 0 \end{pmatrix} \right\rbrace  \leq SL_2(\mathbb{C}).}
\p{Alternatively, #{Q_8 = \langle a, b \mid a^4 = e,\; b^2 = a^2,\; bab^{-1} = a^{-1} \rangle}.}
\p{So there are #{5} isomorphism classes of groups of order #{8}:}
\ul{
\li{#{C_8}, #{C_4 \times C_2}, #{C_2 \times C_2 \times C_2} (abelian), all different, e.g. #{C_8} has an element of order #{8}, #{C_4 \times C_2} does not have an element of order #{8} but does of order #{4}, and in #{C_2 \times C_2 \times C_2} all elements have order #{2};}
\li{#{D_8} and #{Q_8} (non-abelian). #{Q_8} has #{6} elements of order #{4} but #{D_8} only has #{2}, so they are non-isomorphic.}
}}
\li{\p{#{|G| = 9}: we will show later that groups of order #{p^2} (#{p} prime) are abelian (Sheet 3, Q10). Either #{G \cong C_9}, or all non-identity elements have order #{3}. Choose #{e \neq a \in G}, #{b \in G \setminus \langle a \rangle}. Then}
##{G = \langle a \rangle \sqcup \langle a \rangle b \sqcup \langle a \rangle b^2 = \langle a \rangle\langle b \rangle \cong \langle a \rangle \times \langle b \rangle \cong C_3 \times C_3.}}
\li{#{|G| = 10}: #{G \cong C_{10}} or #{D_{10}} (Sheet 2, Q12).}
}

\transclude{GP23}
