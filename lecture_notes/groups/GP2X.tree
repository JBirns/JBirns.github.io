\title{Conjugacy classes of #{S_4}}
\taxon{Example}
\date{2021-10-01}
\author{JB00}
\import{macros}

\p{#{(1\,4)(1\,2\,3)(1\,4)^{-1} = (4\,2\,3)}, and #{(1\,i)(1\,k)(1\,i) = (i\,k)}.}

\p{Consider #{S_4}: let #{x \in S_4}, and recall #{24 = |S_4| = |\operatorname{ccl}_{S_4}(x)|\,|C_{S_4}(x)|}.}

##{\begin{array}{cccccc}
\text{example member} & \text{cycle type} & \# & \operatorname{sgn} & |C_{S_4}(x)| & C_{S_4}(x) \\ \hline
e & (1,1,1,1) & 1 & 1 & 24 & S_4 \\
(1\,2)(3)(4) & (2,1,1) & 6 & -1 & 4 & \langle (1\,2), (3\,4) \rangle \cong C_2 \times C_2 \\
(1\,2\,3)(4) & (3,1) & 8 & 1 & 3 & \langle (1\,2\,3) \rangle \cong C_3 \\
(1\,2)(3\,4) & (2,2) & 3 & 1 & 8 & \langle (1\,3\,2\,4), (1\,2) \rangle \cong D_8 \\
(1\,2\,3\,4) & (4) & 6 & -1 & 4 & \langle (1\,2\,3\,4) \rangle \cong C_4
\end{array}}
