\title{Cyclotomic extensions of #{\mathbb{F}_p}}
\taxon{Corollary}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Let #{K = \mathbb{F}_p} and suppose #{p \nmid n}. Then #{[K(\zeta_n):K] = } order of #{p} in #{(\mathbb{Z}/n\mathbb{Z})^\times}.}

\proof{
\p{#{\operatorname{Gal}(K(\zeta_n)/K)} is generated by the Frobenius #{\phi}, which sends #{\zeta_n \mapsto \zeta_n^p}. Therefore}

##{\begin{aligned}
[K(\zeta_n):K] &= \text{order of } \phi \text{ in } \operatorname{Gal}(K(\zeta_n)/K) \\
&= \text{order of } \chi(\phi) \text{ in } (\mathbb{Z}/n\mathbb{Z})^\times \\
&= \text{order of } p \text{ in } (\mathbb{Z}/n\mathbb{Z})^\times.
\end{aligned}}
}
