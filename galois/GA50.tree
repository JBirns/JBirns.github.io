\title{Symmetric rational functions}
\taxon{Theorem}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{#{L^G = k(s_1, \ldots, s_n)}.}


\scope{
    \put\transclude/toc{false}
    \subtree{
      \taxon{Proof 1}
      \p{Let #{\frac{f}{g} \in L^G}, with #{f, g \in R} coprime. Then}

##{\frac{\sigma(f)}{\sigma(g)} = \frac{f}{g} \quad \forall \sigma \in G.}

\p{Since #{R} is a UFD and the units of #{R} are just #{k^\times}, we have #{\sigma(f) = c_\sigma f} for some #{c_\sigma \in k^\times}, and #{\sigma(g) = c_\sigma g}.}

\p{But #{G} has finite order, say #{|G| = N} (#{= n!}). Therefore #{f = \sigma^N(f) = c_\sigma^N f \implies c_\sigma^N = 1}. Therefore #{fg^{N-1}} and #{g^N \in R^G = k[s_1, \ldots, s_n]}, so}

##{\frac{f}{g} = \frac{fg^{N-1}}{g^N} \in k(s_1, \ldots, s_n).}
      \qed
    }
  }


\scope{
    \put\transclude/toc{false}
    \subtree{
      \taxon{Proof 2}
      \p{Let}

##{f(T) = \prod_{i=1}^n (T - X_i) = T^n - s_1 T^{n-1} + s_2 T^{n-2} - \cdots + (-1)^n s_n.}

\p{Then #{f \in k(s_1, \ldots, s_n)[T]} is a polynomial of degree #{n}, and #{L} is a splitting field for #{f} over #{k(s_1, \ldots, s_n)}.}

##{\begin{array}{c} L \\ \big| \\ L^G \\ \big| \\ k(s_1, \ldots, s_n) \end{array}}

\p{[Example Sheet 1](https://www.dpmms.cam.ac.uk/study/II/Galois/2023-2024/) Q12 #{\implies [L:k(s_1, \ldots, s_n)] \leq n!}, and #{[L:L^G] = \#G = n!} by Artin’s Theorem. The Tower Law #{\implies L^G = k(s_1, \ldots, s_n)}.}
  }
}