\title{Reformulation of the symmetric function theorem}
\taxon{Remark}
\date{2026-11-24}
\author{JB00}
\import{macros}

\p{Consider the ring homomorphism}

##{\begin{aligned}
\theta \colon R[Y_1, \ldots, Y_n] &\to R[X_1, \ldots, X_n] \\
Y_i &\mapsto s_i.
\end{aligned}}

\p{(i) says #{\operatorname{Im}\theta = \lbrace \text{symmetric polynomials in } R[X_1, \ldots, X_n]\rbrace }.
(ii) says #{\theta} is injective.}
